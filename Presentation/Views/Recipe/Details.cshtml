@model Presentation.Models.RecipeDetailViewModel
@{
    ViewData["Title"] = Model.Name;
}

<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />

<style>
 :root {
     --sage:      #7aab84;
     --sage-d:    #4e7d58;
     --sage-pale: #f0f7f2;
     --bark:      #2d2417;
     --muted:     #7a7168;
     --border:    #e4ede6;
     --heart:     #e05c5c;
 }

* { box-sizing: border-box; }

.rd-page {
    margin: 0 auto;
    padding: 2.5rem 1.5rem 6rem;
    font-family: 'DM Sans', sans-serif;
}

.rd-header {
    flex-direction: row;
    display: flex;
    gap: 1.5rem;
    justify-content: space-between;
}

/* ── Hero ── */
.rd-hero {
    position: relative;
    overflow: hidden;
    margin-bottom: 2rem;
    background: linear-gradient(135deg, #d6eadb, #b5d9bc);
    width: -webkit-fill-available;
    max-height: 41rem;
}

.rd-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.rd-hero-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 5rem;
}

.rd-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(20,12,5,.72) 0%, transparent 55%);
}

.rd-hero-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2rem 2.5rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
}

.rd-hero-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2rem 2.5rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
}

.rd-title {
    font-family: 'Lora', serif;
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    color: #fff;
    margin: 0 0 .4rem;
    line-height: 1.2;
    text-shadow: 0 2px 12px rgba(0,0,0,.3);
}

.rd-desc {
    color: rgba(255,255,255,.75);
    font-size: .95rem;
    margin: 0;
    max-width: 520px;
    line-height: 1.5;
}

/* избранное на hero */
.fav-hero-btn {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    background: rgba(255,255,255,.18);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 1.3rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background .2s, transform .2s;
}
.fav-hero-btn:hover { background: rgba(255,255,255,.32); transform: scale(1.1); }
.fav-hero-btn.is-fav { color: var(--heart); }

/* pop анимация */
@@keyframes favPop {
     0%  { transform: scale(1); }
     40% { transform: scale(1.45); }
     70% { transform: scale(.88); }
     100%{ transform: scale(1); }
 }
.fav-pop { animation: favPop .35s cubic-bezier(.36,.07,.19,.97); }

/* ── Пилюли-статы под hero ── */
.rd-stats {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-bottom: 2.5rem;
}

.rd-stat {
    display: flex;
    align-items: center;
    gap: .5rem;
    background: var(--sage-pale);
    border: 1px solid var(--border);
    padding: .45rem 1rem;
    font-size: .85rem;
    font-weight: 500;
    color: var(--bark);
}

.rd-stat .stat-ico { font-size: 1rem; }

/* ── Основной грид ── */
.rd-body {
    display: grid;
    gap: 2rem;
    align-items: start;
}

/* ── Сайдбар ── */
.rd-sidebar {
    width: 400px;
}

.rd-card {
    background: #fff;
    border: 1px solid var(--border);
    padding: 1.5rem;
    margin-bottom: 1.25rem;
}

.rd-card-title {
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 1rem;
}

/* макронутриенты */
.macro-list { display: flex; flex-direction: column; gap: .55rem; }

.macro-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: .875rem;
}

.macro-label { color: var(--muted); }

.macro-val { font-weight: 600; color: var(--bark); }

.macro-bar-wrap {
    height: 5px;
    background: #edf0eb;
    border-radius: 999px;
    overflow: hidden;
    margin-top: .25rem;
}

.macro-bar { height: 100%; border-radius: 999px; }
.bar-kcal  { background: var(--sage); }
.bar-p     { background: #5b9bd5; }
.bar-f     { background: #e07a5f; }
.bar-c     { background: #f4a32a; }
.bar-m     { background: #adf42a; }

/* стоимость */
.cost-big {
    font-family: 'Lora', serif;
    font-size: 2rem;
    font-weight: 600;
    color: var(--sage-d);
    text-align: center;
    line-height: 1;
}

.cost-sub {
    text-align: center;
    font-size: .8rem;
    color: var(--muted);
    margin-top: .3rem;
}

/* ── Контент ── */
.rd-content {}

/* Секция */
.rd-section { margin-bottom: 2.5rem; }

.rd-section-title {
    font-family: 'Lora', serif;
    font-size: 1.3rem;
    color: var(--bark);
    margin: 0 0 1.1rem;
    display: flex;
    align-items: center;
    gap: .6rem;
}

.rd-section-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
}

/* Ингредиенты */
.ing-list {
    display: flex;
    flex-direction: column;
    gap: .5rem;
    list-style: none;
    margin: 0;
    padding: 0;
}

.ing-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: .7rem .9rem;
    border-radius: 10px;
    background: var(--sage-pale);
    font-size: .9rem;
    transition: background .2s;
}

.ing-item:hover { background: #e4f0e7; }

.ing-name { font-weight: 500; color: var(--bark); }

.ing-comment { font-size: .78rem; color: var(--muted); margin-left: .3rem; }

.ing-amount {
    font-size: .82rem;
    color: var(--muted);
    white-space: nowrap;
    margin-left: 1rem;
    text-align: right;
}

/* Шаги */
.steps-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
}

.step-item {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
}

.step-num {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--sage);
    color: #fff;
    font-family: 'Lora', serif;
    font-weight: 600;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(122,171,132,.35);
    margin-top: .1rem;
}

.step-body { flex: 1; }

.step-text {
    font-size: .95rem;
    line-height: 1.7;
    color: var(--bark);
    margin: 0 0 .5rem;
}

.step-img {
    width: 100%;
    max-height: 300px;
    object-fit: cover;
    border-radius: 12px;
    margin-top: .6rem;
}

.step-timer {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    font-size: .78rem;
    color: var(--sage-d);
    background: var(--sage-pale);
    border-radius: 999px;
    padding: .2rem .75rem;
}

/* ── Кнопки внизу ── */
.rd-footer-actions {
    display: flex;
    gap: .75rem;
    flex-wrap: wrap;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
}

.btn-soft {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    padding: .65rem 1.3rem;
    border-radius: 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: .875rem;
    font-weight: 500;
    text-decoration: none;
    border: 1.5px solid var(--border);
    color: var(--muted);
    background: #fff;
    cursor: pointer;
    transition: all .2s;
}
.btn-soft:hover { border-color: var(--sage); color: var(--sage-d); background: var(--sage-pale); }
.btn-soft.primary { background: var(--sage); color: #fff; border-color: var(--sage); }
.btn-soft.primary:hover { background: var(--sage-d); }
.btn-soft.danger:hover { border-color: var(--heart); color: var(--heart); background: #fdf0f0; }

/* ── Mobile ── */
@@media (max-width: 700px) {
    .rd-hero { height: 280px; }
    .rd-hero-content { padding: 1.2rem 1.5rem; }
    .rd-body { grid-template-columns: 1fr; }
    .rd-sidebar { order: 2; }
    .rd-content { order: 1; }
}

.servings-control {
    display: flex;
    align-items: center;
    gap: .75rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
}
.servings-label { font-weight: 600; color: var(--bark); font-size: .9rem; }
.srv-btn {
    width: 34px; height: 34px;
    border-radius: 50%;
    border: 1.5px solid var(--border);
    background: #fff;
    color: var(--sage-d);
    font-size: 1.2rem;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: all .15s;
}
.srv-btn:hover { background: var(--sage-pale); border-color: var(--sage); }
#srvInput {
    width: 56px;
    text-align: center;
    border: 1.5px solid var(--border);
    border-radius: 8px;
    padding: .3rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--bark);
}
#srvSlider {
    flex: 1; min-width: 120px; max-width: 220px;
    accent-color: var(--sage);
}
.steps-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr 1fr 1fr;
}

@@media (max-width: 700px) {
    .steps-grid { grid-template-columns: 1fr; }
}


.ing-group-title {
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--sage-d);
    margin: 1rem 0 .4rem;
    padding-left: .9rem;
    border-left: 3px solid var(--sage);
}

/* ── Ingredient row ── */
.ing-row {
    display: flex;
    align-items: center;
    gap: .5rem;
    margin-bottom: .5rem;
}
.ing-select {
    flex: 2;
    min-width: 0;
    padding: .35rem .6rem;
    font-size: .875rem;
    border: 1px solid #ced4da;
    border-radius: 8px;
    background: #fff;
}
.ing-amount-input {
    width: 72px;
    flex-shrink: 0;
    padding: .35rem .5rem;
    font-size: .875rem;
    border: 1px solid #ced4da;
    border-radius: 8px;
    text-align: right;
}
.ing-comment-input {
    flex: 1;
    min-width: 0;
    padding: .35rem .6rem;
    font-size: .875rem;
    border: 1px solid #ced4da;
    border-radius: 8px;
    color: #6c757d;
}
.ing-remove {
    flex-shrink: 0;
    width: 28px; height: 28px;
    border-radius: 50%;
    border: none;
    background: #fee2e2;
    color: #dc2626;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background .15s;
}
.ing-remove:hover { background: #fecaca; }

/* ── Step row ── */
.step-row-edit {
    display: flex;
    align-items: flex-start;
    gap: .5rem;
    margin-bottom: .5rem;
    background: var(--primary-light, #f0f7f2);
    border-radius: 10px;
    padding: .6rem .75rem;
}
.step-row-num {
    flex-shrink: 0;
    width: 26px; height: 26px;
    border-radius: 50%;
    background: var(--primary, #7aab84);
    color: #fff;
    font-weight: 700;
    font-size: .85rem;
    display: flex; align-items: center; justify-content: center;
    margin-top: .2rem;
}
.step-row-text {
    flex: 1;
    min-width: 0;
    padding: .35rem .6rem;
    font-size: .875rem;
    border: 1px solid #ced4da;
    border-radius: 8px;
    resize: vertical;
}
.step-row-timer {
    width: 72px;
    flex-shrink: 0;
    padding: .35rem .5rem;
    font-size: .875rem;
    border: 1px solid #ced4da;
    border-radius: 8px;
    text-align: right;
}

.calc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .6rem;
}
.calc-item {
    background: var(--sage-pale);
    border-radius: 8px;
    padding: .5rem .75rem;
    display: flex;
    flex-direction: column;
    gap: .1rem;
}
.calc-item--wide {
    grid-column: 1 / -1;
}
.calc-label {
    font-size: .7rem;
    color: var(--muted);
    font-weight: 500;
}
.calc-val {
    font-family: 'Lora', serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--bark);
    line-height: 1;
}
.calc-unit {
    font-size: .7rem;
    color: var(--muted);
}
</style>

<div class="rd-page">

<!-- ── Header ── -->
<div class="rd-header">
<!-- ── Hero ── -->
<div class="rd-hero">
@if (!string.IsNullOrEmpty(Model.ImageUrl))
{
<img src="@Model.ImageUrl" alt="@Model.Name" />
}
else
{
<div class="rd-hero-placeholder">🥘</div>
}
<div class="rd-hero-overlay"></div>

<div class="rd-hero-content">
<div>
<h1 class="rd-title">
                    @(Model.Name[..1].ToUpper() + Model.Name[1..])
</h1>
@if (!string.IsNullOrEmpty(Model.Description))
{
<p class="rd-desc">@Model.Description</p>
}
</div>

@if (User.Identity?.IsAuthenticated == true)
{
<button class="fav-hero-btn fav-btn @(Model.IsFavorite ? "is-fav" : "")"
data-id="@Model.Id"
data-loading="false"
title="@(Model.IsFavorite ? "Убрать из избранного" : "В избранное")">
<i class="@(Model.IsFavorite ? "fas" : "far") fa-heart"></i>
</button>
}
</div>
</div>

<!-- Сайдбар -->
<aside class="rd-sidebar">

    <!-- Статичный БЖУ на 1 порцию -->
    @if (Model.CaloriesPerServing > 0 || Model.ProteinPerServing > 0)
    {
        <div class="rd-card">
            <p class="rd-card-title">На 1 порцию</p>

            @{
                var totalMacro = (double)(Model.ProteinPerServing + Model.FatPerServing + Model.CarbsPerServing);
                var pctP = totalMacro > 0 ? Model.ProteinPerServing / (decimal)totalMacro * 100 : 0;
                var pctF = totalMacro > 0 ? Model.FatPerServing    / (decimal)totalMacro * 100 : 0;
                var pctC = totalMacro > 0 ? Model.CarbsPerServing  / (decimal)totalMacro * 100 : 0;
            }

            <!-- Полосатый бар соотношения -->
            <div style="height:8px;border-radius:999px;overflow:hidden;display:flex;margin-bottom:1rem">
                <div style="width:@pctP.ToString("F0")%;background:#5b9bd5"></div>
                <div style="width:@pctF.ToString("F0")%;background:#e07a5f"></div>
                <div style="width:@pctC.ToString("F0")%;background:#f4a32a"></div>
            </div>

            <div style="display:flex;justify-content:space-between;font-size:.82rem;margin-bottom:1rem">
                <span style="color:#5b9bd5;font-weight:600">Б @Math.Round(pctP, 0)%</span>
                <span style="color:#e07a5f;font-weight:600">Ж @Math.Round(pctF, 0)%</span>
                <span style="color:#f4a32a;font-weight:600">У @Math.Round(pctC, 0)%</span>
            </div>

            <div style="display:flex;justify-content:space-between;font-size:.875rem;color:var(--muted)">
                @if (Model.CaloriesPerServing > 0)
                {
                    <span>К <b style="color:var(--bark)">@Math.Round(Model.CaloriesPerServing, 0)</b> ккал</span>
                }
                @if (Model.ProteinPerServing > 0)
                {
                    <span>Б <b style="color:var(--bark)">@Math.Round(Model.ProteinPerServing, 1)</b> г</span>
                }
                @if (Model.FatPerServing > 0)
                {
                    <span>Ж <b style="color:var(--bark)">@Math.Round(Model.FatPerServing, 1)</b> г</span>
                }
                @if (Model.CarbsPerServing > 0)
                {
                    <span>У <b style="color:var(--bark)">@Math.Round(Model.CarbsPerServing, 1)</b> г</span>
                }
            </div>
        </div>
    }

<!-- Порции + калькулятор -->
<div class="rd-card">
<p class="rd-card-title">Калькулятор порций</p>
<div style="display:flex;align-items:center;justify-content:center;gap:1rem;margin-bottom:1rem">
<button type="button" class="srv-btn" id="srvMinus">−</button>
<span id="srvDisplay" style="font-family:'Lora',serif;font-size:1.8rem;font-weight:600;color:var(--bark);min-width:2rem;text-align:center">@Model.DefaultServings</span>
<button type="button" class="srv-btn" id="srvPlus">+</button>
</div>
<div class="calc-grid">
<div class="calc-item">
<span class="calc-label">Калории</span>
<span class="calc-val" id="calcKcal">@Math.Round(Model.CaloriesPerServing * Model.DefaultServings, 0)</span>
<span class="calc-unit">ккал</span>
</div>
<div class="calc-item">
<span class="calc-label" style="color:#5b9bd5">Белки</span>
<span class="calc-val" id="calcP">@Math.Round(Model.ProteinPerServing * Model.DefaultServings, 1)</span>
<span class="calc-unit">г</span>
</div>
<div class="calc-item">
<span class="calc-label" style="color:#e07a5f">Жиры</span>
<span class="calc-val" id="calcF">@Math.Round(Model.FatPerServing * Model.DefaultServings, 1)</span>
<span class="calc-unit">г</span>
</div>
<div class="calc-item">
<span class="calc-label" style="color:#f4a32a">Углеводы</span>
<span class="calc-val" id="calcC">@Math.Round(Model.CarbsPerServing * Model.DefaultServings, 1)</span>
<span class="calc-unit">г</span>
</div>
</div>
</div>

    @if (Model.TotalCost > 0)
    {
    <div class="rd-card">
        <p class="rd-card-title">Стоимость</p>
        <div class="cost-big" style="color:var(--sage-d)">
            <span id="calcCost">@Math.Round(Model.TotalCost, 2)</span> ₽
        </div>
        <div class="cost-sub">
            <span id="sbCostPerServing">@Math.Round(Model.CostPerServing, 2)</span> ₽ за порцию
        </div>
    </div>
    }
    
</aside>
</div>

<!-- ── Пилюли-статы ── -->
<div class="rd-stats">
<div class="rd-stat">
<span class="stat-ico">🍽</span>
@Model.DefaultServings порц.
</div>
@if (Model.CaloriesPerServing > 0)
{
<div class="rd-stat">
<span class="stat-ico">🔥</span>
<span class="stat-val">@Math.Round(Model.CaloriesPerServing, 0)</span> ккал / порц.
</div>
}
@if (Model.ProteinPerServing > 0)
{
<div class="rd-stat">
<span class="stat-ico" style="color:#5b9bd5">Б</span>
@Math.Round(Model.ProteinPerServing, 1) г
</div>
}
@if (Model.FatPerServing > 0)
{
<div class="rd-stat">
<span class="stat-ico" style="color:#e07a5f">Ж</span>
@Math.Round(Model.FatPerServing, 1) г
</div>
}
@if (Model.CarbsPerServing > 0)
{
<div class="rd-stat">
<span class="stat-ico" style="color:#f4a32a">У</span>
@Math.Round(Model.CarbsPerServing, 1) г
</div>
}
@if (Model.Ingredients?.Count > 0)
{
<div class="rd-stat" id="statCount">
<span class="stat-ico">🛒</span>
@Model.Ingredients.Count ингр.
</div>
}
</div>

<!-- ── Тело ── -->
<div class="rd-body">
<div class="rd-content">
<!-- Ингредиенты -->
@if (Model.Ingredients?.Any() == true)
{
<div class="rd-section">
<h2 class="rd-section-title">Ингредиенты</h2>

@{
    var grouped = Model.Ingredients
    .GroupBy(i => {
    var m = System.Text.RegularExpressions.Regex.Match(
    i.Comment ?? "", @"^\[(.+?)\]");
    return m.Success ? m.Groups[1].Value : (string?)null;
})
.OrderBy(g => g.Key == null ? 0 : 1);
}

    @foreach (var group in grouped)
    {
        @if (group.Key != null)
        {
        <p class="ing-group-title">@group.Key</p>
        }

    <ul class="ing-list" style="margin-bottom: .75rem">
    @foreach (var ing in group)
    {
        var displayComment = System.Text.RegularExpressions.Regex
        .Replace(ing.Comment ?? "", @"^\[.+?\]\s*", "").Trim();

    <li class="ing-item"
    data-base-amount="@ing.Amount"
    data-base-price="@ing.PricePerUnit.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
    <span>
    <span class="ing-name">@ing.ProductName</span>
    @if (!string.IsNullOrEmpty(displayComment))
    {
    <span class="ing-comment">(@displayComment)</span>
    }
    </span>
    <span class="ing-amount">
    <span class="ing-amount-val">@Math.Round(ing.Amount, 1)</span> @ing.Unit
    @if (ing.Calories > 0)
    {
    <span class="ing-cal"> · <span class="ing-cal-val">@ing.Calories?.ToString("F0")</span> ккал</span>
    }
    <span class="ing-price text-muted" style="font-size:.75rem; display:block">
    ≈ <span class="ing-price-val">@Math.Round(ing.PriceForAmount, 1)</span> ₽
    </span>
    </span>
    </li>
    }
    </ul>
    }
</div>
}

<!-- Шаги приготовления -->
@if (Model.Steps?.Any() == true)
{
<div class="rd-section">
<h2 class="rd-section-title">Приготовление</h2>
<div class="steps-grid">
@foreach (var step in Model.Steps.OrderBy(s => s.Order))
{
<div class="step-item">
<div class="step-num">@step.Order</div>
<div class="step-body">
<p class="step-text">@step.Description</p>
@if (!string.IsNullOrEmpty(step.ImageUrl))
{
<img src="@step.ImageUrl" alt="Шаг @step.Order" class="step-img" />
}
    @if (step.TimerSeconds.HasValue && step.TimerSeconds > 0)
    {
    <span class="step-timer">
    <i class="fas fa-clock"></i>
    @(step.TimerSeconds / 60) мин
    </span>
    }
</div>
</div>
}
</div>
</div>
}

<!-- Действия -->
<div class="rd-footer-actions">
<a asp-action="Index" class="btn-soft">
<i class="fas fa-arrow-left"></i> Все рецепты
</a>

@if (Model.IsOwner)
{
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn-soft primary">
<i class="fas fa-pen"></i> Редактировать
</a>
<button onclick="openDeleteModal('@Model.Id', '@Html.Raw(Model.Name.Replace("'", "\\'"))')"
class="btn-soft danger">
<i class="fas fa-trash"></i> Удалить
</button>
}

<button onclick="shareRecipe()" class="btn-soft">
<i class="fas fa-share-alt"></i> Поделиться
</button>
</div>

</div>
</div>
</div>

<!-- Модалка удаления -->
<div class="del-modal-backdrop" id="delBackdrop" onclick="closeDeleteModal(event)">
<div class="del-modal" onclick="event.stopPropagation()" style="
background:#fff; border-radius:18px; padding:2rem;
max-width:380px; width:90%;
box-shadow:0 24px 64px rgba(0,0,0,.18);
animation: modalIn .25s ease;">
<h4 style="font-family:'Lora',serif;font-size:1.25rem;margin:0 0 .6rem;color:#2d2417">Удалить рецепт?</h4>
<p style="color:#7a7168;font-size:.9rem;margin:0 0 1.5rem">
                                                          «<span id="delRecipeName"></span>» будет удалён навсегда.
</p>
<div style="display:flex;gap:.75rem">
<button onclick="closeDeleteModal()" class="btn-soft" style="flex:1">Отмена</button>
<form id="delForm" method="post" style="flex:1">
@Html.AntiForgeryToken()
<input type="hidden" name="id" id="delRecipeId" />
<button type="submit" class="btn-soft danger"
style="width:100%;justify-content:center;background:#fdf0f0;border-color:var(--heart);color:var(--heart)">
<i class="fas fa-trash"></i> Удалить
</button>
</form>
</div>
</div>
</div>

<style>
.del-modal-backdrop {
    display:none; position:fixed; inset:0;
    background:rgba(0,0,0,.45); z-index:1000;
    align-items:center; justify-content:center;
}
.del-modal-backdrop.open { display:flex; }
@@keyframes modalIn {
     from { opacity:0; transform:translateY(14px) scale(.97); }
     to   { opacity:1; transform:translateY(0) scale(1); }
 }
</style>

<script>
 const BASE_SERVINGS   = @Model.DefaultServings;
const BASE_TOTAL_COST = @Model.TotalCost.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
const BASE_KCAL = @Model.CaloriesPerServing.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
const BASE_P    = @Model.ProteinPerServing.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
const BASE_F    = @Model.FatPerServing.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
const BASE_C    = @Model.CarbsPerServing.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
let currentServings = BASE_SERVINGS;

function setText(id, val) {
    const el = document.getElementById(id);
    if (el) el.textContent = val;
}

function updateServings(val) {
    val = Math.max(1, Math.min(100, val));
    currentServings = val;
    const ratio = val / BASE_SERVINGS;

setText('srvDisplay', val);

// Калькулятор (суммарно на все порции)
setText('calcKcal', Math.round(BASE_KCAL * val));
setText('calcP',    (BASE_P * val).toFixed(1));
setText('calcF',    (BASE_F * val).toFixed(1));
setText('calcC',    (BASE_C * val).toFixed(1));
setText('calcCost', Math.round(BASE_TOTAL_COST * ratio));

// Ингредиенты
document.querySelectorAll('.ing-item[data-base-amount]').forEach(item => {
    const newAmt  = parseFloat(item.dataset.baseAmount) * ratio;
    const baseP   = parseFloat(item.dataset.basePrice);
    const amtEl   = item.querySelector('.ing-amount-val');
    const priceEl = item.querySelector('.ing-price-val');
    const calEl   = item.querySelector('.ing-cal-val');
    if (amtEl)   amtEl.textContent   = newAmt < 10 ? newAmt.toFixed(1) : Math.round(newAmt);
    if (priceEl) priceEl.textContent = (baseP * newAmt / 100).toFixed(1);
    if (calEl) {
    if (!calEl.dataset.base) calEl.dataset.base = calEl.textContent;
calEl.textContent = Math.round(parseFloat(calEl.dataset.base) * ratio);
}
});
}

document.getElementById('srvMinus').addEventListener('click', () => updateServings(currentServings - 1));
document.getElementById('srvPlus') .addEventListener('click', () => updateServings(currentServings + 1));

 function openDeleteModal(id, name) {
     document.getElementById("delRecipeId").value = id;
     document.getElementById("delRecipeName").textContent = name;
     document.getElementById("delForm").action = "/Recipe/Delete";
     document.getElementById("delBackdrop").classList.add("open");
 }
 function closeDeleteModal(e) {
     if (!e || e.target === document.getElementById("delBackdrop"))
         document.getElementById("delBackdrop").classList.remove("open");
 }
 document.addEventListener("keydown", e => {
     if (e.key === "Escape") document.getElementById("delBackdrop").classList.remove("open");
 });
</script>
}
