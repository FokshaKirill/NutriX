@model Presentation.Models.RecipeDetailViewModel
@{
    ViewData["Title"] = Model.Name;
}

<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />

<div class="rd-page">

<!-- ── Header ── -->
<div class="rd-header">
<!-- ── Hero ── -->
<div class="rd-hero">
@if (!string.IsNullOrEmpty(Model.ImageUrl))
{
<img src="@Model.ImageUrl" alt="@Model.Name" />
}
else
{
<div class="rd-hero-placeholder">🥘</div>
}
<div class="rd-hero-overlay"></div>

<div class="rd-hero-content">
<div>
<h1 class="rd-title">
                    @(Model.Name[..1].ToUpper() + Model.Name[1..])
</h1>
@if (!string.IsNullOrEmpty(Model.Description))
{
<p class="rd-desc">@Model.Description</p>
}
</div>

@if (User.Identity?.IsAuthenticated == true)
{
<button class="fav-hero-btn fav-btn @(Model.IsFavorite ? "is-fav" : "")"
data-id="@Model.Id"
data-loading="false"
title="@(Model.IsFavorite ? "Убрать из избранного" : "В избранное")">
<i class="@(Model.IsFavorite ? "fas" : "far") fa-heart"></i>
</button>
}
</div>
</div>

<!-- Сайдбар -->
<aside class="rd-sidebar">

    <!-- Статичный БЖУ на 1 порцию -->
    @if (Model.CaloriesPerServing > 0 || Model.ProteinPerServing > 0)
    {
        <div class="rd-card">
            <p class="rd-card-title">На 1 порцию</p>

            @{
                var totalMacro = (double)(Model.ProteinPerServing + Model.FatPerServing + Model.CarbsPerServing);
                var pctP = totalMacro > 0 ? Model.ProteinPerServing / (decimal)totalMacro * 100 : 0;
                var pctF = totalMacro > 0 ? Model.FatPerServing    / (decimal)totalMacro * 100 : 0;
                var pctC = totalMacro > 0 ? Model.CarbsPerServing  / (decimal)totalMacro * 100 : 0;
            }

            <!-- Полосатый бар соотношения -->
            <div style="height:8px;border-radius:999px;overflow:hidden;display:flex;margin-bottom:1rem">
                <div style="width:@pctP.ToString("F0")%;background:#5b9bd5"></div>
                <div style="width:@pctF.ToString("F0")%;background:#e07a5f"></div>
                <div style="width:@pctC.ToString("F0")%;background:#f4a32a"></div>
            </div>

            <div style="display:flex;justify-content:space-between;font-size:.82rem;margin-bottom:1rem">
                <span style="color:#5b9bd5;font-weight:600">Б @Math.Round(pctP, 0)%</span>
                <span style="color:#e07a5f;font-weight:600">Ж @Math.Round(pctF, 0)%</span>
                <span style="color:#f4a32a;font-weight:600">У @Math.Round(pctC, 0)%</span>
            </div>

            <div style="display:flex;justify-content:space-between;font-size:.875rem;color:var(--muted)">
                @if (Model.CaloriesPerServing > 0)
                {
                    <span>К <b style="color:var(--bark)">@Math.Round(Model.CaloriesPerServing, 0)</b> ккал</span>
                }
                @if (Model.ProteinPerServing > 0)
                {
                    <span>Б <b style="color:var(--bark)">@Math.Round(Model.ProteinPerServing, 1)</b> г</span>
                }
                @if (Model.FatPerServing > 0)
                {
                    <span>Ж <b style="color:var(--bark)">@Math.Round(Model.FatPerServing, 1)</b> г</span>
                }
                @if (Model.CarbsPerServing > 0)
                {
                    <span>У <b style="color:var(--bark)">@Math.Round(Model.CarbsPerServing, 1)</b> г</span>
                }
            </div>
        </div>
    }

<!-- Порции + калькулятор -->
<div class="rd-card">
<p class="rd-card-title">Калькулятор порций</p>
<div style="display:flex;align-items:center;justify-content:center;gap:1rem;margin-bottom:1rem">
<button type="button" class="srv-btn" id="srvMinus">−</button>
<span id="srvDisplay" style="font-family:'Lora',serif;font-size:1.8rem;font-weight:600;color:var(--bark);min-width:2rem;text-align:center">@Model.DefaultServings</span>
<button type="button" class="srv-btn" id="srvPlus">+</button>
</div>
<div class="calc-grid">
<div class="calc-item">
<span class="calc-label">Калории</span>
<span class="calc-val" id="calcKcal">@Math.Round(Model.CaloriesPerServing * Model.DefaultServings, 0)</span>
<span class="calc-unit">ккал</span>
</div>
<div class="calc-item">
<span class="calc-label" style="color:#5b9bd5">Белки</span>
<span class="calc-val" id="calcP">@Math.Round(Model.ProteinPerServing * Model.DefaultServings, 1)</span>
<span class="calc-unit">г</span>
</div>
<div class="calc-item">
<span class="calc-label" style="color:#e07a5f">Жиры</span>
<span class="calc-val" id="calcF">@Math.Round(Model.FatPerServing * Model.DefaultServings, 1)</span>
<span class="calc-unit">г</span>
</div>
<div class="calc-item">
<span class="calc-label" style="color:#f4a32a">Углеводы</span>
<span class="calc-val" id="calcC">@Math.Round(Model.CarbsPerServing * Model.DefaultServings, 1)</span>
<span class="calc-unit">г</span>
</div>
</div>
</div>

    @if (Model.TotalCost > 0)
    {
        <div class="rd-card">
            <p class="rd-card-title">Стоимость</p>
            <div class="cost-big" style="color:var(--sage-d)">
                <span id="calcCost">@Math.Round(Model.TotalCost, 2)</span> ₽
            </div>
            <div class="cost-sub">
                <span id="sbCostPerServing">@Math.Round(Model.CostPerServing, 2)</span> ₽ за порцию
            </div>
        </div>
    }
    </aside>
    </div>

<!-- ── Пилюли-статы ── -->
<div class="rd-stats">


    @if (Model.IsOwner)
    {
    <div class="rd-card" id="tagsCard" style="width: -webkit-fill-available">
        <p class="rd-card-title">🏷 Теги рецепта</p>

        @{
        // Группы тегов для отображения
        var mealTimeTags = new[] {
        (Domain.Enums.RecipeTag.Breakfast, "Завтрак",  "🌅"),
        (Domain.Enums.RecipeTag.Lunch,     "Обед",     "🍽"),
        (Domain.Enums.RecipeTag.Dinner,    "Ужин",     "🌙"),
        (Domain.Enums.RecipeTag.Snack,     "Перекус",  "🍎"),
        };
        var roleTags = new[] {
        (Domain.Enums.RecipeTag.Soup,       "Суп",          "🥣"),
        (Domain.Enums.RecipeTag.MainCourse, "Основное",     "🥩"),
        (Domain.Enums.RecipeTag.Salad,      "Салат",        "🥗"),
        (Domain.Enums.RecipeTag.Garnish,    "Гарнир",       "🍚"),
        (Domain.Enums.RecipeTag.Drink,      "Напиток",      "🥤"),
        (Domain.Enums.RecipeTag.Dessert,    "Десерт",       "🍰"),
        (Domain.Enums.RecipeTag.Quick,      "Быстрое",      "⚡"),
        (Domain.Enums.RecipeTag.Festive,    "Праздничное",  "🎉"),
        };
        }

        <div style="font-size:.7rem;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:.4rem">
            Приём пищи
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:.35rem;margin-bottom:.85rem" id="mealTimePills">
            @foreach (var (tag, label, icon) in mealTimeTags)
            {
            var active = Model.Tags.HasFlag(tag);
            <button type="button"
                    class="tag-pill @(active ? "active" : "")"
                    data-tag="@((int)tag)"
                    title="@label">
                @icon @label
            </button>
            }
        </div>

        <div style="font-size:.7rem;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:.4rem">
            Роль блюда
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:.35rem;margin-bottom:1rem" id="rolePills">
            @foreach (var (tag, label, icon) in roleTags)
            {
            var active = Model.Tags.HasFlag(tag);
            <button type="button"
                    class="tag-pill @(active ? "active" : "")"
                    data-tag="@((int)tag)"
                    title="@label">
                @icon @label
            </button>
            }
        </div>

        <div style="display:flex;gap:.5rem;align-items:center">
            <button type="button" class="btn-soft primary" id="saveTagsBtn"
                    style="padding:.45rem 1rem;font-size:.8rem"
                    onclick="saveTags('@Model.Id')">
                Сохранить теги
            </button>
            <button type="button" class="btn-soft" id="autoTagBtn"
                    style="padding:.45rem 1rem;font-size:.8rem"
                    onclick="autoTag('@Model.Id', '@Html.Raw(Model.Name.Replace("'","\\'"  ))')">
                ✨ Автоподбор
            </button>
            <span id="tagsSaveStatus" style="font-size:.78rem;color:var(--sage-d);display:none">✓ Сохранено</span>
        </div>
    </div>
    }

    <div class="rd-stat">
<span class="stat-ico">🍽</span>
@Model.DefaultServings порц.
</div>
@if (Model.CaloriesPerServing > 0)
{
<div class="rd-stat">
<span class="stat-ico">🔥</span>
<span class="stat-val">@Math.Round(Model.CaloriesPerServing, 0)</span> ккал / порц.
</div>
}
@if (Model.ProteinPerServing > 0)
{
<div class="rd-stat">
<span class="stat-ico" style="color:#5b9bd5">Б</span>
@Math.Round(Model.ProteinPerServing, 1) г
</div>
}
@if (Model.FatPerServing > 0)
{
<div class="rd-stat">
<span class="stat-ico" style="color:#e07a5f">Ж</span>
@Math.Round(Model.FatPerServing, 1) г
</div>
}
@if (Model.CarbsPerServing > 0)
{
<div class="rd-stat">
<span class="stat-ico" style="color:#f4a32a">У</span>
@Math.Round(Model.CarbsPerServing, 1) г
</div>
}
@if (Model.Ingredients?.Count > 0)
{
<div class="rd-stat" id="statCount">
<span class="stat-ico">🛒</span>
@Model.Ingredients.Count ингр.
</div>
}
</div>

<!-- ── Тело ── -->
<div class="rd-body">
<div class="rd-content">
<!-- Ингредиенты -->
@if (Model.Ingredients?.Any() == true)
{
<div class="rd-section">
<h2 class="rd-section-title">Ингредиенты</h2>

@{
    var grouped = Model.Ingredients
    .GroupBy(i => {
    var m = System.Text.RegularExpressions.Regex.Match(
    i.Comment ?? "", @"^\[(.+?)\]");
    return m.Success ? m.Groups[1].Value : (string?)null;
})
.OrderBy(g => g.Key == null ? 0 : 1);
}

    @foreach (var group in grouped)
    {
        @if (group.Key != null)
        {
        <p class="ing-group-title">@group.Key</p>
        }

    <ul class="ing-list" style="margin-bottom: .75rem">
    @foreach (var ing in group)
    {
        var displayComment = System.Text.RegularExpressions.Regex
        .Replace(ing.Comment ?? "", @"^\[.+?\]\s*", "").Trim();

    <li class="ing-item"
    data-base-amount="@ing.Amount"
    data-base-price="@ing.PricePerUnit.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
    <span>
        <span class="ing-name">
            <a asp-controller="Product" asp-action="Details"
               asp-route-id="@ing.ProductId"
               style="color:inherit; border-bottom:1px dashed var(--border); transition:color .15s;"
               onmouseover="this.style.color='var(--sage-d)'; this.style.borderBottomColor='var(--sage-d)'"
               onmouseout="this.style.color='inherit'; this.style.borderBottomColor='var(--border)'">
                @ing.ProductName
            </a>
        </span>
    @if (!string.IsNullOrEmpty(displayComment))
    {
    <span class="ing-comment">(@displayComment)</span>
    }
    </span>
    <span class="ing-amount">
    <span class="ing-amount-val">@Math.Round(ing.Amount, 1)</span> @ing.Unit
    @if (ing.Calories > 0)
    {
    <span class="ing-cal"> · <span class="ing-cal-val">@ing.Calories?.ToString("F0")</span> ккал</span>
    }
    <span class="ing-price text-muted" style="font-size:.75rem; display:block">
    ≈ <span class="ing-price-val">@Math.Round(ing.PriceForAmount, 1)</span> ₽
    </span>
    </span>
    </li>
    }
    </ul>
    }
</div>
}

<!-- Шаги приготовления -->
@if (Model.Steps?.Any() == true)
{
<div class="rd-section">
<h2 class="rd-section-title">Приготовление</h2>
<div class="steps-grid">
@foreach (var step in Model.Steps.OrderBy(s => s.Order))
{
<div class="step-item">
<div class="step-num">@step.Order</div>
<div class="step-body">
<p class="step-text">@step.Description</p>
@if (!string.IsNullOrEmpty(step.ImageUrl))
{
<img src="@step.ImageUrl" alt="Шаг @step.Order" class="step-img" />
}
    @if (step.TimerSeconds.HasValue && step.TimerSeconds > 0)
    {
    <span class="step-timer">
    <i class="fas fa-clock"></i>
    @(step.TimerSeconds / 60) мин
    </span>
    }
</div>
</div>
}
</div>
</div>
}

<!-- Действия -->
<div class="rd-footer-actions">
<a asp-action="Index" class="btn-soft">
<i class="fas fa-arrow-left"></i> Все рецепты
</a>

@if (Model.IsOwner || User.IsInRole("Admin"))
{
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn-soft primary">
<i class="fas fa-pen"></i> Редактировать
</a>
<button onclick="openDeleteModal('@Model.Id', '@Html.Raw(Model.Name.Replace("'", "\\'"))')"
class="btn-soft danger">
<i class="fas fa-trash"></i> Удалить
</button>
}

<button onclick="shareRecipe()" class="btn-soft" id="share-button">
<i class="fas fa-share-alt"></i> Поделиться
</button>
</div>

</div>
</div>
</div>

<!-- Модалка удаления -->
<div class="del-modal-backdrop" id="delBackdrop" onclick="closeDeleteModal(event)">
<div class="del-modal" onclick="event.stopPropagation()" style="
background:#fff; border-radius:18px; padding:2rem;
max-width:380px; width:90%;
box-shadow:0 24px 64px rgba(0,0,0,.18);
animation: modalIn .25s ease;">
<h4 style="font-family:'Lora',serif;font-size:1.25rem;margin:0 0 .6rem;color:#2d2417">Удалить рецепт?</h4>
<p style="color:#7a7168;font-size:.9rem;margin:0 0 1.5rem">
                                                          «<span id="delRecipeName"></span>» будет удалён навсегда.
</p>
<div style="display:flex;gap:.75rem">
<button onclick="closeDeleteModal()" class="btn-soft" style="flex:1">Отмена</button>
<form id="delForm" method="post" style="flex:1">
@Html.AntiForgeryToken()
<input type="hidden" name="id" id="delRecipeId" />
<button type="submit" class="btn-soft danger"
style="width:100%;justify-content:center;background:#fdf0f0;border-color:var(--heart);color:var(--heart)">
<i class="fas fa-trash"></i> Удалить
</button>
</form>
</div>
</div>
</div>

<style>
.del-modal-backdrop {
    display:none; position:fixed; inset:0;
    background:rgba(0,0,0,.45); z-index:1000;
    align-items:center; justify-content:center;
}
.del-modal-backdrop.open { display:flex; }
@@keyframes modalIn {
     from { opacity:0; transform:translateY(14px) scale(.97); }
     to   { opacity:1; transform:translateY(0) scale(1); }
 }
</style>

<script>
(function() {
    'use strict';

    // ── Базовые константы из Razor ──────────────────────────────────────────
    const BASE_SERVINGS   = @Model.DefaultServings;
    const BASE_TOTAL_COST = @Model.TotalCost.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
    const BASE_KCAL = @Model.CaloriesPerServing.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
    const BASE_P    = @Model.ProteinPerServing.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
    const BASE_F    = @Model.FatPerServing.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
    const BASE_C    = @Model.CarbsPerServing.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
    
    let currentServings = BASE_SERVINGS;
    let _currentTags = @((int)Model.Tags);

    // Вспомогательная функция безопасной установки текста
    function setText(id, val) {
        const el = document.getElementById(id);
        if (el) el.textContent = val;
    }

    // ── Калькулятор порций и ингредиентов ───────────────────────────────────
    function updateServings(val) {
        val = Math.max(1, Math.min(100, val));
        currentServings = val;
        
        const srvInput = document.getElementById('srvInput'); // Если это input, обновляем его value
        if (srvInput) srvInput.value = val;
        
        setText('srvDisplay', val);

        const ratio = val / BASE_SERVINGS;

        // Общее КБЖУ рецепта
        setText('calcKcal', Math.round(BASE_KCAL * val));
        setText('calcP',    (BASE_P * val).toFixed(1));
        setText('calcF',    (BASE_F * val).toFixed(1));
        setText('calcC',    (BASE_C * val).toFixed(1));
        setText('calcCost', (BASE_TOTAL_COST * ratio).toFixed(2));

        // Пересчет каждого ингредиента в списке
        document.querySelectorAll('.ing-item[data-base-amount]').forEach(item => {
            const newAmt  = parseFloat(item.dataset.baseAmount) * ratio;
            const basePrice = parseFloat(item.dataset.basePrice || 0);
            
            const amtEl   = item.querySelector('.ing-amount-val');
            const priceEl = item.querySelector('.ing-price-val');
            const calEl   = item.querySelector('.ing-cal-val');

            if (amtEl)   amtEl.textContent = newAmt < 10 ? newAmt.toFixed(1) : Math.round(newAmt);
            if (priceEl) priceEl.textContent = (basePrice * newAmt / 100).toFixed(1);
            
            if (calEl) {
                // Ленивая инициализация базового значения калорийности под конкретный вес
                if (!calEl.dataset.base) calEl.dataset.base = calEl.textContent;
                calEl.textContent = Math.round(parseFloat(calEl.dataset.base) * ratio);
            }
        });
    }

    // Слушатели кликов порций
    const btnMinus = document.getElementById('srvMinus');
    const btnPlus = document.getElementById('srvPlus');
    const srvInput = document.getElementById('srvInput');

    if (btnMinus) btnMinus.addEventListener('click', () => updateServings(currentServings - 1));
    if (btnPlus)  btnPlus.addEventListener('click', () => updateServings(currentServings + 1));
    
    // Поддержка ручного ввода порций в input (если он есть)
    if (srvInput) {
        srvInput.addEventListener('input', function() {
            const val = parseInt(this.value);
            if (!isNaN(val)) updateServings(val);
        });
    }

    // ── Управление модалкой удаления ────────────────────────────────────────
    window.openDeleteModal = function(id, name) {
        const delRecipeId = document.getElementById("delRecipeId");
        const delRecipeName = document.getElementById("delRecipeName");
        const delForm = document.getElementById("delForm");
        const backdrop = document.getElementById("delBackdrop");

        if (delRecipeId) delRecipeId.value = id;
        if (delRecipeName) delRecipeName.textContent = name;
        if (delForm) delForm.action = "/Recipe/Delete";
        if (backdrop) backdrop.classList.add("open");
    };

    window.closeDeleteModal = function(e) {
        const backdrop = document.getElementById("delBackdrop");
        if (backdrop && (!e || e.target === backdrop)) {
            backdrop.classList.remove("open");
        }
    };

    document.addEventListener("keydown", e => {
        if (e.key === "Escape") {
            const backdrop = document.getElementById("delBackdrop");
            if (backdrop) backdrop.classList.remove("open");
        }
    });

    // ── Кнопка «Поделиться» (с фоллбэком на буфер обмена) ────────────────────
    const shareButton = document.getElementById('share-button');
    if (shareButton) {
        shareButton.addEventListener('click', async () => {
            if (navigator.share) {
                try {
                    await navigator.share({
                        title: document.title,
                        text: 'Посмотрите этот крутой рецепт!',
                        url: window.location.href
                    });
                } catch (error) {
                    if (error.name !== 'AbortError') console.error('Ошибка Share:', error);
                }
            } else {
                // Фоллбэк: копируем в буфер, если Web Share не поддерживается
                try {
                    await navigator.clipboard.writeText(window.location.href);
                    alert('Ссылка успешно скопирована в буфер обмена!');
                } catch (err) {
                    alert('Не удалось скопировать ссылку.');
                }
            }
        });
    }

    // ── Управление Битовыми Масками Тегов ───────────────────────────────────
    document.querySelectorAll('.tag-pill').forEach(btn => {
        btn.addEventListener('click', function () {
            const val = parseInt(this.dataset.tag);
            _currentTags ^= val; // Инвертируем выбранный бит
            this.classList.toggle('active');
            
            const status = document.getElementById('tagsSaveStatus');
            if (status) status.style.display = 'none';
        });
    });

    // Сохранение тегов
    window.saveTags = async function(recipeId) {
        const btn = document.getElementById('saveTagsBtn');
        if (!btn) return;

        btn.disabled = true;
        const originalText = btn.textContent;
        btn.textContent = 'Сохранение...';

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            const params = new URLSearchParams({
                id: recipeId,
                tags: _currentTags,
                __RequestVerificationToken: token
            });

            const res = await fetch('/Recipe/SetTags', { method: 'POST', body: params });
            const data = await res.json();

            if (data.success) {
                _currentTags = data.tags;
                const status = document.getElementById('tagsSaveStatus');
                if (status) {
                    status.style.display = 'inline';
                    setTimeout(() => status.style.display = 'none', 2500);
                }
            }
        } catch (e) {
            alert('Не удалось сохранить изменения');
        } finally {
            btn.disabled = false;
            btn.textContent = originalText;
        }
    };

    // Автоподбор тегов (Регулярные выражения)
    window.autoTag = async function(recipeId, recipeName) {
        const n = recipeName.toLowerCase();
        let tags = 0;

        // Сверяем значения строго по битам C# Enum
        const Breakfast  = 1,      // 1 << 0
            Lunch      = 2,      // 1 << 1
            Dinner     = 4,      // 1 << 2
            Snack      = 8,      // 1 << 3
            Soup       = 16,     // 1 << 4
            Salad      = 32,     // 1 << 5
            MainCourse = 64,     // 1 << 6
            Garnish    = 128,    // 1 << 7
            Dessert    = 256,    // 1 << 8
            Drink      = 512,    // 1 << 9
            Quick      = 1024,   // 1 << 10 (Новый)
            Festive    = 2048;   // 1 << 11 (Новый)

        // ── 1. Классификация по типу блюда ──────────────────────────────────────
        if (/суп|борщ|щи|солянк|уха|рассольник|окрошк|бульон|шурпа|лагман|хаш|гаспачо/.test(n)) tags |= Soup;
        if (/салат|винегрет|цезарь|оливье/.test(n)) tags |= Salad;
        if (/чай|кофе|сок|компот|смузи|какао|морс|кисель|напиток|коктейл|лимонад|фреш|матча|латте|капучино/.test(n)) tags |= Drink;
        if (/торт|пирожн|десерт|мороженое|пудинг|желе|вафл|варень|джем|печень|пирог|кекс|чизкейк|конфет|капкейк|круассан|маффин|брауни|штрудель|синнабон|мусс|пастила|зефир/.test(n)) tags |= Dessert;
        if (/рис|гречк|пюре|картоф|картош|макарон|лапш|гарнир|перловк|булгур|кускус|киноа|нут|чечевиц|вермишел|спагетти|фунчоз/.test(n)) tags |= Garnish;
        if (/каша|омлет|яичниц|мюсли|тост|запеканк|сырник|творог|блин|оладь|панкейк|гранола|бутерброд|сэндвич|круассан|шакшук/.test(n)) tags |= Breakfast;
        if (/котлет|куриц|кур|мясо|рыб|стейк|плов|гуляш|тефтел|фрикадел|шашлык|пицц|лазань|фарш|говядин|свинин|индейк|наггетс|гусь|утк|креветк|кальмар|мидии|стейк|пюре с|мясо по/.test(n)) tags |= MainCourse;

        // Пересечения
        if (/паста|болоньез|карбонар/.test(n)) {
            tags |= MainCourse;
            tags |= Garnish;
        }
        if (/бутерброд|сэндвич|тост/.test(n)) tags |= Snack;

        // ── 2. НОВЫЕ ТЕГИ: Быстрое (Quick) и Праздничное (Festive) ───────────────

        // Праздничные маркеры: запеченная утка, шашлык, торты, имбирные пряники, новогодние салаты и т.д.
        if (/шашлык|запечен|новогод|рождеств|пасха|празднич|оливье|цезарь|торт|кальмар|креветк|мидии|стейк|гусь|утк|рулет/.test(n)) {
            tags |= Festive;
        }

        // Быстрые блюда (то, что обычно готовится мгновенно: яичницы, бутерброды, смузи, коктейли)
        if (/яичниц|омлет|тост|бутерброд|сэндвич|смузи|коктейл|фреш|наггетс|салат за|салат с|гренки|чипсы|закуск/.test(n)) {
            tags |= Quick;
        }

        // ── 3. Логика простановки времени приёма пищи (Тайминги) ──────────────────
        const isAux = tags & (Soup | Salad | Drink | Dessert | Garnish);
        if (!isAux) tags |= MainCourse; // Если никуда не подошло — это основное блюдо

        if (tags & Drink || tags & Dessert) tags |= Breakfast | Lunch | Dinner | Snack;
        if (tags & MainCourse || tags & Garnish) tags |= Lunch | Dinner;
        if (tags & Soup || tags & Salad) tags |= Lunch | Dinner;
        if (tags & Salad || tags & Dessert || tags & Drink) tags |= Snack;

        // Страховка: если ни один тайминг не зацепился, ставим стандартные обед/ужин
        if (!(tags & (Breakfast | Lunch | Dinner | Snack))) {
            tags |= Lunch | Dinner;
        }

        _currentTags = tags;

        // Синхронизируем визуальное состояние кнопок `.tag-pill` на фронтенде
        document.querySelectorAll('.tag-pill').forEach(btn => {
            const val = parseInt(btn.dataset.tag);
            btn.classList.toggle('active', !!(tags & val));
        });

        // Отправляем AJAX запрос на сервер (`/Recipe/SetTags`)
        await window.saveTags(recipeId);
    };
})();
</script>
