@model Presentation.Models.RecipeDetailViewModel

<div class="container py-5">
    <div class="card" style="border-radius: 1.8rem; overflow: hidden;">
        <div class="text-center position-relative">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" class="w-100" style="max-height: 500px; object-fit: cover;">
            }
            else
            {
                <div class="bg-light d-flex align-items-center justify-content-center" style="height: 500px;">
                    <i class="fas fa-image fs-1 text-muted"></i>
                </div>
            }

            <div class="position-absolute bottom-0 start-0 end-0 p-5" style="background: linear-gradient(transparent, rgba(0,0,0,0.7));">
                <h1 class="text-white mb-0">@(Model.Name.Substring(0, 1).ToUpper()+Model.Name.Substring(1))</h1>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="text-white-50 fs-4 mt-2">@Model.Description</p>
                }
            </div>
        </div>

        <div class="card-body p-5">
            <div class="row g-5">
                <div class="col-lg-4">
                    <div class="p-4 rounded-4 text-center" style="background: var(--primary-light);">
                        <div class="fs-2 fw-bold" style="color: var(--primary);">
                            @Math.Round(Model.CaloriesPerServing, 2) ккал
                        </div>
                        <div class="fs-2 fw-bold" style="color: var(--primary);">
                            @Math.Round(Model.CostPerServing,2 ) руб
                        </div>
                        <small class="text-muted">на порцию (@Model.DefaultServings порц.)</small>
                    </div>
                </div>
                <div class="col-lg-8">
                    <h3 class="mb-4" style="color: var(--primary);">Ингредиенты</h3>
                    <ul class="list-group">
                        @foreach (var ing in Model.Ingredients)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <strong>@ing.ProductName</strong>
                                    @if (!string.IsNullOrEmpty(ing.Comment))
                                    {
                                        <small class="text-muted">(@ing.Comment)</small>
                                    }
                                </div>
                                <small class="text-muted">@Math.Round(ing.Amount, 2) @ing.Unit / @(ing.Calories?.ToString("F0") ?? "—") ккал</small>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <h3 class="mt-5 mb-4" style="color: var(--primary);">Приготовление</h3>
            <div class="row g-4">
                @foreach (var step in Model.Steps.OrderBy(s => s.Order))
                {
                    <div class="col-12">
                        <div class="d-flex">
                            <div class="flex-shrink-0 me-4">
                                <div class="rounded-circle d-flex align-items-center justify-content-center fs-3 fw-bold" style="width: 60px; height: 60px; background: var(--primary); color: white;">
                                    @step.Order
                                </div>
                            </div>
                            <div class="flex-grow-1">
                                <p class="mb-3 fs-normal">@step.Description</p>
                                @if (!string.IsNullOrEmpty(step.ImageUrl))
                                {
                                    <img src="@step.ImageUrl" alt="Шаг @step.Order" class="rounded-4 w-100" style="max-height: 400px; object-fit: cover;">
                                }
                                @if (step.TimerSeconds.HasValue)
                                {
                                    <small class="text-muted"><i class="fas fa-clock me-1"></i> Таймер: @(step.TimerSeconds / 60) мин</small>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="text-center mt-5">
                <a asp-action="Index" class="btn btn-outline-primary btn-lg">← Все рецепты</a>
            </div>
        </div>
    </div>
</div>