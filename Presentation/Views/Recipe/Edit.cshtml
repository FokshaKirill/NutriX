@using Presentation.Models
@model Presentation.Models.RecipeCreateViewModel

@{
    ViewData["Title"] = Model.Id != Guid.Empty ? "Редактировать рецепт" : "Новый рецепт";
    var isEdit = Model.Id != Guid.Empty;
}

<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>

<div class="edit-page">
    <h1 class="edit-page-title">@(isEdit ? "Редактировать рецепт" : "Новый рецепт")</h1>

    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data" id="recipeForm">
        @Html.AntiForgeryToken()
        @if (isEdit) { <input type="hidden" asp-for="Id"/> }
        <input type="hidden" asp-for="ImageUrl" id="existingImageUrl"/>

        <div class="edit-layout">

            <!-- ══ LEFT COLUMN ══ -->
            <div>

                <!-- Основная информация -->
                <div class="edit-card">
                    <p class="card-label">Основная информация</p>

                    <div class="field">
                        <label class="field-lbl">Название рецепта</label>
                        <input asp-for="Name" class="field-input" placeholder="Например: Паста Карбонара" required/>
                        <span asp-validation-for="Name" class="field-error"></span>
                    </div>

                    <div class="row-2">
                        <div class="field">
                            <label class="field-lbl">Порций</label>
                            <input asp-for="DefaultServings" type="number" class="field-input"
                                   min="1" max="100" id="servingsInput" required/>
                        </div>
                        @* <div class="field"> *@
                        @*     <label class="field-lbl">Время (мин.)</label> *@
                        @*     <input asp-for="CookingTimeMinutes" type="number" class="field-input" *@
                        @*            min="1" placeholder="45"/> *@
                        @* </div> *@
                    </div>

                    <div class="field">
                        <label class="field-lbl">Описание</label>
                        <textarea asp-for="Description" class="field-textarea" rows="3"
                                  placeholder="Кратко опишите рецепт..."></textarea>
                    </div>
                </div>

                <!-- Ингредиенты -->
                <div class="edit-card">
                    <p class="card-label">Ингредиенты</p>

                    <div id="ingredientsContainer">
                        @for (int i = 0; i < Model.Ingredients.Count; i++)
                        {
                            @await Html.PartialAsync("_IngredientRow",
                                new Tuple<int, RecipeIngredientViewModel>(i, Model.Ingredients[i]))
                        }
                    </div>

                    <button type="button" class="add-btn" id="addIngredient">+ Добавить ингредиент</button>
                </div>

                <!-- Шаги -->
                <div class="edit-card">
                    <p class="card-label">Шаги приготовления</p>

                    <div id="stepsContainer">
                        @for (int i = 0; i < Model.Steps.Count; i++)
                        {
                            @await Html.PartialAsync("_StepRow",
                                new Tuple<int, RecipeStepViewModel>(i, Model.Steps[i]))
                        }
                    </div>

                    <button type="button" class="add-btn" id="addStep">+ Добавить шаг</button>
                </div>

                <div class="edit-actions">
                    <button type="submit" class="btn-save">
                        ✓ @(isEdit ? "Сохранить изменения" : "Создать рецепт")
                    </button>
                    @if (isEdit)
                    {
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn-cancel">Отмена</a>
                    }
                    else
                    {
                        <a asp-action="Index" class="btn-cancel">Отмена</a>
                    }
                </div>
            </div>

            <!-- ══ RIGHT COLUMN (sticky sidebar) ══ -->
            <div style="position: sticky; top: 1rem;">

                <!-- Главное фото -->
                <div class="edit-card">
                    <p class="card-label">Главное фото</p>

                    <div class="photo-drop @(!string.IsNullOrEmpty(Model.ImageUrl) ? "filled" : "")"
                         id="mainPhotoArea">

                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" class="photo-drop-preview" id="mainPhotoPreview" alt=""/>
                            <span class="photo-drop-badge">Сменить</span>
                        }
                        else
                        {
                            <img src="" class="photo-drop-preview" id="mainPhotoPreview"
                                 style="display:none; height:220px; object-fit:cover;" alt=""/>
                            <div class="photo-drop-ph" id="mainPhotoPh">
                                <span class="ph-ico">🖼</span>
                                <div class="ph-lbl">Нажмите для загрузки</div>
                                <div class="ph-sub">JPG, PNG, WEBP · до 5 МБ</div>
                            </div>
                        }

                        <input type="file" name="mainImage" id="mainPhotoInput" accept="image/*"/>
                    </div>
                </div>

                <!-- Live стоимость -->
                <div class="edit-card">
                    <p class="card-label">Стоимость рецепта</p>
                    <div class="cost-box">
                        <div class="cost-box-label">Итого</div>
                        <div style="display:flex;align-items:baseline;gap:.3rem">
                            <span class="cost-box-total" id="totalPriceVal">0.00</span>
                            <span style="font-size:.95rem;color:var(--muted)">₽</span>
                        </div>
                        <div class="cost-box-per">за порцию: <b id="perServingVal">0.00</b> ₽</div>
                    </div>

                    <!-- Список ингредиентов с ценами -->
                    <div id="costBreakdown" style="margin-top:.85rem;display:flex;flex-direction:column;gap:.3rem"></div>
                </div>

            </div>
        </div>
    </form>
</div>

<!-- Шаблоны -->
<div id="ingredientTemplate" style="display:none">
    @await Html.PartialAsync("_IngredientRow",
        new Tuple<int, RecipeIngredientViewModel>(0, new RecipeIngredientViewModel()))
</div>
<div id="stepTemplate" style="display:none">
    @await Html.PartialAsync("_StepRow",
        new Tuple<int, RecipeStepViewModel>(0, new RecipeStepViewModel()))
</div>

@section Scripts {
<script>
// ─── Продукты из сервера ───────────────────────────────────────────────────
const PRODUCTS = @Html.Raw(Json.Serialize(
    ViewBag.Products == null
        ? new List<object>()
        : ((List<Domain.Entities.Product>)ViewBag.Products).Select(p => new {
            id           = p.Id.ToString(),
            name         = p.Name,
            pricePerUnit = p.PricePerUnit,
            unit         = p.Unit
        })
));
const PM = {};  // product map: id → product
PRODUCTS.forEach(p => PM[p.id] = p);

let ingIdx  = @Model.Ingredients.Count;
let stepIdx = @Model.Steps.Count;

// ─── Главное фото ──────────────────────────────────────────────────────────
document.getElementById('mainPhotoInput').addEventListener('change', function () {
    if (!this.files[0]) return;
    const reader = new FileReader();
    reader.onload = ev => {
        const prev = document.getElementById('mainPhotoPreview');
        const ph   = document.getElementById('mainPhotoPh');
        prev.src = ev.target.result;
        prev.style.display = 'block';
        if (ph) ph.style.display = 'none';
        document.getElementById('mainPhotoArea').classList.add('filled');
    };
    reader.readAsDataURL(this.files[0]);
});

// ─── Калькулятор стоимости ─────────────────────────────────────────────────
function calcCost() {
    let total = 0;
    const breakdown = [];

    document.querySelectorAll('#ingredientsContainer .ing-row').forEach(row => {
        const sel   = row.querySelector('.ing-sel');
        const amt   = parseFloat(row.querySelector('.ing-amt')?.value) || 0;
        const chip  = row.querySelector('.ing-chip');
        if (!sel) return;

        const prod = PM[sel.value];
        if (!prod || !amt) {
            if (chip) chip.textContent = '—';
            return;
        }
        const line = prod.pricePerUnit * amt / 100;
        total += line;
        if (chip) chip.textContent = line.toFixed(1) + ' ₽';
        breakdown.push({ name: prod.name, price: line });
    });

    document.getElementById('totalPriceVal').textContent = total.toFixed(2);
    const srv = Math.max(1, parseInt(document.getElementById('servingsInput')?.value) || 1);
    document.getElementById('perServingVal').textContent = (total / srv).toFixed(2);

    // breakdown list
    const bd = document.getElementById('costBreakdown');
    bd.innerHTML = breakdown.map(b =>
        `<div style="display:flex;justify-content:space-between;font-size:.78rem;color:var(--muted)">
            <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:65%">${b.name}</span>
            <span style="font-weight:600;color:var(--bark)">${b.price.toFixed(1)} ₽</span>
         </div>`
    ).join('');
}

// ─── Добавить ингредиент ───────────────────────────────────────────────────
document.getElementById('addIngredient').addEventListener('click', () => {
    let html = document.getElementById('ingredientTemplate').innerHTML;
    html = html.replace(/Ingredients\[0\]/g, `Ingredients[${ingIdx}]`);
    const wrap = document.createElement('div');
    wrap.innerHTML = html.trim();
    document.getElementById('ingredientsContainer').appendChild(wrap.firstElementChild);
    ingIdx++;
    calcCost();
});

// ─── Добавить шаг ─────────────────────────────────────────────────────────
document.getElementById('addStep').addEventListener('click', () => {
    let html = document.getElementById('stepTemplate').innerHTML;
    html = html.replace(/Steps\[0\]/g, `Steps[${stepIdx}]`);
    // fix StepImages index too
    html = html.replace(/StepImages\[0\]/g, `StepImages[${stepIdx}]`);
    const wrap = document.createElement('div');
    wrap.innerHTML = html.trim();
    const row = wrap.firstElementChild;
    const numEl = row.querySelector('.step-num');
    if (numEl) numEl.textContent = stepIdx + 1;
    document.getElementById('stepsContainer').appendChild(row);
    bindStepPhoto(row);
    stepIdx++;
});

// ─── Делегированные события ───────────────────────────────────────────────
document.addEventListener('click', e => {
    if (e.target.closest('.ing-del')) {
        e.target.closest('.ing-row').remove();
        calcCost();
    }
    if (e.target.closest('.step-del')) {
        e.target.closest('.step-row').remove();
        renumberSteps();
    }
});

document.addEventListener('change', e => {
    if (e.target.closest('.ing-sel') || e.target.closest('.ing-amt')) calcCost();
    if (e.target.id === 'servingsInput') calcCost();
});
document.addEventListener('input', e => {
    if (e.target.closest('.ing-amt')) calcCost();
    if (e.target.id === 'servingsInput') calcCost();
});

function renumberSteps() {
    document.querySelectorAll('#stepsContainer .step-row').forEach((r, i) => {
        const el = r.querySelector('.step-num');
        if (el) el.textContent = i + 1;
    });
}

// ─── Фото шага ────────────────────────────────────────────────────────────
function bindStepPhoto(row) {
    const input = row.querySelector('.sph-input');
    const btn   = row.querySelector('.sph-btn');
    const thumb = row.querySelector('.sph-thumb');
    if (!input) return;
    input.addEventListener('change', function () {
        if (!this.files[0]) return;
        const reader = new FileReader();
        reader.onload = ev => {
            if (thumb) { thumb.src = ev.target.result; thumb.classList.add('on'); }
            if (btn)   { btn.classList.add('on'); }
            const lbl = btn?.querySelector('.sph-lbl');
            if (lbl) lbl.textContent = 'Сменить';
        };
        reader.readAsDataURL(this.files[0]);
    });
}

// Привязать к уже отрисованным шагам
document.querySelectorAll('#stepsContainer .step-row').forEach(r => bindStepPhoto(r));

// ─── Первичный расчёт ─────────────────────────────────────────────────────
calcCost();
</script>
}