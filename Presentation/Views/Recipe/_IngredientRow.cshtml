@model Tuple<int, Presentation.Models.RecipeIngredientViewModel>

<div class="ing-row" data-index="@Model.Item1">
    <select name="Ingredients[@Model.Item1].ProductId" class="ing-select product-select" required>
        <option value="">— продукт —</option>
        @foreach (var p in ViewBag.Products as List<Domain.Entities.Product>)
        {
            if (p.Id == Model.Item2.ProductId)
            {
                <option value="@p.Id" selected
                        data-price="@p.PricePerUnit"
                        data-name="@p.Name">
                    @p.Name (@p.PricePerUnit ₽/@p.Unit)
                </option>
            }
            else
            {
                <option value="@p.Id"
                        data-price="@p.PricePerUnit"
                        data-name="@p.Name">
                    @p.Name (@p.PricePerUnit ₽/@p.Unit)
                </option>
            }
        }
    </select>
    <input type="hidden" name="Ingredients[@Model.Item1].ProductName"
           value="@Model.Item2.ProductName" class="product-name-hidden" />

    <input name="Ingredients[@Model.Item1].Amount" type="number" step="0.01"
           class="ing-amount-input amount-input" placeholder="г" value="@Model.Item2.Amount" required />

    <input name="Ingredients[@Model.Item1].Comment" class="ing-comment-input"
           placeholder="комментарий" value="@Model.Item2.Comment" />

    <button type="button" class="ing-remove remove-ingredient" title="Удалить">×</button>
</div>