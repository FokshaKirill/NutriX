@model Tuple<int, Presentation.Models.RecipeIngredientViewModel>

<div class="ing-row" data-index="@Model.Item1">

    <select name="Ingredients[@Model.Item1].ProductId"
            class="ing-sel" required>
        <option value="">— продукт —</option>
        @foreach (var p in (ViewBag.Products as List<Domain.Entities.Product>) ?? new())
        {
            <!option value="@p.Id" @(p.Id == Model.Item2.ProductId ? "selected=\"selected\"" : "")>
                @p.Name (@p.PricePerUnit ₽/@p.Unit)
            </!option>
        }
    </select>

    <input type="hidden"
           name="Ingredients[@Model.Item1].ProductName"
           value="@Model.Item2.ProductName"
           class="ing-pname"/>

    <input name="Ingredients[@Model.Item1].Amount"
           type="number" step="0.01" min="0"
           class="ing-amt"
           value="@(Model.Item2.Amount > 0 ? Model.Item2.Amount.ToString() : "")"
           required/>
    <input name="Ingredients[@Model.Item1].Unit"
           class="ing-unit"
           placeholder="г"
           value="@(string.IsNullOrEmpty(Model.Item2.Unit) ? "г" : Model.Item2.Unit)"
           style="width:46px;border:none;border-left:1px solid var(--border);
              background:transparent;font-size:.84rem;color:var(--muted);
              outline:none;padding:0 .4rem;font-family:'DM Sans',sans-serif;"/>
    <input name="Ingredients[@Model.Item1].Comment"
           class="ing-cmt"
           placeholder="комментарий"
           value="@Model.Item2.Comment"/>

    <span class="ing-chip">—</span>

    <button type="button" class="ing-del remove-ingredient" title="Удалить">×</button>
</div>