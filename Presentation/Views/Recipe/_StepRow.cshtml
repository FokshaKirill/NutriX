@model Tuple<int, Presentation.Models.RecipeStepViewModel>

<div class="step-row-edit" data-index="@Model.Item1">
    <div class="step-row-num">@(Model.Item1 + 1)</div>
    <textarea name="Steps[@Model.Item1].Description"
              class="step-row-text" rows="2"
              placeholder="Описание шага...">@Model.Item2.Description</textarea>
    <input name="Steps[@Model.Item1].TimerSeconds" type="number"
           class="step-row-timer" placeholder="сек" value="@Model.Item2.TimerSeconds" />
    <button type="button" class="ing-remove remove-step" title="Удалить">×</button>
</div>