@using Domain.Enums
@model List<Presentation.Models.RecipeListViewModel>
@{
ViewData["Title"] = ViewData["Title"] ?? "Все рецепты";
var isFavPage = ViewData["Title"]?.ToString() == "Избранные рецепты";
}

@Html.AntiForgeryToken()

<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />

<div class="container recipes-page">
    <!-- Шапка -->
    <div class="page-head">
        <div>
            <h1>@ViewData["Title"]</h1>
            <p>@(Model.Count == 0 ? "Ничего не найдено" : $"Найдено рецептов: {ViewBag.TotalCount}")</p>
        </div>
        
        @if (!isFavPage)
        {
            <div class="head-actions">
                <a asp-action="Import" class="btn-outline-soft">
                    <i class="fas fa-download"></i> Импорт
                </a>
                <a asp-action="Create" class="btn-primary-soft">
                    <i class="fas fa-plus"></i> Создать рецепт
                </a>
            </div>
        }
    </div>

    <!-- Фильтры + Поиск -->
    @if (!isFavPage)
    {
        <div class="d-flex flex-wrap gap-3 mb-4 align-items-end">
            <form asp-action="Index" method="get" class="d-flex flex-grow-1 gap-2 flex-wrap">

                <!-- Поиск -->
                <div style="min-width: 280px;">
                    <input type="search" name="searchTerm" value="@ViewBag.SearchTerm"
                           class="form-control" placeholder="Поиск по названию или описанию..." />
                </div>
                
                <div style="min-width: 200px;">
                    <select name="tag" class="form-select">
                        <option value="">Все приёмы пищи</option>
                        @foreach (var (tagVal, label) in ViewBag.Tags as (RecipeTag, string)[])
                        {
                            var isSelected = (int)tagVal == (int?)ViewBag.SelectedTag;
                            <option value="@((int)tagVal)" selected="@isSelected">
                                @label
                            </option>
                        }
                    </select>
                </div>

                <button type="submit" class="btn-primary-soft">Найти</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
            </form>
        </div>
    }

    <!-- Пустое состояние -->
    @if (!Model.Any())
    {
        <div class="recipes-empty">
            <div class="empty-icon">@(isFavPage ? "♡" : "🍽")</div>
            <h3>@(isFavPage ? "Избранное пусто" : "Рецептов не найдено")</h3>
            <p>@(isFavPage ? "Добавляйте понравившиеся рецепты в избранное" : "Попробуйте изменить параметры поиска")</p>
        </div>
    }
    else
    {
        <!-- Сетка рецептов -->
        <div class="recipes-grid" data-page="@(isFavPage ? "favorites" : "recipes")">
            @foreach (var r in Model)
            {
                @await Html.PartialAsync("_RecipeCard", r, new ViewDataDictionary(ViewData) { ["ShowActions"] = !isFavPage })
            }
        </div>
    
    @if (ViewBag.TotalPages > 1)
    {
        <!-- Пагинация -->
        <nav aria-label="Пагинация" class="mt-5">
            <ul class="pagination justify-content-center flex-wrap">

                @if (ViewBag.CurrentPage > 1)
                {
                <li class="page-item">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage - 1)"
                       asp-route-searchTerm="@ViewBag.SearchTerm">
                        &laquo; Назад
                    </a>
                </li>
                }

                @for (int i = Math.Max(1, ViewBag.CurrentPage - 5);
                i <= Math.Min((int)ViewBag.TotalPages, ViewBag.CurrentPage + 5); i++)
                {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@i"
                       asp-route-searchTerm="@ViewBag.SearchTerm">
                        @i
                    </a>
                </li>
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                <li class="page-item">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage + 1)"
                       asp-route-searchTerm="@ViewBag.SearchTerm">
                        Вперед &raquo;
                    </a>
                </li>
                }
            </ul>
        </nav>
    }
}
</div>

<!-- Модалка удаления -->
<div class="del-modal-backdrop" id="delBackdrop" onclick="closeDeleteModal(event)">
    <div class="del-modal" onclick="event.stopPropagation()">
        <h4>Удалить рецепт?</h4>
        <p>«<span id="delRecipeName"></span>» будет удалён навсегда.</p>
        <div class="del-modal-btns">
            <button class="btn-card" onclick="closeDeleteModal()">Отмена</button>
            <form id="delForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="delRecipeId" />
                <button type="submit" class="btn-card danger">
                    <i class="fas fa-trash"></i> Удалить
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openDeleteModal(id, name) {
        document.getElementById("delRecipeId").value = id;
        document.getElementById("delRecipeName").textContent = name;
        document.getElementById("delForm").action = "/Recipe/Delete";
        document.getElementById("delBackdrop").classList.add("open");
    }

    function closeDeleteModal(e) {
        if (!e || e.target === document.getElementById("delBackdrop"))
            document.getElementById("delBackdrop").classList.remove("open");
    }

    document.addEventListener("keydown", e => {
        if (e.key === "Escape") document.getElementById("delBackdrop").classList.remove("open");
    });
</script>
}