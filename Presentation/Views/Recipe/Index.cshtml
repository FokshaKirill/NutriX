@model List<Presentation.Models.RecipeListViewModel>

@{
    ViewData["Title"] = "Рецепты";
}

<div class="container py-5">
    <!-- Заголовок и кнопки действий -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 style="color: var(--primary);">
                <i class="fas fa-book me-2"></i>
                Мои рецепты
            </h2>
            <p class="text-muted mb-0">Всего рецептов: @Model.Count</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Import" class="btn btn-outline-success btn-lg">
                <i class="fas fa-download me-2"></i>
                Импортировать
            </a>
            <a asp-action="Create" class="btn btn-success btn-lg">
                <i class="fas fa-plus me-2"></i>
                Создать рецепт
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <!-- Пустое состояние -->
        <div class="text-center py-5">
            <i class="fas fa-book-open fa-5x mb-4" style="color: var(--primary); opacity: 0.3;"></i>
            <h3 class="mb-3">У вас пока нет рецептов</h3>
            <p class="text-muted mb-4">Создайте первый рецепт или импортируйте из интернета</p>
            <div class="d-flex gap-3 justify-content-center">
                <a asp-action="Import" class="btn btn-outline-primary btn-lg">
                    <i class="fas fa-download me-2"></i>
                    Импортировать рецепт
                </a>
                <a asp-action="Create" class="btn btn-success btn-lg">
                    <i class="fas fa-plus me-2"></i>
                    Создать рецепт
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Сетка рецептов -->
        <div class="row g-4">
            @foreach (var recipe in Model)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 shadow-sm recipe-card">
                        <!-- Изображение -->
                        <div class="recipe-image-container position-relative">
                            @if (!string.IsNullOrEmpty(recipe.ImageUrl))
                            {
                                <img src="@recipe.ImageUrl" 
                                     class="card-img-top recipe-image" 
                                     alt="@recipe.Name"
                                     style="height: 250px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="card-img-top d-flex align-items-center justify-content-center" 
                                     style="height: 250px; background: var(--primary-light);">
                                    <i class="fas fa-utensils fa-3x" style="color: var(--primary); opacity: 0.5;"></i>
                                </div>
                            }
                            
                            <!-- Бейдж с порциями -->
                            <span class="badge position-absolute top-0 end-0 m-3" 
                                  style="background: var(--primary); font-size: 0.9rem;">
                                <i class="fas fa-user me-1"></i>
                                @recipe.DefaultServings порц.
                            </span>
                        </div>

                        <div class="card-body d-flex flex-column">
                            <!-- Название -->
                            <h5 class="card-title mb-2">
                                <a asp-action="Details" asp-route-id="@recipe.Id" 
                                   class="text-decoration-none" style="color: var(--text);">
                                    @recipe.Name
                                </a>
                            </h5>

                            <!-- Описание -->
                            @if (!string.IsNullOrEmpty(recipe.Description))
                            {
                                <p class="card-text text-muted small">
                                    @(recipe.Description.Length > 100 
                                        ? recipe.Description.Substring(0, 100) + "..." 
                                        : recipe.Description)
                                </p>
                            }

                            <!-- Статистика -->
                            <div class="mt-auto">
                                <div class="row g-2 text-center mb-3">
                                    <div class="col-4">
                                        <div class="small text-muted">Калорий</div>
                                        <div class="small fw-bold">@recipe.CaloriesPerServing?.ToString("F0") ккал</div>
                                    </div>
                                    <div class="col-4">
                                        <div class="small text-muted">Цена</div>
                                        <div class="small fw-bold">@recipe.TotalCost.ToString("F0") ₽</div>
                                    </div>
                                    <div class="col-4">
                                        <div class="small text-muted">Продуктов</div>
                                        <div class="small fw-bold">@recipe.IngredientsCount</div>
                                    </div>
                                </div>

                                <!-- Кнопки действий -->
                                <div class="d-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@recipe.Id" 
                                       class="btn btn-outline-primary btn-sm flex-fill">
                                        <i class="fas fa-eye me-1"></i>
                                        Открыть
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@recipe.Id" 
                                       class="btn btn-outline-secondary btn-sm">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button type="button" 
                                            class="btn btn-outline-danger btn-sm"
                                            onclick="deleteRecipe('@recipe.Id', '@recipe.Name')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Модалка подтверждения удаления -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background: var(--primary-light);">
                <h5 class="modal-title" style="color: var(--primary);">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Удалить рецепт?
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Вы уверены, что хотите удалить рецепт "<span id="recipeName"></span>"?</p>
                <p class="text-muted small mt-2">Это действие нельзя отменить.</p>
            </div>
            <div class="modal-footer" style="background: var(--primary-light);">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
                <form asp-action="Delete" method="post" id="deleteForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteRecipeId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-1"></i>
                        Удалить
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function deleteRecipe(id, name) {
        $('#deleteRecipeId').val(id);
        $('#recipeName').text(name);
        
        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        modal.show();
    }

    // Анимация карточек при наведении
    $('.recipe-card').hover(
        function() {
            $(this).addClass('shadow-lg').css('transform', 'translateY(-5px)');
        },
        function() {
            $(this).removeClass('shadow-lg').css('transform', 'translateY(0)');
        }
    );
</script>

<style>
    .recipe-card {
        transition: all 0.3s ease;
        border-radius: 1.2rem;
        overflow: hidden;
    }

    .recipe-image {
        transition: transform 0.3s ease;
    }

    .recipe-card:hover .recipe-image {
        transform: scale(1.05);
    }

    .recipe-image-container {
        overflow: hidden;
    }
</style>
}