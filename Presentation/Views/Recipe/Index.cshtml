@model List<Presentation.Models.RecipeListViewModel>

<div class="container py-5">
    <div class="card mb-5" style="border-radius: 1.8rem;">
        <div class="card-header text-center" style="background: var(--primary-light); padding: 3rem;">
            <h2 class="mb-0" style="color: var(--primary);">Все рецепты</h2>
            <p class="fs-4 text-muted">Выберите блюдо для вашего плана питания</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <p class="display-6 text-muted">Рецепты ещё не добавлены...</p>

            <!-- Замени кнопку в заголовке или добавь рядом с поиском -->
            <div class="text-end mb-4">
                <a asp-action="Create" asp-controller="Recipe" class="btn btn-success btn-lg">Создать рецепт</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-5">
            @foreach (var recipe in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100" style="border-radius: 1.8rem; overflow: hidden; background: var(--primary-light);">
                        @if (!string.IsNullOrEmpty(recipe.ImageUrl))
                        {
                            <img src="@recipe.ImageUrl" alt="@recipe.Name" class="card-img-top" style="height: 250px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center" style="height: 250px;">
                                <i class="fas fa-utensils fs-1 text-muted"></i>
                            </div>
                        }

                        <div class="card-body text-center p-4">
                            <h4 class="mb-3" style="color: var(--primary);">@recipe.Name</h4>
                            @if (!string.IsNullOrEmpty(recipe.Description))
                            {
                                <p class="text-muted small mb-4">@recipe.Description</p>
                            }

                            <div class="mb-4">
                                <div class="fs-4 fw-bold" style="color: var(--primary);">@recipe.CaloriesPerServing ккал</div>
                                <small class="text-muted">на порцию (@recipe.DefaultServings порц.)</small>
                            </div>

                            <a asp-action="Details" asp-route-id="@recipe.Id" class="btn btn-success w-100">
                                Посмотреть рецепт
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
            
        <div class="text-center py-5">
            <!-- Замени кнопку в заголовке или добавь рядом с поиском -->
            <div class="text-center mb-4">
                <button type="button" class="btn btn-success btn-lg" data-bs-toggle="modal" data-bs-target="#createRecipeModal">
                    <i class="fas fa-plus me-2"></i> Добавить рецепт
                </button>
            </div>
        </div>
    }
</div>

<!-- Модалка -->
<div class="modal fade" id="createRecipeModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content" style="border-radius: 1.8rem;">
            <div class="modal-header" style="background: var(--primary-light);">
                <h5 class="modal-title" style="color: var(--primary);">Новый рецепт</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div id="createRecipeModalBody">
                <div class="text-center py-5">
                    <div class="spinner-border text-success" role="status"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    $('#createProductModal').on('show.bs.modal', function () {
        const modalBody = $('#createModalBody');
        modalBody.html('<div class="text-center py-5"><div class="spinner-border text-success" role="status"></div><p class="mt-3">Загрузка...</p></div>');

        $.ajax({
            url: '@Url.Action("CreateModal", "Product")',
            type: 'GET',
            cache: false,
            success: function (data) {
                modalBody.html(data);
                attachCategoryFormHandler(); // если есть
                // Здесь можно инициализировать расчёт цены и т.д.
            },
            error: function (xhr, status, error) {
                console.error('Ошибка загрузки модалки:', xhr.responseText);
                modalBody.html(`
                    <div class="alert alert-danger m-4">
                        <h5>Ошибка загрузки формы</h5>
                        <p>Не удалось загрузить форму создания продукта.</p>
                        <small>Статус: ${status} | Ошибка: ${error}</small>
                        <pre class="mt-3 bg-light p-3 rounded" style="max-height: 300px; overflow:auto;">${xhr.responseText || 'Нет данных'}</pre>
                    </div>
                `);
            }
        });
    });
</script>
}