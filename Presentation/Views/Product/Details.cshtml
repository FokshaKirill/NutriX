@model Presentation.Models.ProductViewModel
@using Domain.Entities
@{
    ViewData["Title"] = Model.Name;
    var relatedRecipes = ViewBag.RelatedRecipes as List<Recipe> ?? new();
}

<div class="pd-wrap">
    <a asp-action="Index" class="pd-back mb-2">← Вернуться к каталогу</a>
    
    <div class="pd-hero">
        <div class="pd-photo">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name"/>
            }
            else { <span>🛒</span> }
        </div>

        <div class="pd-info">
            @if (!string.IsNullOrEmpty(Model.CategoryName))
            {
                <p class="pd-category">@Model.CategoryName</p>
            }
            <h1 class="pd-name justify-content-between d-flex">@Model.Name 
                <div class="pd-price-row">
                    <span class="pd-price">@Model.PricePerUnit ₽</span>
                    <span class="pd-price-unit">за @(Model.Unit switch {
                                                       "шт" or "уп" or "упак" => "1 " + Model.Unit,
                                                       "кг" => "1 кг", "л" => "1 л",
                                                       _ => "100 " + Model.Unit
                                                   })</span>
                </div>
            </h1>
            
            <div class="pd-accent"></div>

            <div class="pd-macros">
                <div class="pd-macro is-kcal">
                    <span class="pd-macro-val">@(Model.CaloriesPer100?.ToString("F0") ?? "—")</span>
                    <span class="pd-macro-lbl">ккал</span>
                </div>
                <div class="pd-macro is-p">
                    <span class="pd-macro-val">@(Model.ProteinPer100?.ToString("F1") ?? "—")</span>
                    <span class="pd-macro-lbl">белки</span>
                </div>
                <div class="pd-macro is-f">
                    <span class="pd-macro-val">@(Model.FatPer100?.ToString("F1") ?? "—")</span>
                    <span class="pd-macro-lbl">жиры</span>
                </div>
                <div class="pd-macro is-c">
                    <span class="pd-macro-val">@(Model.CarbsPer100?.ToString("F1") ?? "—")</span>
                    <span class="pd-macro-lbl">углеводы</span>
                </div>
            </div>

            @if (User.IsInRole("Admin"))
            {
                <div class="pd-actions">
                    <button type="button" class="btn btn-sm btn-outline-primary edit-product-btn"
                            data-bs-toggle="modal" data-bs-target="#editProductModal" data-id="@Model.Id">
                        Редактировать
                    </button>
                    <button class="pd-btn danger btn-delete-product" data-id="@Model.Id" data-name="@Model.Name">Удалить</button>
                </div>
            }
        </div>
    </div>

    <div class="pd-sections">

        <!-- Бары нутриентов -->
        <div class="pd-card">
            <p class="pd-card-title">Состав на 100 г</p>
            @{
                var maxMacro = Math.Max(1, new[] {
                    (double)(Model.ProteinPer100 ?? 0),
                    (double)(Model.FatPer100 ?? 0),
                    (double)(Model.CarbsPer100 ?? 0)
                }.Max());
            }
            <div class="pd-bar-row">
                <span class="pd-bar-lbl">Белки</span>
                <div class="pd-bar-track">
                    <div class="pd-bar-fill" style="width:@((Model.ProteinPer100 ?? 0) / (decimal)maxMacro * 100)%; background:#3b82f6;"></div>
                </div>
                <span class="pd-bar-val">@(Model.ProteinPer100?.ToString("F1") ?? "—") г</span>
            </div>
            <div class="pd-bar-row">
                <span class="pd-bar-lbl">Жиры</span>
                <div class="pd-bar-track">
                    <div class="pd-bar-fill" style="width:@((Model.FatPer100 ?? 0) / (decimal)maxMacro * 100)%; background:#f97316;"></div>
                </div>
                <span class="pd-bar-val">@(Model.FatPer100?.ToString("F1") ?? "—") г</span>
            </div>
            <div class="pd-bar-row">
                <span class="pd-bar-lbl">Углеводы</span>
                <div class="pd-bar-track">
                    <div class="pd-bar-fill" style="width:@((Model.CarbsPer100 ?? 0) / (decimal)maxMacro * 100)%; background:#eab308;"></div>
                </div>
                <span class="pd-bar-val">@(Model.CarbsPer100?.ToString("F1") ?? "—") г</span>
            </div>
        </div>

        <!-- Инфо -->
        <div class="pd-card">
            <p class="pd-card-title">Информация</p>
            <div class="pd-row">
                <span class="pd-row-key">Единица</span>
                <span class="pd-row-val">@Model.Unit</span>
            </div>
            @if (Model.WeightGrams.HasValue)
            {
                <div class="pd-row">
                    <span class="pd-row-key">Вес упаковки</span>
                    <span class="pd-row-val">@Model.WeightGrams г</span>
                </div>
            }
            <div class="pd-row">
                <span class="pd-row-key">Источник</span>
                <span class="pd-row-val">@(Model.Source ?? "Внутренняя база")</span>
            </div>
            @if (relatedRecipes.Count > 0)
            {
                <div class="pd-row">
                    <span class="pd-row-key">Используется в рецептах</span>
                    <span class="pd-row-val" style="color: var(--primary);">@relatedRecipes.Count</span>
                </div>
            }
        </div>

        <!-- Калькулятор -->
        <div class="pd-card pd-card-full">
            <p class="pd-card-title">Калькулятор порции</p>
            <div class="pd-calc-row">
                <input type="number" class="pd-calc-input" id="calcAmt" value="100" min="1" max="9999"/>
                <span class="pd-calc-unit">@Model.Unit</span>
            </div>
            <div class="pd-calc-result" id="calcResult"></div>
        </div>

        <!-- Рецепты с этим продуктом -->
        <div class="pd-card pd-card-full">
            <p class="pd-card-title">Рецепты с этим продуктом</p>
            @if (relatedRecipes.Count > 0)
            {
                <div class="pd-recipes-grid">
                    @foreach (var r in relatedRecipes)
                    {
                        <a href="/Recipe/Details/@r.Id" class="pd-rc">
                            <div class="pd-rc-thumb">
                                @if (!string.IsNullOrEmpty(r.ImageUrl))
                                {
                                    <img src="@r.ImageUrl" alt="@r.Name"/>
                                }
                                else { <span>🥘</span> }
                            </div>
                            <div class="pd-rc-body">
                                <div class="pd-rc-name">@r.Name</div>
                                <div class="pd-rc-meta">
                                    @r.DefaultServings порц.
                                    @if (r.CaloriesPerServing > 0)
                                    {
                                        <span> · @Math.Round(r.CaloriesPerServing, 0) ккал</span>
                                    }
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="pd-empty">Продукт пока не используется ни в одном рецепте</div>
            }
        </div>

    </div>
</div>

<div class="modal fade" id="editProductModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="editModalBody"></div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script>
    const PRICE   = @Model.PricePerUnit.ToString(System.Globalization.CultureInfo.InvariantCulture);
    const KCAL    = @((Model.CaloriesPer100 ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture));
    const PROTEIN = @((Model.ProteinPer100 ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture));
    const FAT     = @((Model.FatPer100 ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture));
    const CARBS   = @((Model.CarbsPer100 ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture));

function calcUpdate() {
    const amt  = parseFloat(document.getElementById('calcAmt').value) || 0;
    const k    = amt / 100;
    const cost = (PRICE * amt / 100).toFixed(2);
    document.getElementById('calcResult').innerHTML = `
        <div class="pd-calc-chip">Стоимость: <b>${cost} ₽</b></div>
        <div class="pd-calc-chip">Калории: <b>${(KCAL * k).toFixed(0)} ккал</b></div>
        <div class="pd-calc-chip">Белки: <b>${(PROTEIN * k).toFixed(1)} г</b></div>
        <div class="pd-calc-chip">Жиры: <b>${(FAT * k).toFixed(1)} г</b></div>
        <div class="pd-calc-chip">Углеводы: <b>${(CARBS * k).toFixed(1)} г</b></div>
    `;
}
document.getElementById('calcAmt').addEventListener('input', calcUpdate);
calcUpdate();

// Редактирование — грузим контент когда Bootstrap открывает модалку
    $(document).on('click', '.edit-product-btn', function () {
        const id = $(this).data('id');
        $('#editModalBody').html('<div class="text-center py-5"><div class="spinner-border text-success" role="status"></div></div>');
        $.get('/Product/EditModal?id=' + id, function (data) {
            $('#editModalBody').html(data);
        }).fail(function () {
            $('#editModalBody').html('<div class="alert alert-danger m-3">Ошибка загрузки.</div>');
        });
    });

// Сабмит формы редактирования
    $(document).on('submit', '#editProductForm', function (e) {
        e.preventDefault();
        $.ajax({
            url: '/Product/EditModal',  // явно указываем URL
            type: 'POST',
            data: new FormData(this),
            processData: false,
            contentType: false,
            success: function (r) {
                if (r.success) {
                    bootstrap.Modal.getInstance(document.getElementById('editProductModal')).hide();
                    location.reload();
                } else {
                    $('#editModalBody').html(r);
                }
            },
            error: function () { alert('Ошибка при сохранении.'); }
        });
    });

// Удаление — берём токен из мета-тега (надёжнее)
$(document).on('click', '.btn-delete-product', function () {
    if (!confirm('Удалить продукт «' + $(this).data('name') + '»?')) return;
    const token = $('input[name="__RequestVerificationToken"]').val();
    $.post('/Product/Delete',
        { id: $(this).data('id'), __RequestVerificationToken: token },
        function (r) {
            if (r.success) window.location.href = '/Product';
            else alert(r.message || 'Ошибка.');
        }
    ).fail(function () { alert('Ошибка при удалении.'); });
});
</script>
}