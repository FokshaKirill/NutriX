@model IEnumerable<Presentation.Models.ProductViewModel>
@*
    Product/Index.cshtml
    JS вынесен в wwwroot/js/product-index.js.
    URL для AJAX передаются через window.ProductIndex (data bridge ниже).
*@

@* ── Data bridge ───────────────────────────────────────────────────────────── *@
<script>
    window.ProductIndex = {
        createModalUrl:         '@Url.Action("CreateModal", "Product")',
        createCategoryModalUrl: '@Url.Action("CreateCategoryModal", "Product")'
    };
</script>

<div class="container py-5">
    <div class="row">

        @* ── Левая колонка: Фильтры ──────────────────────────────────────────── *@
        <div class="col-lg-3 mb-5">
            <div class="card p-4" style="background: var(--primary-light);">
                <h4 class="mb-4" style="color: var(--primary);">Фильтры</h4>

                <form asp-action="Index" method="get">
                    <div class="mb-4">
                        <label class="form-label fw-medium">Категория</label>
                        <select name="category" class="form-select form-select-lg">
                            <option value="">Все категории</option>
                            @foreach (var cat in ViewBag.Categories)
                            {
                                <option value="@cat.Value"
                                        selected="@(ViewBag.SelectedCategory?.ToString() == cat.Value ? "selected" : null)">
                                    @cat.Text
                                </option>
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-medium">Калорийность (на 100г)</label>
                        <input type="range" name="maxCalories" class="form-range"
                               min="0" max="900" value="@ViewBag.MaxCalories" id="caloriesRange" />
                        <div class="d-flex justify-content-between text-muted small">
                            <span>0 ккал</span>
                            <span id="caloriesValue">@ViewBag.MaxCalories+ ккал</span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-medium">Цена за единицу</label>
                        <input type="number" name="minPrice" class="form-control form-control-lg"
                               placeholder="От" value="@ViewBag.MinPrice" />
                        <input type="number" name="maxPrice" class="form-control form-control-lg mt-2"
                               placeholder="До" value="@ViewBag.MaxPrice" />
                    </div>

                    <button type="submit" class="btn btn-success w-100 btn-lg">Применить</button>
                    <a asp-action="Index" class="btn btn-outline-primary w-100 mt-2">Сбросить</a>
                </form>
            </div>
        </div>

        @* ── Правая колонка: Поиск + продукты ───────────────────────────────── *@
        <div class="col-lg-9">

            <div class="d-flex align-items-center mb-4">
                <div class="flex-grow-1 me-2">
                    <form asp-action="Index" method="get" class="d-flex">
                        <input type="search" name="searchTerm" value="@ViewBag.SearchTerm"
                               class="form-control form-control-lg me-2"
                               placeholder="Поиск продуктов..." aria-label="Search" />
                        <button type="submit" class="btn btn-outline-success">Найти</button>
                    </form>
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <div class="text-end" style="margin-right: 4px;">
                        <button type="button" class="btn btn-success btn-lg"
                                data-bs-toggle="modal" data-bs-target="#createProductModal">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                    <div class="text-end">
                        <a asp-action="Parser" asp-controller="Admin">
                            <button class="btn btn-success btn-lg">Импорт</button>
                        </a>
                    </div>
                }
            </div>

            @if (ViewBag.TotalCount > 0)
            {
                <div class="mb-3">
                    <small class="text-muted">
                        Показано @Model.Count() из @ViewBag.TotalCount продуктов
                        (страница @ViewBag.CurrentPage из @ViewBag.TotalPages)
                    </small>
                </div>
            }

            <div class="row g-5">
                @foreach (var product in Model)
                {
                    @await Html.PartialAsync("_ProductCard", product)
                }
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <p class="text-muted" style="font-size: 1rem;">Продукты не найдены...</p>
                    <button type="button" class="btn btn-success btn-lg"
                            data-bs-toggle="modal" data-bs-target="#createProductModal">
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
            }
        </div>

        @* ── Пагинация ───────────────────────────────────────────────────────── *@
        @if (ViewBag.TotalPages > 1)
        {
            <nav aria-label="Пагинация продуктов" class="mt-5">
                <ul class="pagination justify-content-center">

                    @if (ViewBag.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(ViewBag.CurrentPage - 1)"
                               asp-route-searchTerm="@ViewBag.SearchTerm"
                               asp-route-categoryId="@ViewBag.SelectedCategoryId"
                               asp-route-maxCalories="@ViewBag.MaxCalories"
                               asp-route-minPrice="@ViewBag.MinPrice"
                               asp-route-maxPrice="@ViewBag.MaxPrice">&lt;</a>
                        </li>
                    }

                    @for (int i = Math.Max(1, ViewBag.CurrentPage - 9);
                          i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 9); i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-searchTerm="@ViewBag.SearchTerm"
                               asp-route-categoryId="@ViewBag.SelectedCategoryId"
                               asp-route-maxCalories="@ViewBag.MaxCalories"
                               asp-route-minPrice="@ViewBag.MinPrice"
                               asp-route-maxPrice="@ViewBag.MaxPrice">@i</a>
                        </li>
                    }

                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(ViewBag.CurrentPage + 1)"
                               asp-route-searchTerm="@ViewBag.SearchTerm"
                               asp-route-categoryId="@ViewBag.SelectedCategoryId"
                               asp-route-maxCalories="@ViewBag.MaxCalories"
                               asp-route-minPrice="@ViewBag.MinPrice"
                               asp-route-maxPrice="@ViewBag.MaxPrice">&gt;</a>
                        </li>
                    }

                </ul>
            </nav>
        }
    </div>
</div>

@* ── Модальное окно создания продукта ────────────────────────────────────────── *@
<div class="modal fade" id="createProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="overflow: hidden;">
            <div class="modal-header" style="background: var(--primary-light);">
                <h5 class="modal-title" style="color: var(--primary);">Новый продукт</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div id="createModalBody">
                <div class="text-center py-5">
                    <div class="spinner-border text-success" role="status"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/product-index.js" asp-append-version="true"></script>
}
