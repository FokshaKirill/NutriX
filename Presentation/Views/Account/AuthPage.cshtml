@{
  Layout = null; 
}

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>NutriX</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <link href="~/css/authpage.css" rel="stylesheet" asp-append-version="true">
</head>
<body>

<div class="panel-form">
  <div class="big-logo">
    <a asp-action="Index" asp-controller="Home">
      <div class="big-logo-name">NutriX</div>
    </a>
    <div class="big-logo-sub">Кулинарный помощник на основе ИИ</div>
  </div>

  <div class="form-head">
    <h2 id="panel-title">С возвращением</h2>
    <p id="panel-subtitle">Войдите в аккаунт, чтобы продолжить</p>
  </div>

  <div class="tabs">
    <button class="tab-btn active" onclick="switchTab('login')">Вход</button>
    <button class="tab-btn" onclick="switchTab('register')">Регистрация</button>
  </div>

  <div id="panel-login" class="form-panel active">
    <div class="field"><label>Email</label><input type="email" id="login-email" placeholder="вы@example.com"/></div>
    <div class="field"><label>Пароль</label><input type="password" id="login-pass" placeholder="••••••••"/></div>
    <button class="btn-primary" id="btn-login">Войти</button>
    <div class="divider">или</div>
    <button class="btn-google" id="btn-google-login">
      <svg width="17" height="17" viewBox="0 0 18 18"><path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"/><path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"/><path fill="#FBBC05" d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z"/><path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/></svg>
      Войти через Google
    </button>
    <div id="login-msg" class="alert alert-success"></div>
    <div id="login-err" class="alert alert-error"></div>
  </div>

  <div id="panel-register" class="form-panel">
    <div class="field"><label>Имя пользователя</label><input type="text" id="reg-username" placeholder="chef_ivan"/></div>
    <div class="field"><label>Email</label><input type="email" id="reg-email" placeholder="вы@example.com"/></div>
    <div class="field"><label>Пароль</label><input type="password" id="reg-pass" placeholder="Минимум 6 символов"/></div>
    <button class="btn-primary" id="btn-register">Создать аккаунт</button>
    <div class="divider">или</div>
    <button class="btn-google" id="btn-google-reg">
      <svg width="17" height="17" viewBox="0 0 18 18"><path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"/><path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"/><path fill="#FBBC05" d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z"/><path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/></svg>
      Зарегистрироваться через Google
    </button>
    <div id="reg-msg" class="alert alert-success"></div>
    <div id="reg-err" class="alert alert-error"></div>
  </div>

  <div class="form-footer">Используя сервис, вы соглашаетесь с условиями использования и политикой конфиденциальности.</div>
</div>

<div class="panel-visual">
  <canvas id="rays"></canvas>
  <div class="visual-bg"></div>
    <img src="~/images/logooo.png" alt="background" class="visual-bg-img">
  <div class="visual-overlay">
    <span class="visual-tag">Кулинарный ИИ-помощник</span>
    <h2 class="visual-headline">Готовьте<br>с <em>вдохновением</em></h2>
    <p class="visual-desc">Персональные рецепты, советы шеф-повара и умное планирование меню — всё в одном месте.</p>
  </div>
</div>
</body>

<script src="~/js/auth.js" asp-append-version="true"></script>

</html>