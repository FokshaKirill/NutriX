@using System.Security.Claims
@using Domain.Entities
@model dynamic
@{
    ViewData["Title"] = "Аккаунт";

    var favorites  = ViewBag.Favorites as IEnumerable<Recipe> ?? Enumerable.Empty<Recipe>();
    var user       = ViewBag.CurrentUser as Domain.Entities.User;
    var userName   = user?.Username ?? User.Identity?.Name ?? "Пользователь";
    var userEmail  = user?.Email ?? User.FindFirst(ClaimTypes.Email)?.Value ?? "";
    var avatarUrl  = user?.AvatarUrl;
    var initials   = string.IsNullOrEmpty(userName)
                        ? "?"
                        : string.Concat(userName.Split(' ').Take(2).Select(w => w[0].ToString().ToUpper()));
    var isPro      = user?.SubscriptionType == Domain.Enums.SubscriptionType.Premium;
    var createdAt  = user?.CreatedAt.ToLocalTime().ToString("dd MMM yyyy") ?? "";
    var lastLogin  = user?.LastLoginAt != null
                        ? user.LastLoginAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                        : "сегодня";

    var calGoal    = (double)(user?.DailyCalorieGoal ?? 2000);
    var protGoal   = (double)(user?.DailyProteinGoal ?? 120);
    var fatGoal    = (double)(user?.DailyFatGoal     ?? 70);
    var carbGoal   = (double)(user?.DailyCarbsGoal   ?? 250);
        
    var kbzuViewData = new ViewDataDictionary(ViewData);
    kbzuViewData["calGoal"]   = calGoal.ToString("F0", System.Globalization.CultureInfo.InvariantCulture);
    kbzuViewData["protGoal"]  = protGoal.ToString("F0", System.Globalization.CultureInfo.InvariantCulture);
    kbzuViewData["fatGoal"]   = fatGoal.ToString("F0", System.Globalization.CultureInfo.InvariantCulture);
    kbzuViewData["carbGoal"]  = carbGoal.ToString("F0", System.Globalization.CultureInfo.InvariantCulture);
    kbzuViewData["todayKcal"] = (int)ViewBag.TodayKcal;
    kbzuViewData["todayP"]    = (int)ViewBag.TodayP;
    kbzuViewData["todayF"]    = (int)ViewBag.TodayF;
    kbzuViewData["todayC"]    = (int)ViewBag.TodayC;

    var myRecipes  = ViewBag.MyRecipes as IEnumerable<Domain.Entities.Recipe>
                    ?? Enumerable.Empty<Domain.Entities.Recipe>();
}

@Html.AntiForgeryToken()

@* ── Шрифты ────────────────────────────────────────────────────────────────── *@
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>

@* ── Data bridge ───────────────────────────────────────────────────────────── *@
<script>
    window.AccountData = {
        goals: {
            kcal: @calGoal.ToString("F0", System.Globalization.CultureInfo.InvariantCulture),
            p:    @protGoal.ToString("F0", System.Globalization.CultureInfo.InvariantCulture),
            f:    @fatGoal.ToString("F0", System.Globalization.CultureInfo.InvariantCulture),
            c:    @carbGoal.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)
        },
        today: {
            kcal: @((int)ViewBag.TodayKcal),
            p:    @((int)ViewBag.TodayP),
            f:    @((int)ViewBag.TodayF),
            c:    @((int)ViewBag.TodayC)
        }
    };
</script>

<div class="acc-wrap">
    <div class="f-row">
        <div class="bookmark-left"></div>
        @* ── HEADER ─────────────────────────────────────────────────────────────── *@
        <div class="acc-header">
            <div class="avatar-wrap">
                @if (!string.IsNullOrEmpty(avatarUrl))
                {
                    <img src="@avatarUrl" alt="@userName" class="avatar-img"/>
                }
                else
                {
                    <div class="avatar">@initials</div>
                }
            </div>
            <div class="acc-info">
                <h2>@userName</h2>
                <p>@userEmail</p>
                <div class="badges-row">
                    <span class="badge @(isPro ? "badge-pro" : "badge-free")">@(isPro ? "Pro" : "Free")</span>
                    @if (user?.IsGoogleUser == true)
                    {
                        <span class="badge badge-google">
                            <svg width="11" height="11" viewBox="0 0 18 18">
                                <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z"/>
                                <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"/>
                                <path fill="#FBBC05" d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z"/>
                                <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/>
                            </svg>
                            Google
                        </span>
                    }
                    <span class="meta-text">Вход: @lastLogin</span>
                </div>
            </div>
            <button class="btn-logout" onclick="logout()">Выйти</button>
        </div>
        <div class="bookmark-right"></div>
    </div>

    @* ── GRID: цели + статистика ─────────────────────────────────────────────── *@
    <div class="acc-grid">
        @* ── КБЖУ на сегодня ─────────────────────────────────────────────────────── *@
        @await Html.PartialAsync("_AccountKbzu", kbzuViewData)

        <div class="acc-card">
            <p class="card-label">Статистика</p>
            <div class="stat-row"><span class="stat-label">Мои рецепты</span><span class="stat-val">@(user?.Recipes.Count ?? 0)</span></div>
            <div class="stat-row"><span class="stat-label">Избранных</span><span class="stat-val">@favorites.Count()</span></div>
            <div class="stat-row"><span class="stat-label">Планов питания</span><span class="stat-val">@(user?.MealPlans.Count ?? 0)</span></div>
            <div class="stat-row"><span class="stat-label">Подписка</span><span class="stat-val text-green">@(isPro ? "Pro" : "Free")</span></div>
            <div class="stat-row"><span class="stat-label">Регистрация</span><span class="stat-val">@createdAt</span></div>
            <div class="stat-row"><span class="stat-label">Email подтверждён</span><span class="stat-val">@(user?.IsEmailConfirmed == true ? "✓ Да" : "Нет")</span></div>
        </div>

        <div class="acc-card">
            <p class="card-label">Достижения</p>
            <div class="achieve-empty" style="padding:15%">
                <div style="font-size:1.5rem;margin-bottom:.5rem"><i class="fa fa-trophy" aria-hidden="true"></i></div>
                <p>Достижений пока нет</p>
            </div>
        </div>
    </div>

    @* ── ИЗБРАННЫЕ ───────────────────────────────────────────────────────────── *@
    <div class="fav-section">
        <div class="fav-header">
            <p class="card-label" style="margin:0">Избранные рецепты</p>
            <span class="fav-count-badge">@favorites.Count()</span>
        </div>

        @if (!favorites.Any())
        {
            <div class="fav-empty">
                <div style="font-size:2rem;margin-bottom:.5rem">♡</div>
                <p>Пока ничего нет. <a asp-action="Index" asp-controller="Recipe">Найти рецепты</a></p>
            </div>
        }
        else
        {
            <div class="fav-scroll">
                @foreach (var recipe in favorites)
                {
                    @await Html.PartialAsync("_FavRecipeCard", recipe)
                }
            </div>
        }
    </div>

    @* ── МОИ РЕЦЕПТЫ ─────────────────────────────────────────────────────────── *@
    <div class="fav-section">
        <div class="fav-header">
            <p class="card-label" style="margin:0">Мои рецепты</p>
            <span class="fav-count-badge">@myRecipes.Count()</span>
        </div>

        @if (!myRecipes.Any())
        {
            <div class="fav-empty">
                <div style="font-size:2rem;margin-bottom:.5rem">🍳</div>
                <p>
                    Ещё нет рецептов.
                    <a asp-action="Create" asp-controller="Recipe">Создать</a> или
                    <a asp-action="Import" asp-controller="Recipe">Импортировать</a>
                </p>
            </div>
        }
        else
        {
            <div class="fav-scroll">
                @foreach (var recipe in myRecipes.OrderByDescending(r => r.CreatedAt))
                {
                    @await Html.PartialAsync("_MyRecipeCard", recipe)
                }
            </div>
        }
    </div>

    @* ── ADMIN ────────────────────────────────────────────────────────────────── *@
    <div class="admin-activate-section @(User.IsInRole("Admin") ? "is-admin" : "")">
        @if (User.IsInRole("Admin"))
        {
            <div class="admin-badge-row">
                <div class="admin-crown">👑</div>
                <div>
                    <div class="admin-badge-title">Вы — Администратор</div>
                    <div class="admin-badge-sub">Доступ к панели управления открыт</div>
                </div>
                <a asp-action="Parser" asp-controller="Admin" class="btn-admin-panel">Панель →</a>
            </div>
        }
        else
        {
            <div class="admin-activate-inner">
                <div class="admin-lock-icon">🔑</div>
                <div class="admin-activate-text">
                    <div class="admin-activate-title">Активация расширенного доступа</div>
                    <div class="admin-activate-sub">Введите секретный код администратора</div>
                </div>
                <div class="admin-activate-form">
                    <input type="password" id="adminSecretInput" placeholder="Секретный код"
                           autocomplete="off" maxlength="64"/>
                    <button id="adminActivateBtn" onclick="activateAdmin()">Активировать</button>
                </div>
                <div id="adminActivateMsg" class="admin-activate-msg" style="display:none"></div>
            </div>
        }
    </div>

</div>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true"></script>
    <script src="~/js/account.js" asp-append-version="true"></script>
}

<style>
    .streak-card {
        display: none;
    }
</style>