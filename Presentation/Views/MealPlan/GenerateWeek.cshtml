@model Presentation.Models.GenerateWeekViewModel

@{
    ViewData["Title"] = "Генерация меню";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=DM+Sans:wght@300;400;500;600&display=swap');
</style>

<div class="gw-page">
    <div class="gw-inner">

        <div class="gw-hero">
            <div class="gw-hero-badge"><span>✦</span> Умная генерация</div>
            <h1>Меню на неделю</h1>
            <p>Сбалансированный план питания под ваши цели, вкусы и бюджет</p>
        </div>

        <form asp-action="GenerateWeek" method="post" id="generateForm">
            @Html.AntiForgeryToken()

            <!-- ── 1. Цель ── -->
            <div class="gw-card">
                <div class="gw-card-head">
                    <div class="gw-card-icon icon-green">🎯</div>
                    <div><h3>Цель питания</h3><p>Под какую задачу строить рацион?</p></div>
                </div>
                <div class="gw-card-body">
                    <div class="gw-goal-grid">
                        @foreach (var (val, icon, name, sub) in new[]
                                  {
                                      ("maintain",  "⚖️", "Поддержание",       "Стабильный вес"),
                                      ("lose",      "📉", "Похудение",         "−400 ккал/день"),
                                      ("lose_fast", "🔥", "Быстрое похудение", "−700 ккал"),
                                      ("gain",      "💪", "Набор массы",       "+400 ккал/день"),
                                      ("gain_lean", "🌿", "Сухая масса",       "+200 ккал")
                                  })
                        {
                            <div>
                                <input type="radio" asp-for="Goal" value="@val"
                                       class="gw-goal-option" id="goal_@val" />
                                <label class="gw-goal-label" for="goal_@val">
                                    <span class="gl-icon">@icon</span>
                                    <span class="gl-name">@name</span>
                                    <span class="gl-sub">@sub</span>
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
            
            <!-- ── Параметры тела ── -->
            <div class="gw-card">
                <div class="gw-card-head">
                    <div class="gw-card-icon icon-teal">🧮</div>
                    <div><h3>Параметры тела <span style="font-weight:400;color:var(--muted)">(для авторасчёта ккал)</span></h3>
                         <p>Заполните — калории рассчитаются автоматически</p></div>
                </div>
                <div class="gw-card-body">
                    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:.8rem;margin-bottom:1rem">
                        <div>
                            <label class="gw-label">Вес</label>
                            <div class="gw-macro-input-wrap">
                                <input asp-for="WeightKg" type="number" class="gw-input" placeholder="70" min="30" max="250" step="0.5" style="padding-right:2.5rem" id="bodyWeight"/>
                                <span class="gw-macro-unit">кг</span>
                            </div>
                        </div>
                        <div>
                            <label class="gw-label">Рост</label>
                            <div class="gw-macro-input-wrap">
                                <input asp-for="HeightCm" type="number" class="gw-input" placeholder="175" min="100" max="250" id="bodyHeight" style="padding-right:2.5rem"/>
                                <span class="gw-macro-unit">см</span>
                            </div>
                        </div>
                        <div>
                            <label class="gw-label">Возраст</label>
                            <div class="gw-macro-input-wrap">
                                <input asp-for="Age" type="number" class="gw-input" placeholder="30" min="10" max="100" id="bodyAge" style="padding-right:2.8rem"/>
                                <span class="gw-macro-unit">лет</span>
                            </div>
                        </div>
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:.8rem">
                        <div>
                            <label class="gw-label">Пол</label>
                            <select asp-for="Gender" class="gw-select" id="bodyGender">
                                <option value="">— выберите —</option>
                                <option value="male">Мужской</option>
                                <option value="female">Женский</option>
                            </select>
                        </div>
                        <div>
                            <label class="gw-label">Активность</label>
                            <select asp-for="ActivityLevel" class="gw-select" id="bodyActivity">
                                <option value="">— выберите —</option>
                                <option value="sedentary">Сидячий образ жизни</option>
                                <option value="light">Лёгкая активность (1-3 дня/нед)</option>
                                <option value="moderate">Умеренная (3-5 дней/нед)</option>
                                <option value="active">Высокая (6-7 дней/нед)</option>
                                <option value="veryactive">Очень высокая (спортсмены)</option>
                            </select>
                        </div>
                    </div>
                    <div id="calcResult" style="display:none;margin-top:1rem;background:var(--sage-light);border-radius:10px;padding:.8rem 1rem;font-size:.88rem;color:var(--brown)">
                        <strong id="calcResultText"></strong>
                        <button type="button" onclick="applyCalcResult()" 
                                style="margin-left:1rem;background:var(--sage);color:#fff;border:none;border-radius:6px;padding:.25rem .7rem;font-size:.8rem;cursor:pointer">
                            Применить
                        </button>
                    </div>
                </div>
            </div>

            <!-- ── 2. Калории ── -->
            <div class="gw-card">
                <div class="gw-card-head">
                    <div class="gw-card-icon icon-brown">🔥</div>
                    <div><h3>Калории в день</h3><p>Базовая суточная потребность</p></div>
                </div>
                <div class="gw-card-body">
                    <div class="kcal-display">
                        <div>
                            <span class="kcal-value" id="kcalDisplay">2000</span>
                            <span class="kcal-unit"> ккал</span>
                        </div>
                        <div class="kcal-adjusted" id="kcalAdjusted"></div>
                    </div>
                    <input type="range" class="gw-slider" asp-for="DailyCalories"
                           min="1000" max="4500" step="50" id="kcalSlider" />
                    <div class="kcal-marks">
                        <span>1000</span><span>1500</span><span>2000</span><span>2500</span>
                        <span>3000</span><span>3500</span><span>4000</span><span>4500</span>
                    </div>
                    <span asp-validation-for="DailyCalories" class="text-danger"></span>

                    <div class="gw-preview" id="kcalPreview" style="margin-top:1rem;">
                        <div class="gw-preview-item">🌅 Завтрак: <strong id="pvBreakfast">500</strong> ккал</div>
                        <div class="gw-preview-item">☀️ Обед: <strong id="pvLunch">700</strong> ккал</div>
                        <div class="gw-preview-item">🌙 Ужин: <strong id="pvDinner">600</strong> ккал</div>
                        <div class="gw-preview-item" data-snack>🍎 Перекус: <strong id="pvSnack">200</strong> ккал</div>
                    </div>
                </div>
            </div>

            <!-- ── 3. Макронутриенты ── -->
            <div class="gw-card">
                <div class="gw-card-head">
                    <div class="gw-card-icon icon-blue">📊</div>
                    <div>
                        <h3>Макронутриенты <span style="font-weight:400;color:var(--muted)">(необязательно)</span></h3>
                        <p>Целевые значения белков, жиров, углеводов в день</p>
                    </div>
                </div>
                <div class="gw-card-body">
                    <div class="gw-macro-grid">
                        <div>
                            <label class="gw-label">Белки</label>
                            <div class="gw-macro-input-wrap">
                                <input asp-for="ProteinGoal" type="number" class="gw-input"
                                       placeholder="120" min="0" max="500" style="padding-right:2.5rem" />
                                <span class="gw-macro-unit">г</span>
                            </div>
                            <span class="gw-macro-color" style="background:#4caf89"></span>
                            <span asp-validation-for="ProteinGoal" class="text-danger"></span>
                        </div>
                        <div>
                            <label class="gw-label">Жиры</label>
                            <div class="gw-macro-input-wrap">
                                <input asp-for="FatGoal" type="number" class="gw-input"
                                       placeholder="65" min="0" max="300" style="padding-right:2.5rem" />
                                <span class="gw-macro-unit">г</span>
                            </div>
                            <span class="gw-macro-color" style="background:#e8a03e"></span>
                            <span asp-validation-for="FatGoal" class="text-danger"></span>
                        </div>
                        <div>
                            <label class="gw-label">Углеводы</label>
                            <div class="gw-macro-input-wrap">
                                <input asp-for="CarbsGoal" type="number" class="gw-input"
                                       placeholder="250" min="0" max="700" style="padding-right:2.5rem" />
                                <span class="gw-macro-unit">г</span>
                            </div>
                            <span class="gw-macro-color" style="background:#5b8dd9"></span>
                            <span asp-validation-for="CarbsGoal" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── 4. Диетические предпочтения ── -->
            <div class="gw-card">
                <div class="gw-card-head">
                    <div class="gw-card-icon icon-purple">🥦</div>
                    <div><h3>Диетические предпочтения</h3><p>Выберите одно или несколько</p></div>
                </div>
                <div class="gw-card-body">
                    <div class="gw-diet-grid">
                        <div>
                            <input asp-for="Vegetarian" type="checkbox" id="chkVeg" class="gw-diet-chk" />
                            <label class="gw-diet-btn" for="chkVeg">🌿 Вегетарианское</label>
                        </div>
                        <div>
                            <input asp-for="Vegan" type="checkbox" id="chkVegan" class="gw-diet-chk" />
                            <label class="gw-diet-btn" for="chkVegan">🌱 Веганское</label>
                        </div>
                        <div>
                            <input asp-for="GlutenFree" type="checkbox" id="chkGF" class="gw-diet-chk" />
                            <label class="gw-diet-btn" for="chkGF">🌾 Без глютена</label>
                        </div>
                        <div>
                            <input asp-for="LowCarb" type="checkbox" id="chkLC" class="gw-diet-chk" />
                            <label class="gw-diet-btn" for="chkLC">📉 Мало углеводов</label>
                        </div>
                        <div>
                            <input asp-for="HighProtein" type="checkbox" id="chkHP" class="gw-diet-chk" />
                            <label class="gw-diet-btn" for="chkHP">💪 Высокий белок</label>
                        </div>
                        <div>
                            <input asp-for="LowFat" type="checkbox" id="chkLF" class="gw-diet-chk" />
                            <label class="gw-diet-btn" for="chkLF">🫗 Мало жиров</label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── 5. Исключить продукты ── -->
            <div class="gw-card">
                <div class="gw-card-head">
                    <div class="gw-card-icon icon-red">🚫</div>
                    <div><h3>Исключить продукты</h3><p>Аллергены, нелюбимые ингредиенты</p></div>
                </div>
                <div class="gw-card-body">
                    <div class="tag-field-wrap" id="tagWrap">
                        <input id="tagInput" type="text"
                               placeholder="Введите продукт и нажмите Enter…"
                               autocomplete="off" />
                    </div>
                    <input type="hidden" asp-for="ExcludedProducts" id="excludedHidden" />
                    <p style="font-size:.78rem;color:var(--muted);margin:.5rem 0 0">
                        Быстрые варианты:
                        @foreach (var q in new[] { "молоко", "орехи", "рыба", "яйца", "глютен", "сахар" })
                        {
                            <button type="button" class="quick-tag" onclick="addTag('@q')"
                                    style="background:none;border:1px solid var(--border);border-radius:5px;padding:.15rem .5rem;font-size:.78rem;cursor:pointer;margin:.1rem;color:var(--muted)">
                                @q
                            </button>
                        }
                    </p>
                </div>
            </div>

            <!-- ── 6. Бюджет ── -->
            <div class="gw-card">
                <div class="gw-card-head">
                    <div class="gw-card-icon icon-teal">💰</div>
                    <div><h3>Бюджет на неделю</h3><p>Учитывать стоимость рецептов при подборе</p></div>
                </div>
                <div class="gw-card-body">
                    <div class="gw-budget-toggle">
                        <label class="gw-switch">
                            <input asp-for="ConsiderBudget" type="checkbox" id="budgetToggle" />
                            <span class="gw-switch-slider"></span>
                        </label>
                        <span style="font-size:.92rem;color:var(--brown-lt)">Учитывать бюджет</span>
                    </div>
                    <div id="budgetDetails" class="@(Model.ConsiderBudget ? "" : "hidden")">
                        <label class="gw-label">Бюджет на неделю</label>
                        <div class="gw-macro-input-wrap" style="max-width:280px">
                            <input asp-for="WeeklyBudget" type="number" class="gw-input"
                                   min="500" max="50000" step="100" style="padding-right:2.8rem" />
                            <span class="gw-macro-unit">₽</span>
                        </div>
                        <p style="font-size:.8rem;color:var(--muted);margin:.4rem 0 0">
                            ≈ <span id="dailyBudgetPreview">500</span> ₽/день
                        </p>
                    </div>
                </div>
            </div>

            <!-- ── 7. Настройки плана ── -->
            <div class="gw-card">
                <div class="gw-card-head">
                    <div class="gw-card-icon icon-blue">⚙️</div>
                    <div><h3>Настройки плана</h3><p>Количество приёмов пищи и повторы</p></div>
                </div>
                <div class="gw-card-body">
                    <div class="gw-goal-grid" style="grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));">
                        @foreach (var (val, icon, name, sub) in new[]
                                  {
                                      (2, "🌙", "2 приёма",   "Завтрак · Ужин"),
                                      (3, "🍽", "3 приёма",   "Завтрак · Обед · Ужин"),
                                      (4, "🥗", "4 приёма",   "Завтрак · Перекус · Обед · Ужин"),
                                      (5, "⚡", "5 приёмов",  "Завтрак · 2 перекуса · Обед · Ужин"),
                                      (6, "📋", "6 приёмов",  "Дробное питание"),
                                      (7, "🏋", "7 приёмов",  "Максимальная дробность"),
                                  })
                        {
                            <div>
                                <input type="radio" asp-for="MealsPerDay" value="@val"
                                       class="gw-goal-option" id="meals_@val" />
                                <label class="gw-goal-label" for="meals_@val">
                                    <span class="gl-icon">@icon</span>
                                    <span class="gl-name">@name</span>
                                    <span class="gl-sub" style="font-size:.7rem">@sub</span>
                                </label>
                            </div>
                        }
                    </div>
                    <input type="hidden" asp-for="IncludeSnacks" value="false" />
                    <div style="margin-top:1rem;display:flex;align-items:center;gap:.7rem">
                        <label class="gw-switch">
                            <input asp-for="IncludeDrinks" type="checkbox" id="drinksToggle" />
                            <span class="gw-switch-slider"></span>
                        </label>
                        <span style="font-size:.92rem;color:var(--brown-lt)">Добавлять напитки к приёмам пищи</span>
                    </div>
                </div>
            </div>

            <!-- Validation summary -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div style="background:#fde8e8;border-radius:10px;padding:1rem 1.2rem;margin-bottom:1rem;color:#a33">
                    <div asp-validation-summary="ModelOnly"></div>
                </div>
            }

            <!-- Submit -->
            <div class="gw-card">
                <div class="gw-submit-wrap">
                    <button type="submit" class="gw-btn-generate" id="submitBtn">
                        <span class="btn-icon">✦</span>
                        <span class="btn-spinner">⏳</span>
                        Сгенерировать меню
                    </button>
                    <p style="margin:.8rem 0 0;font-size:.8rem;color:var(--muted)">
                        Генерация занимает несколько секунд
                    </p>
                </div>
            </div>

        </form>
    </div>
</div>

@section Scripts {
<script>
// ── Калорийный слайдер ──────────────────────────────────────────────────────
const slider   = document.getElementById('kcalSlider');
const display  = document.getElementById('kcalDisplay');
const adjusted = document.getElementById('kcalAdjusted');
const pvBreak  = document.getElementById('pvBreakfast');
const pvLunch  = document.getElementById('pvLunch');
const pvDinner = document.getElementById('pvDinner');
const pvSnack  = document.getElementById('pvSnack');

const goalDeltas = { maintain: 0, lose: -400, lose_fast: -700, gain: 400, gain_lean: 200 };

function goalAdjust(base) {
    const g = document.querySelector('.gw-goal-option:checked')?.value ?? 'maintain';
    return base + (goalDeltas[g] ?? 0);
}

function updateSlider() {
    const base     = +slider.value;
    const adj      = goalAdjust(base);
    const meals    = +document.querySelector('input[name="MealsPerDay"]:checked')?.value || 3;
    const hasSnack = meals >= 4;

    display.textContent = base.toLocaleString('ru-RU');

    const diff = adj - base;
    adjusted.textContent = diff !== 0
        ? `С учётом цели: ${adj.toLocaleString('ru-RU')} ккал (${diff > 0 ? '+' : ''}${diff})`
        : '';

    if (hasSnack) {
        pvBreak.textContent  = Math.round(adj * 0.25);
        pvLunch.textContent  = Math.round(adj * 0.35);
        pvDinner.textContent = Math.round(adj * 0.30);
        pvSnack.textContent  = Math.round(adj * 0.10);
        document.querySelector('[data-snack]').style.display = '';
    } else {
        pvBreak.textContent  = Math.round(adj * 0.25);
        pvLunch.textContent  = Math.round(adj * 0.40);
        pvDinner.textContent = Math.round(adj * 0.35);
        document.querySelector('[data-snack]').style.display = 'none';
    }
}

slider.addEventListener('input', updateSlider);

document.querySelectorAll('input[name="MealsPerDay"]').forEach(r =>
    r.addEventListener('change', updateSlider));
updateSlider();

// ── Бюджет ──────────────────────────────────────────────────────────────────
const budgetToggle  = document.getElementById('budgetToggle');
const budgetDetails = document.getElementById('budgetDetails');
const weeklyInput   = document.querySelector('[name="WeeklyBudget"]');
const dailyPreview  = document.getElementById('dailyBudgetPreview');

function updateBudgetPreview() {
    dailyPreview.textContent = Math.round(+weeklyInput.value / 7).toLocaleString('ru-RU');
}

budgetToggle.addEventListener('change', () => {
    budgetDetails.classList.toggle('hidden', !budgetToggle.checked);
});
weeklyInput.addEventListener('input', updateBudgetPreview);
updateBudgetPreview();

// ── Тег-инпут для исключений ────────────────────────────────────────────────
// ИСПРАВЛЕНО: при загрузке страницы читаем существующее значение из hidden-поля
// (актуально при возврате формы после ошибки валидации — теги не теряются)
const tagWrap  = document.getElementById('tagWrap');
const tagInput = document.getElementById('tagInput');
const hidden   = document.getElementById('excludedHidden');

let tags = hidden.value
    ? hidden.value.split(',').map(s => s.trim()).filter(Boolean)
    : [];

function renderTags() {
    tagWrap.querySelectorAll('.tag-pill').forEach(p => p.remove());
    tags.forEach(t => {
        const pill = document.createElement('span');
        pill.className = 'tag-pill';
        pill.innerHTML = `${t} <button type="button" onclick="removeTag('${t}')">×</button>`;
        tagWrap.insertBefore(pill, tagInput);
    });
    hidden.value = tags.join(', ');
}

function addTag(val) {
    const v = val.trim().toLowerCase();
    if (v && !tags.includes(v)) { tags.push(v); renderTags(); }
    tagInput.value = '';
    tagInput.focus();
}

function removeTag(t) {
    tags = tags.filter(x => x !== t);
    renderTags();
}

tagInput.addEventListener('keydown', e => {
    if (e.key === 'Enter' || e.key === ',') {
        e.preventDefault();
        addTag(tagInput.value);
    }
    if (e.key === 'Backspace' && !tagInput.value && tags.length)
        removeTag(tags[tags.length - 1]);
});
tagWrap.addEventListener('click', () => tagInput.focus());

// Рендерим начальные теги из модели
renderTags();

// ── Спиннер при отправке формы ──────────────────────────────────────────────
document.getElementById('generateForm').addEventListener('submit', function () {
    const btn = document.getElementById('submitBtn');
    btn.classList.add('loading');
    btn.disabled = true;
});

// ── Калькулятор КБЖУ по параметрам тела ────────────────────────────────────
const bodyFields = ['bodyWeight','bodyHeight','bodyAge','bodyGender','bodyActivity'];
let _calcKcal = 0;

function tryCalcBmr() {
    const w = parseFloat(document.getElementById('bodyWeight')?.value);
    const h = parseFloat(document.getElementById('bodyHeight')?.value);
    const a = parseInt(document.getElementById('bodyAge')?.value);
    const g = document.getElementById('bodyGender')?.value;
    const act = document.getElementById('bodyActivity')?.value;

    if (!w || !h || !a || !g || !act) {
        document.getElementById('calcResult').style.display = 'none';
        return;
    }

    const bmr = 10*w + 6.25*h - 5*a + (g === 'male' ? 5 : -161);
    const actMult = {sedentary:1.2, light:1.375, moderate:1.55, active:1.725, veryactive:1.9};
    const tdee = Math.round(bmr * (actMult[act] || 1));
    _calcKcal = tdee;

    document.getElementById('calcResultText').textContent =
        `Ваша норма: ~${tdee} ккал/день (BMR ${Math.round(bmr)} × коэф. активности)`;
    document.getElementById('calcResult').style.display = 'block';
}

function applyCalcResult() {
    if (!_calcKcal) return;
    slider.value = Math.min(4500, Math.max(1000, _calcKcal));
    updateSlider();
}

bodyFields.forEach(id => {
    document.getElementById(id)?.addEventListener('change', tryCalcBmr);
    document.getElementById(id)?.addEventListener('input', tryCalcBmr);
});
tryCalcBmr(); 
</script>
}
