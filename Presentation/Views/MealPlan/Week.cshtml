@using Presentation.Models
@model Presentation.Models.WeekPlanViewModel
@{
ViewData["Title"] = "План питания";
var totalCost  = Model.ShoppingList.Sum(i => i.TotalPrice);
var weekKcal   = Model.Days.Sum(d => d.Meals.Sum(m => m.Calories));
var weekProt   = Model.Days.Sum(d => d.Meals.Sum(m => m.Protein));
var weekFat    = Model.Days.Sum(d => d.Meals.Sum(m => m.Fat));
var weekCarbs  = Model.Days.Sum(d => d.Meals.Sum(m => m.Carbs));
var avgKcal    = Model.Days.Count > 0 ? weekKcal / Model.Days.Count : 0;
var plan       = Model.Plan;
var hasDiet    = plan != null && (plan.Vegetarian || plan.Vegan || plan.GlutenFree ||
plan.LowCarb || plan.HighProtein || plan.LowFat);
var budgetPct  = plan is { ConsiderBudget: true, WeeklyBudget: > 0 }
? Math.Min((double)totalCost / (double)plan.WeeklyBudget * 100, 100) : 0;
var mealTypeNames = new[] { "Завтрак", "Обед", "Ужин", "Перекус" };
string DayAbbr(DateTime d) => d.ToString("ddd", new System.Globalization.CultureInfo("ru-RU")).ToUpper();
}

<link href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="~/css/print-week.css" asp-append-version="true"/>

<div class="print-only" style="display:none;text-align:center;margin-bottom:20px;font-size:14pt;font-family:'Lora',serif;">
    <strong>План питания на неделю</strong><br>
    <span style="font-size:11pt;color:#555;">
        @Model.StartDate.ToString("dd MMMM yyyy") — @Model.StartDate.AddDays(6).ToString("dd MMMM yyyy")
    </span>
</div>

<div class="wp" style="max-width: -webkit-fill-available">

    @if (TempData["GenerateSuccess"] != null)
    {
    <div style="background:#eef7f0;border:1px solid #a7d9b5;border-radius:9px;padding:.6rem .9rem;
                    margin-bottom:1rem;font-size:.8rem;color:#1e6039;display:flex;gap:.5rem;align-items:center" class="no-print">
        <span>Новый план питания успешно сгенерирован!</span>
    </div>
    }
    
    @if (TempData["BudgetWarning"] != null) { <div class="warning">@TempData["BudgetWarning"]</div> }

    <div class="wp-head no-print">
        <div>
            <h2 class="wp-title">План питания</h2>
            <p class="wp-sub">@Model.StartDate.ToString("d MMMM") — @Model.StartDate.AddDays(6).ToString("d MMMM yyyy")</p>
        </div>
        <div class="wp-actions">
            <button class="btn" onclick="printSection('meal')">Печать меню</button>
            <button class="btn" onclick="printSection('shop')">Печать покупок</button>
            <a asp-controller="MealPlan" asp-action="History" class="btn">История планов</a>
            <a asp-action="GenerateWeek" class="btn primary">Новый план</a>
        </div>
    </div>

    <div class="wp-tabs no-print">
        <button class="wp-tab active" onclick="switchTab('Meal',this)">Меню</button>
        <button class="wp-tab"        onclick="switchTab('Shop',this)">Список покупок</button>
    </div>

    <!-- ══ МЕНЮ ══ -->
    <div class="wp-section active" id="tabMeal">

        <div class="week-stats no-print">
            <div class="ws-card"><div class="ws-label">Ср. ккал/день</div><div class="ws-val">@avgKcal</div></div>
            <div class="ws-card"><div class="ws-label">Белки</div><div class="ws-val">@weekProt г</div></div>
            <div class="ws-card"><div class="ws-label">Жиры</div><div class="ws-val">@weekFat г</div></div>
            <div class="ws-card"><div class="ws-label">Углеводы</div><div class="ws-val">@weekCarbs г</div></div>
            @if (totalCost > 0)
            {
            <div class="ws-card"><div class="ws-label">Стоимость</div><div class="ws-val">@totalCost.ToString("F0") ₽</div></div>
            }
            @if (plan != null && hasDiet)
            {
            <div class="ws-card" style="flex-wrap:wrap;gap:.3rem;align-content:center">
                @if (plan.Vegetarian) { <span class="diet-tag">Вегетарианство</span> }
                @if (plan.Vegan)      { <span class="diet-tag">Веганство</span> }
                @if (plan.GlutenFree) { <span class="diet-tag">Без глютена</span> }
                @if (plan.LowCarb)    { <span class="diet-tag warn">Low-carb</span> }
                @if (plan.HighProtein){ <span class="diet-tag warn">Высокий белок</span> }
                @if (plan.LowFat)     { <span class="diet-tag warn">Low-fat</span> }
            </div>
            }
        </div>

        <div class="days-grid">
            @foreach (var day in Model.Days)
            {
            var isToday   = day.Date.Date == DateTime.Today;
            var dayOffset = (day.Date - Model.StartDate).Days;
            var byType    = day.Meals.GroupBy(m => m.MealTypeName ?? "").ToDictionary(g => g.Key, g => g.ToList());
            var dayKcal   = day.Meals.Sum(m => m.Calories);
            var dayCost   = day.Meals.Sum(m => m.Cost);

            List<PlannedMealViewModel> GetMeals(string k) =>
            byType.TryGetValue(k, out var v) ? v : new();

            <div class="day-card @(isToday ? "is-today" : "")" id="day-row-@dayOffset">

                <div class="day-label-col">
                    <div>
                        <div class="day-name">@DayAbbr(day.Date)</div>
                        <div class="day-date-s">@day.Date.ToString("d MMM")</div>
                        @if (isToday) { <span class="today-pill">сегодня</span> }
                    </div>
                    <div class="day-kcal-s" id="day-total-@dayOffset">
                        @if (day.Meals.Any())
                        {
                        <strong id="tot-kcal-@dayOffset">@dayKcal</strong>
                        <span>ккал</span>
                        @if (dayCost > 0) { <span id="tot-cost-@dayOffset" style="color:var(--sage-d);font-weight:600">@dayCost.ToString("F0") ₽</span> }
                        }
                    </div>
                </div>

                @for (int ti = 0; ti < 4; ti++)
                {
                var typeName = mealTypeNames[ti];
                var meals = ti == 0 ? GetMeals("Завтрак")
                : ti == 1 ? GetMeals("Обед")
                : ti == 2 ? GetMeals("Ужин")
                : GetMeals("Перекус");

                <div class="meal-col" id="cell-@dayOffset-@typeName">
                    <div class="mtype-head">@typeName</div>
                    <div class="meal-items">
                        @if (!meals.Any())
                        {
                        <div class="day-empty-msg" id="empty-@dayOffset-@typeName">—</div>
                        }
                        @foreach (var meal in meals)
                        {
                        <div class="meal-item" id="meal-@meal.Id"
                             data-meal-id="@meal.Id"
                             data-servings="@meal.Servings"
                             data-kcal-per-srv="@(meal.Calories / Math.Max(meal.Servings,1))"
                             data-cost-per-srv="@((meal.Cost / Math.Max(meal.Servings,1)).ToString("F4", System.Globalization.CultureInfo.InvariantCulture))">
                            @if (!string.IsNullOrEmpty(meal.RecipeImageUrl))
                            { <img class="mi-img" src="@meal.RecipeImageUrl" alt="@meal.RecipeName"/> }
                            else
                            { <div class="mi-img-ph">·</div> }
                            <div class="mi-info">
                                <a class="mi-name" href="/Recipe/Details/@meal.RecipeId" title="@meal.RecipeName">@meal.RecipeName</a>
                                <div class="mi-kcal" id="macros-@meal.Id">@meal.Calories ккал</div>
                            </div>
                            <div class="mi-srv">
                                <button class="srv-btn" onclick="changeServings('@meal.Id',-1)">−</button>
                                <span class="srv-val" id="srv-@meal.Id">@meal.Servings</span>
                                <button class="srv-btn" onclick="changeServings('@meal.Id',1)">+</button>
                            </div>
                            <div class="mi-actions no-print">
                                <button class="mi-act-btn" onclick="openReplaceModal('@meal.Id')" title="Заменить">↺</button>
                                <button class="mi-act-btn del" onclick="removeMeal('@meal.Id',this,'@dayOffset','@typeName')" title="Удалить">✕</button>
                            </div>
                        </div>
                        }
                    </div>
                    <button class="add-btn no-print" onclick="openAddModal('@Model.MealPlanId',@dayOffset,'@typeName')">+ добавить</button>
                </div>
                }
            </div>
            }
        </div>

        <div class="no-print" style="margin-top:.7rem;text-align:right">
            <a asp-action="GenerateWeek" style="font-size:.72rem;color:var(--sage-d);text-decoration:none;font-weight:500">
                Изменить параметры плана →
            </a>
        </div>
    </div>

    <!-- ══ ПОКУПКИ ══ -->
    <div class="wp-section" id="tabShop">
        <div class="shop-header no-print">
            <div>
                <div class="shop-total" id="shopTotalDisplay">@totalCost.ToString("F2") ₽ <span>итого</span></div>
                <div class="shop-sub">
                    <span>@Model.ShoppingList.Count позиций</span>
                    @if (plan is { ConsiderBudget: true, WeeklyBudget: > 0 })
                    { <span>Бюджет: @plan.WeeklyBudget.ToString("F0") ₽</span> }
                </div>
                @if (plan is { ConsiderBudget: true, WeeklyBudget: > 0 })
                {
                var bc = budgetPct < 80 ? "ok" : budgetPct < 100 ? "warn" : "over";
                <div class="budget-bar-wrap"><div class="budget-bar @bc" style="width:@((int)budgetPct)%"></div></div>
                }
            </div>
            <div style="display:flex;flex-direction:column;align-items:flex-end;gap:.4rem">
                <label style="font-size:.75rem;color:var(--muted);display:flex;align-items:center;gap:.35rem;cursor:pointer">
                    <input type="checkbox" id="checkAll" style="accent-color:var(--sage)"> Отметить всё
                </label>
                <button class="btn" onclick="exportShopList()" style="font-size:.72rem">Скопировать список</button>
            </div>
        </div>
        <table class="shop-table">
            <thead>
            <tr>
                <th class="no-print" style="width:24px"></th>
                <th>Продукт</th><th>Кол-во</th><th class="price-col">Цена</th>
            </tr>
            </thead>
            <tbody>
            @{ string? lastCat = null; }
            @foreach (var item in Model.ShoppingList)
            {
            if (item.Category != lastCat)
            {
            lastCat = item.Category;
            <tr class="cat-row"><td colspan="4">@(item.Category ?? "Прочее")</td></tr>
            }
            <tr class="shop-row" data-price="@item.TotalPrice.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
                <td class="no-print"><input type="checkbox" class="shop-check" onchange="toggleChecked(this)"></td>
                <td style="font-weight:500;color:var(--bark)">@item.ProductName</td>
                <td style="color:var(--muted)">@Math.Round(item.Amount,0) @item.Unit</td>
                <td class="price-col item-price">@item.TotalPrice.ToString("F2") ₽</td>
            </tr>
            }
            <tr style="border-top:2px solid var(--border)">
                <td class="no-print"></td>
                <td colspan="2" style="font-weight:700;color:var(--bark);padding:.55rem .7rem">Итого</td>
                <td class="price-col" style="font-family:'Lora',serif;font-size:1rem" id="shopTotalCell">@totalCost.ToString("F2") ₽</td>
            </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- ══ МОДАЛКА: Добавить блюдо ══ -->
<div class="modal-bg" id="addModal">
    <div class="modal">
        <h4>Добавить блюдо</h4>
        <div class="field">
            <label>Приём пищи</label>
            <select id="addType">
                <option value="">— выберите —</option>
                <option>Завтрак</option><option>Обед</option>
                <option>Ужин</option><option>Перекус</option>
            </select>
        </div>
        <div class="field">
            <label>Поиск рецепта</label>
            <input id="addSearch" type="text" placeholder="Начните вводить название…" autocomplete="off"/>
            <div id="addResults" class="search-results"></div>
        </div>
        <div class="recipe-prev" id="addPreview">
            <div style="font-weight:600;color:var(--bark)" id="prevName"></div>
            <div style="font-size:.68rem;color:var(--muted)" id="prevMacros"></div>
        </div>
        <div class="field">
            <label>Порций</label>
            <input id="addServings" type="number" min="1" max="10" value="1" style="max-width:80px"/>
        </div>
        <div class="modal-actions">
            <button class="btn" type="button" id="addCancel">Отмена</button>
            <button class="btn primary" type="button" id="addConfirm">Добавить</button>
        </div>
    </div>
</div>

<!-- ══ МОДАЛКА: Заменить блюдо ══ -->
<div class="modal-bg" id="replaceModal">
    <div class="modal" style="max-width:440px">
        <h4>Заменить блюдо</h4>
        <div style="font-size:.78rem;color:var(--muted);margin-bottom:.85rem">
            Текущее: <span id="replaceCurName" style="font-weight:600;color:var(--bark)"></span>
        </div>

        <!-- Вариант 1: автоподбор -->
        <button class="btn secondary" id="replaceAutoBtn" type="button" style="width:100%;justify-content:center;padding:.55rem">
            Подобрать автоматически
        </button>

        <div class="replace-divider">или найти вручную</div>

        <!-- Вариант 2: поиск -->
        <div class="field" style="margin-bottom:.5rem">
            <label>Поиск рецепта</label>
            <input id="replaceSearch" type="text" placeholder="Начните вводить название…" autocomplete="off"/>
            <div id="replaceResults" class="search-results"></div>
        </div>
        <div class="recipe-prev" id="replacePreview">
            <div style="font-weight:600;color:var(--bark)" id="replacePrevName"></div>
            <div style="font-size:.68rem;color:var(--muted)" id="replacePrevMacros"></div>
        </div>

        <div class="modal-actions">
            <button class="btn" type="button" id="replaceCancel">Отмена</button>
            <button class="btn primary" type="button" id="replaceSearchConfirm" disabled>Заменить выбранным</button>
        </div>
    </div>
</div>

<div id="toast"></div>

@section Scripts {
@Html.AntiForgeryToken()
<script>
// Все привязки к DOM — только после загрузки страницы
document.addEventListener('DOMContentLoaded', function () {

    const PLAN_ID = '@Model.MealPlanId';
        const CSRF    = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        
        let _recipes    = null;   // кэш всех рецептов
        let _selAdd     = null;   // выбранный рецепт в модалке добавления
        let _selReplace = null;   // выбранный рецепт в модалке замены
        let _addDay     = 0;
        let _addType    = '';
        let _replaceMealId = null;
        const _typeCache = {};
        
        // ── POST ──────────────────────────────────────────────────────────────────
        function post(url, data) {
            return fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ ...data, __RequestVerificationToken: CSRF })
            }).then(r => r.json());
        }
        
        // ── Toast ─────────────────────────────────────────────────────────────────
        function showToast(msg, err = false) {
            const t = document.getElementById('toast');
            t.textContent = msg;
            t.style.background = err ? '#7f1d1d' : '#1a2f1a';
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 2600);
        }
        
        // ── Загрузка рецептов ─────────────────────────────────────────────────────
        async function loadRecipes() {
            if (_recipes) return _recipes;
            try {
                const res = await fetch('/Recipe/GetAll');
                if (!res.ok) throw new Error('HTTP ' + res.status);
                _recipes = await res.json();
            } catch (e) {
                showToast('Не удалось загрузить рецепты: ' + e.message, true);
                _recipes = [];
            }
            return _recipes;
        }
        
        // ── Общая функция рендера результатов поиска ──────────────────────────────
        function renderSearchResults(query, resultsEl, onSelect) {
            if (!query || !_recipes) { resultsEl.style.display = 'none'; return; }
            const q = query.toLowerCase();
            const hits = _recipes.filter(r => r.name.toLowerCase().includes(q)).slice(0, 8);
            if (!hits.length) { resultsEl.style.display = 'none'; return; }
            resultsEl.innerHTML = hits.map(r =>
                `<div class="sri" data-id="${r.id}">
            <div class="sri-name">${r.name}</div>
            <div class="sri-sub">${Math.round(r.caloriesPerServing)} ккал · Б ${Math.round(r.proteinPerServing)}г</div>
         </div>`).join('');
            resultsEl.style.display = 'block';
            resultsEl.querySelectorAll('.sri').forEach(el => {
                el.addEventListener('click', () => {
                    const recipe = _recipes.find(r => r.id === el.dataset.id);
                    if (recipe) onSelect(recipe);
                });
            });
        }
        
        // ── Вспомогательные ───────────────────────────────────────────────────────
        function getDayOffset(el) {
            let n = el;
            while (n && !n.id?.startsWith('day-row-')) n = n.parentElement;
            return n ? n.id.replace('day-row-', '') : '0';
        }
        
        function recalcDay(dayOffset) {
            const row = document.getElementById('day-row-' + dayOffset);
            if (!row) return;
            let kcal = 0, cost = 0;
            row.querySelectorAll('.meal-item').forEach(e => {
                const srv = parseInt(e.dataset.servings) || 1;
                kcal += (parseFloat(e.dataset.kcalPerSrv) || 0) * srv;
                cost += (parseFloat(e.dataset.costPerSrv) || 0) * srv;
            });
            const k = document.getElementById('tot-kcal-' + dayOffset);
            const c = document.getElementById('tot-cost-' + dayOffset);
            if (k) k.textContent = Math.round(kcal);
            if (c) c.textContent = cost.toFixed(0) + ' ₽';
        }
        
        function recalcShopTotal() {
            let total = 0;
            document.querySelectorAll('.shop-row').forEach(row => {
                if (!row.classList.contains('checked'))
                    total += parseFloat(row.dataset.price || '0');
            });
            const fmt = total.toFixed(2) + ' ₽';
            const cell = document.getElementById('shopTotalCell');
            const disp = document.getElementById('shopTotalDisplay');
            if (cell) cell.textContent = fmt;
            if (disp) disp.innerHTML = total.toFixed(2) + ' ₽ <span>итого</span>';
        }
        
        async function getMealTypeId(name) {
            if (_typeCache[name]) return _typeCache[name];
            try {
                const r = await fetch('/MealPlan/GetMealTypeId?name=' + encodeURIComponent(name));
                const d = await r.json();
                if (d.id) _typeCache[name] = d.id;
                return d.id;
            } catch { return null; }
        }
        
        // ── Порции ────────────────────────────────────────────────────────────────
        async function changeServings(mealId, delta) {
            const entry = document.getElementById('meal-' + mealId);
            if (!entry) return;
            const cur    = parseInt(entry.dataset.servings) || 1;
            const newSrv = Math.max(1, Math.min(10, cur + delta));
            if (newSrv === cur) return;
            try {
                const d = await post('/MealPlan/UpdateServings', { plannedMealId: mealId, servings: newSrv });
                if (!d.success) { showToast('Ошибка обновления порций', true); return; }
                entry.dataset.servings = newSrv;
                document.getElementById('srv-' + mealId).textContent = newSrv;
                const m = document.getElementById('macros-' + mealId);
                if (m) m.textContent = d.calories + ' ккал';
                recalcDay(getDayOffset(entry));
            } catch { showToast('Ошибка соединения', true); }
        }
        window.changeServings = changeServings;
        
        // ── Удаление блюда ────────────────────────────────────────────────────────
        async function removeMeal(id, btn, dayOffset, typeName) {
            btn.classList.add('spinning'); btn.textContent = '…';
            try {
                const d = await post('/MealPlan/RemoveMeal', { plannedMealId: id });
                if (!d.success) { showToast('Ошибка удаления', true); return; }
                document.getElementById('meal-' + id)?.remove();
                const cell = document.getElementById('cell-' + dayOffset + '-' + typeName);
                if (cell && !cell.querySelectorAll('.meal-item').length) {
                    if (!document.getElementById('empty-' + dayOffset + '-' + typeName)) {
                        const el = document.createElement('div');
                        el.className = 'day-empty-msg';
                        el.id = 'empty-' + dayOffset + '-' + typeName;
                        el.textContent = '—';
                        cell.querySelector('.add-btn').insertAdjacentElement('beforebegin', el);
                    }
                }
                recalcDay(dayOffset);
                showToast('Блюдо удалено');
            } catch { showToast('Ошибка удаления', true); }
            finally { btn.classList.remove('spinning'); btn.textContent = '✕'; }
        }
        window.removeMeal = removeMeal;
        
        // ── Применить замену в DOM ────────────────────────────────────────────────
        function applyReplaceInDOM(mealId, d) {
            const entry = document.getElementById('meal-' + mealId);
            if (!entry) return;
            entry.querySelector('.mi-name').textContent = d.name;
            entry.querySelector('.mi-name').href = '/Recipe/Details/' + d.recipeId;
            const m = document.getElementById('macros-' + mealId);
            if (m) m.textContent = d.calories + ' ккал';
            const srv = parseInt(entry.dataset.servings) || 1;
            entry.dataset.kcalPerSrv = d.calories / srv;
            entry.dataset.costPerSrv = (d.cost / srv).toFixed(4);
            // Обновляем миниатюру
            const oldImg = entry.querySelector('.mi-img, .mi-img-ph');
            if (oldImg) {
                if (d.imageUrl) {
                    oldImg.outerHTML = `<img class="mi-img" src="${d.imageUrl}" alt="${d.name}"/>`;
                } else {
                    oldImg.className = 'mi-img-ph';
                    oldImg.textContent = '·';
                }
            }
            recalcDay(getDayOffset(entry));
        }
        
        // ══ МОДАЛКА ДОБАВЛЕНИЯ ═══════════════════════════════════════════════════
        
        window.openAddModal = async function(planId, dayOffset, typeName) {
            _addDay  = dayOffset;
            _addType = typeName;
            _selAdd  = null;
        
            document.getElementById('addType').value = typeName;
            document.getElementById('addSearch').value = '';
            document.getElementById('addResults').style.display = 'none';
            document.getElementById('addPreview').classList.remove('show');
            document.getElementById('addServings').value = 1;
        
            document.getElementById('addModal').classList.add('open');
            await loadRecipes();
        };
        
        document.getElementById('addCancel').addEventListener('click', () => {
            document.getElementById('addModal').classList.remove('open');
        });
        document.getElementById('addModal').addEventListener('click', function(e) {
            if (e.target === this) this.classList.remove('open');
        });
        
        document.getElementById('addSearch').addEventListener('input', async function () {
            await loadRecipes();
            renderSearchResults(this.value.trim(), document.getElementById('addResults'), r => {
                _selAdd = r;
                document.getElementById('addSearch').value = r.name;
                document.getElementById('addResults').style.display = 'none';
                document.getElementById('prevName').textContent = r.name;
                document.getElementById('prevMacros').textContent =
                    Math.round(r.caloriesPerServing) + ' ккал · Б ' + Math.round(r.proteinPerServing) +
                    'г · Ж ' + Math.round(r.fatPerServing) + 'г · У ' + Math.round(r.carbsPerServing) + 'г';
                document.getElementById('addPreview').classList.add('show');
            });
        });
        
        document.getElementById('addConfirm').addEventListener('click', async function () {
            if (!_selAdd) { showToast('Выберите рецепт', true); return; }
            const typeName = document.getElementById('addType').value;
            const servings = parseInt(document.getElementById('addServings').value) || 1;
            const typeId   = await getMealTypeId(typeName);
            if (!typeId) { showToast('Тип приёма пищи не найден', true); return; }
        
            this.disabled = true; this.textContent = '…';
            try {
                const d = await post('/MealPlan/AddMeal', {
                    mealPlanId: PLAN_ID, recipeId: _selAdd.id,
                    mealTypeId: typeId, dayOffset: _addDay, servings
                });
                if (d.error) { showToast(d.error, true); return; }
                injectMeal(d, _addDay, typeName, servings);
                document.getElementById('addModal').classList.remove('open');
                showToast('Добавлено: «' + d.name + '»');
            } catch { showToast('Ошибка добавления', true); }
            finally { this.disabled = false; this.textContent = 'Добавить'; }
        });
        
        function injectMeal(d, dayOffset, typeName, servings) {
            const cell = document.getElementById('cell-' + dayOffset + '-' + typeName);
            if (!cell) return;
            document.getElementById('empty-' + dayOffset + '-' + typeName)?.remove();
            const srv   = servings || 1;
            const thumb = d.imageUrl
                ? `<img class="mi-img" src="${d.imageUrl}" alt="${d.name}"/>`
                : `<div class="mi-img-ph">·</div>`;
            const html = `
            <div class="meal-item" id="meal-${d.plannedMealId}"
                 data-meal-id="${d.plannedMealId}" data-servings="${srv}"
                 data-kcal-per-srv="${(d.calories/srv).toFixed(2)}"
                 data-cost-per-srv="${(d.cost/srv).toFixed(4)}">
                ${thumb}
                <div class="mi-info">
                    <a class="mi-name" href="/Recipe/Details/${d.recipeId}">${d.name}</a>
                    <div class="mi-kcal" id="macros-${d.plannedMealId}">${d.calories} ккал</div>
                </div>
                <div class="mi-srv">
                    <button class="srv-btn" onclick="changeServings('${d.plannedMealId}',-1)">−</button>
                    <span class="srv-val" id="srv-${d.plannedMealId}">${srv}</span>
                    <button class="srv-btn" onclick="changeServings('${d.plannedMealId}',1)">+</button>
                </div>
                <div class="mi-actions no-print">
                    <button class="mi-act-btn" onclick="openReplaceModal('${d.plannedMealId}')" title="Заменить">↺</button>
                    <button class="mi-act-btn del" onclick="removeMeal('${d.plannedMealId}',this,'${dayOffset}','${typeName}')" title="Удалить">✕</button>
                </div>
            </div>`;
                    cell.querySelector('.add-btn').insertAdjacentHTML('beforebegin', html);
                    recalcDay(dayOffset);
                }
        
        // ══ МОДАЛКА ЗАМЕНЫ ═══════════════════════════════════════════════════════
        window.openReplaceModal = async function(mealId) {
            _replaceMealId = mealId;
            _selReplace    = null;

            // Показать текущее название
            const entry = document.getElementById('meal-' + mealId);
            const curName = entry?.querySelector('.mi-name')?.textContent?.trim() ?? '';
            document.getElementById('replaceCurName').textContent = curName;

            // Сброс поиска
            document.getElementById('replaceSearch').value = '';
            document.getElementById('replaceResults').style.display = 'none';
            document.getElementById('replacePreview').classList.remove('show');
            document.getElementById('replaceSearchConfirm').disabled = true;

            document.getElementById('replaceModal').classList.add('open');
            await loadRecipes();
        };

        document.getElementById('replaceCancel').addEventListener('click', () => {
            document.getElementById('replaceModal').classList.remove('open');
        });
        document.getElementById('replaceModal').addEventListener('click', function(e) {
            if (e.target === this) this.classList.remove('open');
        });

        // Автоподбор
        document.getElementById('replaceAutoBtn').addEventListener('click', async function () {
            this.disabled = true; this.textContent = 'Подбираем…';
            try {
                const d = await post('/MealPlan/ReplaceMeal', { plannedMealId: _replaceMealId });
                if (d.error) { showToast(d.error, true); return; }
                applyReplaceInDOM(_replaceMealId, d);
                document.getElementById('replaceModal').classList.remove('open');
                showToast('Заменено на «' + d.name + '»');
            } catch { showToast('Ошибка замены', true); }
            finally { this.disabled = false; this.textContent = 'Подобрать автоматически'; }
        });
        
        // Поиск в модалке замены
        document.getElementById('replaceSearch').addEventListener('input', async function () {
            await loadRecipes();
            renderSearchResults(this.value.trim(), document.getElementById('replaceResults'), r => {
                _selReplace = r;
                document.getElementById('replaceSearch').value = r.name;
                document.getElementById('replaceResults').style.display = 'none';
                document.getElementById('replacePrevName').textContent = r.name;
                document.getElementById('replacePrevMacros').textContent =
                    Math.round(r.caloriesPerServing) + ' ккал · Б ' + Math.round(r.proteinPerServing) +
                    'г · Ж ' + Math.round(r.fatPerServing) + 'г · У ' + Math.round(r.carbsPerServing) + 'г';
                document.getElementById('replacePreview').classList.add('show');
                document.getElementById('replaceSearchConfirm').disabled = false;
            });
        });

        // Заменить выбранным из поиска
        document.getElementById('replaceSearchConfirm').addEventListener('click', async function () {
            if (!_selReplace) { showToast('Выберите рецепт', true); return; }
            this.disabled = true; this.textContent = '…';
            try {
                const d = await post('/MealPlan/ReplaceMealWithRecipe', {
                    plannedMealId: _replaceMealId,
                    newRecipeId:   _selReplace.id
                });
                if (d.error) { showToast(d.error, true); return; }
                applyReplaceInDOM(_replaceMealId, d);
                document.getElementById('replaceModal').classList.remove('open');
                showToast('Заменено на «' + d.name + '»');
            } catch { showToast('Ошибка замены', true); }
            finally { this.disabled = false; this.textContent = 'Заменить выбранным'; }
        });
        
        // ── Покупки ───────────────────────────────────────────────────────────────
        function toggleChecked(cb) {
            cb.closest('tr').classList.toggle('checked', cb.checked);
            recalcShopTotal();
        }
        window.toggleChecked = toggleChecked;
        
        document.getElementById('checkAll').addEventListener('change', function () {
            document.querySelectorAll('.shop-check').forEach(cb => {
                cb.checked = this.checked;
                cb.closest('tr').classList.toggle('checked', this.checked);
            });
            recalcShopTotal();
        });
        
        // ── Табы ──────────────────────────────────────────────────────────────────
        function switchTab(name, btn) {
            document.querySelectorAll('.wp-tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.wp-section').forEach(s => s.classList.remove('active'));
            if (btn) btn.classList.add('active');
            document.getElementById('tab' + name).classList.add('active');
        }
        window.switchTab = switchTab;
        
        function printSection(s) {
            document.body.classList.add(s === 'meal' ? 'print-meal-plan' : 'print-shop-list');
            window.print();
            setTimeout(() => document.body.classList.remove('print-meal-plan', 'print-shop-list'), 1000);
        }
        window.printSection = printSection;
        
        function exportShopList() {
            const lines = [...document.querySelectorAll('.shop-row')].map(r => {
                const c = r.querySelectorAll('td');
                return `${c[1]?.textContent.trim()} — ${c[2]?.textContent.trim()} (${c[3]?.textContent.trim()})`;
            });
            navigator.clipboard.writeText(lines.join('\n')).then(() => showToast('Список скопирован!'));
        }
        window.exportShopList = exportShopList;
        
        // Escape закрывает любую открытую модалку
        document.addEventListener('keydown', e => {
            if (e.key !== 'Escape') return;
            document.querySelectorAll('.modal-bg.open').forEach(m => m.classList.remove('open'));
        });
}); 
</script>
}