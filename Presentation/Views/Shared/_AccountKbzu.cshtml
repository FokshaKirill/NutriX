@*
    _AccountKbzu.cshtml
    Секция «КБЖУ на сегодня» + стрик, в одной карточке.

    Важно: реальный прогресс по КБЖУ и значение стрика считаются на клиенте
    в home-index.js, на основе того, какие блюда из плана отмечены как
    "съедено" в localStorage (серверу это состояние не известно, поэтому
    Razor здесь НЕ вычисляет процент — только дневные цели для подписей).
*@
@{
    var calGoal  = ViewData["calGoal"]  as string ?? "2000"; 
    var protGoal = ViewData["protGoal"] as string ?? "120";
    var fatGoal  = ViewData["fatGoal"]  as string ?? "70";
    var carbGoal = ViewData["carbGoal"] as string ?? "250";

    var monday   = DateTime.Today.AddDays(-(((int)DateTime.Today.DayOfWeek + 6) % 7));
    var dayNames = new[] { "пн", "вт", "ср", "чт", "пт", "сб", "вс" };
}

<div class="kbzu-section">
    <p class="card-label">КБЖУ на сегодня — из плана питания</p>

    <div class="kbzu-totals">
        <div class="kbzu-bubble">
            <div class="kbzu-bubble-val"><span id="eatenKcal">0</span></div>
            <div class="kbzu-bubble-label">ккал</div>
        </div>
        <div class="kbzu-bubble">
            <div class="kbzu-bubble-val" style="color:#1d4ed8"><span id="eatenProt">0</span> г</div>
            <div class="kbzu-bubble-label">белки</div>
        </div>
        <div class="kbzu-bubble">
            <div class="kbzu-bubble-val" style="color:#c2410c"><span id="eatenFat">0</span> г</div>
            <div class="kbzu-bubble-label">жиры</div>
        </div>
        <div class="kbzu-bubble">
            <div class="kbzu-bubble-val" style="color:#a16207"><span id="eatenCarb">0</span> г</div>
            <div class="kbzu-bubble-label">углеводы</div>
        </div>
    </div>

    <div class="prog-row">
        <span class="prog-label">Калории</span>
        <div class="prog-bar-wrap">
            <div class="prog-bar" id="barKcal" style="width:0%;"></div>
        </div>
        <span class="prog-val">Цель: @calGoal</span>
    </div>
    <div class="prog-row">
        <span class="prog-label">Белки</span>
        <div class="prog-bar-wrap">
            <div class="prog-bar" id="barProt" style="width:0%;"></div>
        </div>
        <span class="prog-val">Цель: @protGoal г</span>
    </div>
    <div class="prog-row">
        <span class="prog-label">Жиры</span>
        <div class="prog-bar-wrap">
            <div class="prog-bar" id="barFat" style="width:0%;"></div>
        </div>
        <span class="prog-val">Цель: @fatGoal г</span>
    </div>
    <div class="prog-row">
        <span class="prog-label">Углеводы</span>
        <div class="prog-bar-wrap">
            <div class="prog-bar" id="barCarb" style="width:0%;"></div>
        </div>
        <span class="prog-val">Цель: @carbGoal г</span>
    </div>

    @* ── Стрик внутри той же карточки ──────────────────────────────────────── *@
    
    <section class="streak-section">
        <div class="streak-card">
            <div class="streak-flame">🔥</div>
            <div class="streak-info">
                <div class="streak-count-row">
                    <span id="streakCount" class="streak-num">0</span>
                    <span class="streak-label">дней подряд</span>
                </div>
                <div class="streak-dots">
                    @for (int i = 0; i < 7; i++)
                    {
                        var date    = monday.AddDays(i);
                        var dateStr = date.ToString("yyyy-MM-dd");
                        var isToday = date.Date == DateTime.Today;
                        var isPast  = date.Date < DateTime.Today;
                        <div class="streak-dot @(isToday ? "today" : "") @(isPast ? "past" : "")"
                             data-date="@dateStr">
                            <span class="dot-day">@dayNames[i]</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
    
    <p style="font-size:.75rem;color:var(--muted);margin-top:.75rem;margin-bottom:0">
        Плановые значения на сегодня из
        <a asp-action="Week" asp-controller="MealPlan" style="color:var(--sage-d)">плана питания</a>
    </p>
</div>
