@model Domain.Entities.Recipe
@* _MyRecipeCard.cshtml — карточка «моего рецепта» на странице аккаунта *@

<div class="fav-card">
    <div class="fav-card-img">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Name" />
        }
        else
        {
            <span>🍽</span>
        }
    </div>
    <div class="fav-card-body">
        <div class="fav-card-name">@Model.Name</div>
        @if (Model.TotalCalories > 0)
        {
            <div class="fav-card-meta">
                🔥 @((int)Model.CaloriesPerServing) ккал ·
                @Model.DefaultServings порц.
            </div>
        }
        <div class="fav-card-actions">
            <a asp-action="Details" asp-controller="Recipe"
               asp-route-id="@Model.Id" class="fav-open-btn">
                <i class="fas fa-eye" style="font-size:.65rem"></i> Открыть
            </a>
            <a asp-action="Edit" asp-controller="Recipe"
               asp-route-id="@Model.Id" class="fav-open-btn"
               style="background:#f0f7f2">
                <i class="fas fa-pen" style="font-size:.65rem"></i>
            </a>
            <form asp-action="Delete" asp-controller="Recipe"
                  method="post" style="display:contents">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="fav-rm-btn"
                        onclick="return confirm('Удалить «@Model.Name»?')"
                        title="Удалить">🗑</button>
            </form>
        </div>
    </div>
</div>
