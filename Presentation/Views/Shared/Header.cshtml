<header class="header bg-white shadow-sm py-3">
    <div class="container">
        <nav class="navbar navbar-expand-lg navbar-light p-0">
            <!-- Логотип -->
            <a class="navbar-brand fw-bold text-success fs-3" asp-controller="Home" asp-action="Index">
                <img src="~/images/logooo.png" class="fas me-1 logo"/>NutriX
                @* <i class="fas fa-leaf me-2"></i>NutriX *@
            </a>

            <!-- Гамбургер (показывается на мобильных) -->
            <button class="navbar-toggler custom-toggler" type="button" data-bs-toggle="collapse" 
                    data-bs-target="#navbarContent" aria-controls="navbarContent" 
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Контент навбара -->
            <div class="collapse navbar-collapse" id="navbarContent">
                <!-- Поиск -->
                <form class="d-flex search-form my-3 my-lg-0 me-lg-3"
                      style="max-width:-webkit-fill-available;"
                      role="search"
                      action="/Recipe"
                      method="get">
                    <input class="form-control me-2"
                           type="search"
                           name="searchTerm"
                           placeholder="Поиск рецептов..."
                           aria-label="Search"
                           autocomplete="off"/>
                    <button class="btn btn-outline-success" type="submit">
                        <i class="fas fa-search"></i>
                    </button>
                </form>

                <!-- Меню навигации -->
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Recipe" asp-action="Index">
                            <i class="fas fa-book me-2"></i>
                            <span>Рецепты</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="MealPlan" asp-action="Week">
                            <i class="fas fa-calendar-week me-2"></i>
                            <span>План</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Product" asp-action="Index">
                            <i class="fas fa-carrot me-2"></i>
                            <span>Продукты</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Account">
                            <i class="fas fa-user me-2"></i>
                            <span>Аккаунт</span>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    </div>
</header>

<style>
</style>

<script>
// Закрытие мобильного меню при клике на overlay или кнопку закрытия
document.addEventListener('DOMContentLoaded', function() {
    const navbarCollapse = document.getElementById('navbarContent');
    const navbarToggler = document.querySelector('.navbar-toggler');
    
    if (navbarCollapse) {
        // Закрытие по клику на overlay
        navbarCollapse.addEventListener('click', function(e) {
            if (e.target === this || e.target.matches('::after')) {
                const bsCollapse = new bootstrap.Collapse(navbarCollapse, {
                    toggle: false
                });
                bsCollapse.hide();
            }
        });

        // Закрытие при клике на ссылку (для мобильных)
        const navLinks = navbarCollapse.querySelectorAll('.nav-link');
        navLinks.forEach(link => {
            link.addEventListener('click', function() {
                if (window.innerWidth < 992) {
                    const bsCollapse = new bootstrap.Collapse(navbarCollapse, {
                        toggle: false
                    });
                    bsCollapse.hide();
                }
            });
        });

        // Закрытие по клику на псевдоэлемент (крестик)
        document.addEventListener('click', function(e) {
            if (navbarCollapse.classList.contains('show')) {
                const rect = navbarCollapse.getBoundingClientRect();
                const closeButtonArea = {
                    top: rect.top,
                    right: rect.right,
                    bottom: rect.top + 60,
                    left: rect.right - 60
                };
                
                if (e.clientX >= closeButtonArea.left && 
                    e.clientX <= closeButtonArea.right &&
                    e.clientY >= closeButtonArea.top && 
                    e.clientY <= closeButtonArea.bottom) {
                    const bsCollapse = new bootstrap.Collapse(navbarCollapse, {
                        toggle: false
                    });
                    bsCollapse.hide();
                }
            }
        });
    }

    // Подсветка активной страницы
    const currentPath = window.location.pathname;
    const navLinks = document.querySelectorAll('.navbar-nav .nav-link');
    
    navLinks.forEach(link => {
        if (link.getAttribute('href') === currentPath || 
            (link.href && link.href === window.location.href)) {
            link.classList.add('active');
        }
    });
});
</script>