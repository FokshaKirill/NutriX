        </div>
        <div class="nx-pill">
          <span class="nx-dot" style="animation-delay:.4s"></span>
          Бюджет недели
        </div>
        <div class="nx-pill">
          <span class="nx-dot" style="animation-delay:.8s"></span>
          AI-генерация меню
        </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/home-index.js" asp-append-version="true"></script>
}
