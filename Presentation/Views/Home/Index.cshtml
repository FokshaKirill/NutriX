        <line x1="19" y1="6" x2="19" y2="46" stroke="rgba(122,171,132,.3)" stroke-width="1"/>
        </svg>

        <svg class="nx-leaf nx-leaf2" width="42" height="56" viewBox="0 0 42 56">
        <path d="M21 54 C11 43, 2 30, 4 14 C6 3, 21 2, 21 2 C21 2, 36 3, 38 14 C40 30, 31 43, 21 54Z" fill="rgba(78,125,88,.2)" stroke="rgba(78,125,88,.35)" stroke-width="1"/>
        <line x1="21" y1="6" x2="21" y2="50" stroke="rgba(78,125,88,.3)" stroke-width="1"/>
        </svg>

        <svg class="nx-leaf nx-leaf3" width="26" height="34" viewBox="0 0 26 34">
        <path d="M13 33 C7 26, 2 18, 3 9 C4 3, 13 2, 13 2 C13 2, 22 3, 23 9 C24 18, 19 26, 13 33Z" fill="rgba(122,171,132,.13)" stroke="rgba(122,171,132,.25)" stroke-width="1"/>
        </svg>

        <svg class="nx-leaf nx-leaf4" width="30" height="40" viewBox="0 0 30 40">
        <path d="M15 38 C8 30, 2 20, 3 10 C4 3, 15 2, 15 2 C15 2, 26 3, 27 10 C28 20, 22 30, 15 38Z" fill="rgba(78,125,88,.15)" stroke="rgba(78,125,88,.28)" stroke-width="1"/>
        </svg>

        <span class="nx-tag">
        <span class="nx-dot"></span>
        Умное питание
        </span>

        <h2 class="nx-headline">
        Еда — это забота<br>о себе. <em>Каждый день.</em>
        </h2>

        <div class="nx-divider"></div>

        <p class="nx-sub">
        Планируйте рацион осознанно — с учётом калорий, бюджета и ваших целей
        </p>

        <div class="nx-pills">
        <div class="nx-pill">
          <span class="nx-dot" style="animation-delay:.0s"></span>
