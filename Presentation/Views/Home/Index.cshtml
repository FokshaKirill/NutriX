@using Domain.Entities
@{
    ViewData["Title"] = "NutriX — Умное питание";

    var recipes = ViewBag.LatestRecipes as List<Presentation.Models.RecipeListViewModel> ?? new();
    var user = ViewBag.CurrentUser as Domain.Entities.User;

    var calGoal  = user?.DailyCalorieGoal ?? 2000;
    var protGoal = (double)(user?.DailyProteinGoal ?? 120);
    var fatGoal  = (double)(user?.DailyFatGoal ?? 70);
    var carbGoal = (double)(user?.DailyCarbsGoal ?? 250);
}

<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>

<!-- ── HERO ── -->
<div class="home-hero">
    <span class="hero-tag">AI-планировщик питания</span>

    <h1 class="hero-h1">
        Ешьте умно,<br>
        тратьте <em>меньше</em>
    </h1>

    <p class="hero-sub">
        Персональное меню, подсчёт КБЖУ и контроль бюджета — всё в одном месте
    </p>

    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap">
        <a asp-action="Index"
           asp-controller="Recipe"
           class="hero-cta">
            <i class="fas fa-utensils"></i>
            Смотреть рецепты
        </a>

        @if (User.Identity?.IsAuthenticated != true)
        {
            <a asp-action="AuthPage"
               asp-controller="Account"
               class="hero-cta-ghost">
                Войти
                <i class="fas fa-arrow-right"></i>
            </a>
        }
    </div>
</div>

<!-- ── ПОСЛЕДНИЕ РЕЦЕПТЫ ── -->
<section class="home-recipes-section">

    <div class="sec-head">
        <h2 class="sec-title">Свежие рецепты</h2>

        <a asp-action="Index"
           asp-controller="Recipe"
           class="sec-link">
            Все рецепты →
        </a>
    </div>

    <div class="home-recipe-grid">

        @if (!recipes.Any())
        {
            <div class="recipes-empty-home">
                <div style="font-size:3rem;margin-bottom:.75rem">🍽</div>

                <p>
                    Рецептов пока нет.
                    <a asp-action="Create" asp-controller="Recipe">
                        Создайте первый!
                    </a>
                </p>
            </div>
        }
        else
        {
            @foreach (var r in recipes)
            {
                <div class="rc">

                    <div class="rc-thumb">
                        @if (!string.IsNullOrEmpty(r.ImageUrl))
                        {
                            <img src="@r.ImageUrl"
                                 alt="@r.Name"
                                 loading="lazy"/>
                        }
                        else
                        {
                            <div class="rc-thumb-ph">🥘</div>
                        }
                    </div>

                    <div class="rc-body">

                        <a asp-action="Details"
                           asp-controller="Recipe"
                           asp-route-id="@r.Id"
                           class="rc-name">
                            @r.Name
                        </a>

                        <div class="rc-macros">

                            @if (r.CaloriesPerServing > 0)
                            {
                                <span class="rc-macro kcal">
                                    🔥 @((int)r.CaloriesPerServing!) ккал
                                </span>
                            }

                            @if (r.ProteinPerServing > 0)
                            {
                                <span class="rc-macro p">
                                    Б @((int)r.ProteinPerServing!)г
                                </span>
                            }

                            @if (r.FatPerServing > 0)
                            {
                                <span class="rc-macro f">
                                    Ж @((int)r.FatPerServing!)г
                                </span>
                            }

                            @if (r.CarbsPerServing > 0)
                            {
                                <span class="rc-macro c">
                                    У @((int)r.CarbsPerServing!)г
                                </span>
                            }

                        </div>

                        <a asp-action="Details"
                           asp-controller="Recipe"
                           asp-route-id="@r.Id"
                           class="rc-open">
                            Открыть
                            <i class="fas fa-arrow-right" style="font-size:.7rem"></i>
                        </a>

                    </div>
                </div>
            }
        }
    </div>
</section>

<!-- ── МЕНЮ НА ДЕНЬ ── -->
<section class="day-section">

    <div class="day-inner">

        <div class="sec-head" style="margin-bottom:1.25rem">
            <h2 class="sec-title">Меню на сегодня</h2>

            <span id="dayDateLabel"
                  style="font-size:.85rem;color:#9a9a94">
            </span>
        </div>

        @if (User.Identity?.IsAuthenticated != true)
        {
            <div style="text-align:center;padding:2rem;color:#9a9a94">
                <a asp-action="AuthPage"
                   asp-controller="Account"
                   style="color:#5a9668">
                    Войдите
                </a>,
                чтобы видеть своё меню
            </div>
        }
        else
        {
            var todayMeals = ViewBag.TodayMeals as List<PlannedMeal> ?? new();

            @if (!todayMeals.Any())
            {
                <div style="text-align:center;padding:2rem;color:#9a9a94">

                    <div style="font-size:2.5rem;margin-bottom:.75rem">
                        📋
                    </div>

                    <p>На сегодня меню не запланировано.</p>

                    <a asp-controller="MealPlan"
                       asp-action="GenerateWeek"
                       class="hero-cta"
                       style="margin-top:.75rem;display:inline-flex">
                        <i class="fas fa-magic"></i>
                        Сгенерировать меню
                    </a>

                </div>
            }
            else
            {
                <!-- TOTALS -->
                <div class="day-total" id="dayTotals">

                    <div class="day-total-item">
                        <div class="day-total-val" id="totKcal">
                            @todayMeals.Sum(m => (int)(m.Recipe?.CaloriesPerServing ?? 0))
                        </div>

                        <div class="day-total-label">
                            ккал
                        </div>
                    </div>

                    <div class="day-total-item">
                        <div class="day-total-val"
                             id="totP"
                             style="color:#1d4ed8">

                            @todayMeals.Sum(m => (int)(m.Recipe?.ProteinPerServing ?? 0))г
                        </div>

                        <div class="day-total-label">
                            белки
                        </div>
                    </div>

                    <div class="day-total-item">
                        <div class="day-total-val"
                             id="totF"
                             style="color:#c2410c">

                            @todayMeals.Sum(m => (int)(m.Recipe?.FatPerServing ?? 0))г
                        </div>

                        <div class="day-total-label">
                            жиры
                        </div>
                    </div>

                    <div class="day-total-item">
                        <div class="day-total-val"
                             id="totC"
                             style="color:#a16207">

                            @todayMeals.Sum(m => (int)(m.Recipe?.CarbsPerServing ?? 0))г
                        </div>

                        <div class="day-total-label">
                            углеводы
                        </div>
                    </div>

                </div>

                <!-- MEALS -->
                <div class="meals-list">

                    @foreach (var meal in todayMeals.OrderBy(m => m.MealType!.Order))
                    {
                        <div class="meal-card"
                             id="mealCard_@meal.Id">

                            <div class="meal-header">

                                <div class="meal-check"
                                     id="check_@meal.Id"
                                     onclick="toggleDone('@meal.Id')">
                                </div>

                                @if (!string.IsNullOrEmpty(meal.Recipe?.ImageUrl))
                                {
                                    <img src="@meal.Recipe.ImageUrl"
                                         class="meal-img"
                                         alt="@meal.Recipe.Name"/>
                                }
                                else
                                {
                                    <div class="meal-img-ph">🍽</div>
                                }

                                <div class="meal-info">

                                    <div class="meal-type">
                                        @meal.MealType?.Name
                                    </div>

                                    <div class="meal-name"
                                         id="mealName_@meal.Id">
                                        @meal.Recipe?.Name
                                    </div>

                                    <div class="meal-macros-inline">
                                        Б@((int)(meal.Recipe?.ProteinPerServing ?? 0))г ·
                                        Ж@((int)(meal.Recipe?.FatPerServing ?? 0))г ·
                                        У@((int)(meal.Recipe?.CarbsPerServing ?? 0))г
                                    </div>

                                </div>

                                <div class="meal-kcal"
                                     id="mealKcal_@meal.Id">
                                    @((int)(meal.Recipe?.CaloriesPerServing ?? 0)) ккал
                                </div>

                                <button class="meal-replace-btn"
                                        onclick="replaceMeal('@meal.Id', this)"
                                        title="Заменить рецепт"
                                        style="margin-left:.5rem;flex-shrink:0;background:none;border:1px solid #e4ede6;border-radius:8px;padding:.3rem .6rem;cursor:pointer;font-size:.75rem;color:#7a7168;transition:all .2s">

                                    <i class="fas fa-sync-alt"></i>

                                </button>

                            </div>
                        </div>
                    }

                </div>

                <!-- PROGRESS -->
                @if (user != null)
                {
                    var totalCalories = todayMeals.Sum(m => (int)(m.Recipe?.CaloriesPerServing ?? 0));
                    var totalProtein  = todayMeals.Sum(m => (int)(m.Recipe?.ProteinPerServing ?? 0));
                    var totalFat      = todayMeals.Sum(m => (int)(m.Recipe?.FatPerServing ?? 0));
                    var totalCarbs    = todayMeals.Sum(m => (int)(m.Recipe?.CarbsPerServing ?? 0));

                    <div class="day-progress" style="margin-top:1.25rem">

                        <div class="day-progress-title">
                            Прогресс по целям
                        </div>

                        <div class="progress-rows">

                            <div class="prog-row">
                                <span class="prog-label">Калории</span>

                                <div class="prog-bar-wrap">
                                    <div class="prog-bar"
                                         style="width:@(Math.Min(100, totalCalories * 100 / Math.Max(calGoal, 1)))%;background:#86bf92">
                                    </div>
                                </div>

                                <span class="prog-val">
                                    @totalCalories / @calGoal
                                </span>
                            </div>

                            <div class="prog-row">
                                <span class="prog-label">Белки</span>

                                <div class="prog-bar-wrap">
                                    <div class="prog-bar"
                                         style="width:@(Math.Min(100, totalProtein * 100 / Math.Max(protGoal, 1)))%;background:#3b82f6">
                                    </div>
                                </div>

                                <span class="prog-val">
                                    @totalProtein / @protGoal.ToString("F0")г
                                </span>
                            </div>

                            <div class="prog-row">
                                <span class="prog-label">Жиры</span>

                                <div class="prog-bar-wrap">
                                    <div class="prog-bar"
                                         style="width:@(Math.Min(100, totalFat * 100 / Math.Max(fatGoal, 1)))%;background:#f97316">
                                    </div>
                                </div>

                                <span class="prog-val">
                                    @totalFat / @fatGoal.ToString("F0")г
                                </span>
                            </div>

                            <div class="prog-row">
                                <span class="prog-label">Углеводы</span>

                                <div class="prog-bar-wrap">
                                    <div class="prog-bar"
                                         style="width:@(Math.Min(100, totalCarbs * 100 / Math.Max(carbGoal, 1)))%;background:#eab308">
                                    </div>
                                </div>

                                <span class="prog-val">
                                    @totalCarbs / @carbGoal.ToString("F0")г
                                </span>
                            </div>

                        </div>
                    </div>
                }
            }
        }
    </div>
</section>

<script>

// ── ДАТА ──
const today = new Date().toLocaleDateString('ru-RU', {
    weekday: 'long',
    day: 'numeric',
    month: 'long'
});

document.getElementById('dayDateLabel').textContent =
    today.charAt(0).toUpperCase() + today.slice(1);


// ── DONE STORAGE ──
const DONE_KEY =
    'nutrix_done_' + new Date().toISOString().slice(0,10);

function getDone() {
    try {
        return JSON.parse(localStorage.getItem(DONE_KEY) || '[]');
    }
    catch {
        return [];
    }
}

function toggleDone(mealId) {

    const done  = getDone();
    const idx   = done.indexOf(mealId);

    const card  = document.getElementById('mealCard_' + mealId);
    const check = document.getElementById('check_' + mealId);

    if (idx === -1) {

        done.push(mealId);

        card?.classList.add('done');

        if (check)
            check.textContent = '✓';

    } else {

        done.splice(idx, 1);

        card?.classList.remove('done');

        if (check)
            check.textContent = '';
    }

    localStorage.setItem(DONE_KEY, JSON.stringify(done));
}


// ── RESTORE DONE ──
getDone().forEach(id => {

    const card  = document.getElementById('mealCard_' + id);
    const check = document.getElementById('check_' + id);

    card?.classList.add('done');

    if (check)
        check.textContent = '✓';
});


// ── REPLACE RECIPE ──
const CSRF =
    document.querySelector('input[name="__RequestVerificationToken"]')
    ?.value ?? '';

async function replaceMeal(plannedMealId, btn) {

    btn.disabled = true;
    btn.innerHTML =
        '<i class="fas fa-spinner fa-spin"></i>';

    try {

        const res = await fetch('/MealPlan/ReplaceMeal', {
            method: 'POST',

            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },

            body:
                `plannedMealId=${plannedMealId}` +
                `&__RequestVerificationToken=${encodeURIComponent(CSRF)}`
        });

        const data = await res.json();

        if (data.error) {
            alert(data.error);
            return;
        }

        const nameEl =
            document.getElementById('mealName_' + plannedMealId);

        const kcalEl =
            document.getElementById('mealKcal_' + plannedMealId);

        const imgEl =
            document.querySelector(`#mealCard_${plannedMealId} .meal-img`);

        const phEl =
            document.querySelector(`#mealCard_${plannedMealId} .meal-img-ph`);

        if (nameEl)
            nameEl.textContent = data.name;

        if (kcalEl)
            kcalEl.textContent = data.calories + ' ккал';

        if (data.imageUrl && imgEl) {

            imgEl.src = data.imageUrl;

        } else if (data.imageUrl && phEl) {

            phEl.outerHTML =
                `<img src="${data.imageUrl}" class="meal-img" alt="${data.name}" />`;
        }

    } catch {

        alert('Ошибка соединения');

    } finally {

        btn.disabled = false;

        btn.innerHTML =
            '<i class="fas fa-sync-alt"></i>';
    }
}

</script>