        <circle cx="560" cy="-30" r="160" fill="rgba(122,171,132,.05)"/>
        <circle cx="80" cy="300" r="180" fill="rgba(78,125,88,.07)"/>
        <circle cx="340" cy="140" r="260" fill="rgba(45,36,23,.15)"/>
        <circle cx="600" cy="220" r="90" fill="rgba(122,171,132,.04)"/>
        <circle cx="50" cy="60" r="70" fill="rgba(122,171,132,.04)"/>
