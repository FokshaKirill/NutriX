@using Domain.Entities
@{
    ViewData["Title"] = "NutriX — Умное питание";

    var recipes    = ViewBag.LatestRecipes as List<Presentation.Models.RecipeListViewModel> ?? new();
    var user       = ViewBag.CurrentUser as Domain.Entities.User;
    var todaySlots = ViewBag.TodaySlots as List<Domain.Entities.MealSlot> ?? new();
    var allItems   = todaySlots.SelectMany(s => s.Items).ToList();

    var calGoal  = allItems.Sum(m => (int)((m.Recipe?.CaloriesPerServing ?? 0) * m.Servings));
    var protGoal = allItems.Sum(m => (int)((m.Recipe?.ProteinPerServing  ?? 0) * m.Servings));
    var fatGoal  = allItems.Sum(m => (int)((m.Recipe?.FatPerServing      ?? 0) * m.Servings));
    var carbGoal = allItems.Sum(m => (int)((m.Recipe?.CarbsPerServing    ?? 0) * m.Servings));

    var mealsJson = System.Text.Json.JsonSerializer.Serialize(
        allItems.Select(m => new {
            id       = m.Id.ToString(),
            calories = (int)((m.Recipe?.CaloriesPerServing ?? 0) * m.Servings),
            protein  = (int)((m.Recipe?.ProteinPerServing  ?? 0) * m.Servings),
            fat      = (int)((m.Recipe?.FatPerServing      ?? 0) * m.Servings),
            carbs    = (int)((m.Recipe?.CarbsPerServing    ?? 0) * m.Servings)
        })
    );
}

@* ── Data bridge: передаём Razor-данные в JS ───────────────────────────────── *@
<script>
    window.NutriX = {
        goals: {
            kcal: @calGoal,
            prot: @protGoal,
            fat:  @fatGoal,
            carb: @carbGoal
        },
        // Превращаем массив в словарь { [id]: {...} } прямо здесь,
        // чтобы home-index.js мог читать MEAL_DATA[id] без лишних преобразований
        mealData: (function () {
            const arr = @Html.Raw(mealsJson);
            const map = {};
            arr.forEach(function (m) {
                map[m.id] = { calories: m.calories, protein: m.protein, fat: m.fat, carbs: m.carbs };
            });
            return map;
        })()
    };
</script>

@* ── Шрифты ────────────────────────────────────────────────────────────────── *@
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>

@* ── HERO ──────────────────────────────────────────────────────────────────── *@
<div class="home-hero">
    <span class="hero-tag">AI-планировщик питания</span>

    <h1 class="hero-h1">
        Ешьте умно,<br>
        тратьте <em>меньше</em>
    </h1>

    <p class="hero-sub">
        Персональное меню, подсчёт КБЖУ и контроль бюджета — всё в одном месте
    </p>

    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap">
        <a asp-action="Index" asp-controller="Recipe" class="hero-cta">
            <i class="fas fa-utensils"></i> Смотреть рецепты
        </a>

        @if (User.Identity?.IsAuthenticated != true)
        {
            <a asp-action="AuthPage" asp-controller="Account" class="hero-cta-ghost">
                Войти <i class="fas fa-arrow-right"></i>
            </a>
        }
    </div>
</div>

@* ── ПОСЛЕДНИЕ РЕЦЕПТЫ ─────────────────────────────────────────────────────── *@
<section class="home-recipes-section">
    <div class="sec-head">
        <h2 class="sec-title">Свежие рецепты</h2>
        <a asp-action="Index" asp-controller="Recipe" class="sec-link">Все рецепты →</a>
    </div>

    <div class="home-recipe-grid">
        @if (!recipes.Any())
        {
            <div class="recipes-empty-home">
                <div style="font-size:3rem;margin-bottom:.75rem">🍽</div>
                <p>
                    Рецептов пока нет.
                    <a asp-action="Create" asp-controller="Recipe">Создайте первый!</a>
                </p>
            </div>
        }
        else
        {
            @foreach (var r in recipes)
            {
                @await Html.PartialAsync("_RecipeCard", r)
            }
        }
    </div>
</section>

@* ── МЕНЮ НА ДЕНЬ ──────────────────────────────────────────────────────────── *@
<section class="day-section">
    <div class="day-inner">

        <div class="sec-head" style="margin-bottom:1.25rem">
            <h2 class="sec-title">Меню на сегодня</h2>
            <span id="dayDateLabel" style="font-size:.85rem;color:#9a9a94"></span>
        </div>

        @if (User.Identity?.IsAuthenticated != true)
        {
            <div style="text-align:center;padding:2rem;color:#9a9a94">
                <a asp-action="AuthPage" asp-controller="Account" style="color:#5a9668">Войдите</a>,
                чтобы видеть своё меню
            </div>
        }
        else if (!todaySlots.Any())
        {
            <div style="text-align:center;padding:2rem;color:#9a9a94">
                <div style="font-size:2.5rem;margin-bottom:.75rem">📋</div>
                <p>На сегодня меню не запланировано.</p>
                <a asp-controller="MealPlan" asp-action="GenerateWeek"
                   class="hero-cta" style="margin-top:.75rem;display:inline-flex">
                    <i class="fas fa-magic"></i> Сгенерировать меню
                </a>
            </div>
        }
        else
        {
            @await Html.PartialAsync("_DayMenuBody", todaySlots)
        }
    </div>

    @if (User.Identity?.IsAuthenticated == true
         && (ViewBag.CurrentUser as Domain.Entities.User)?.DailyCalorieGoal == null)
    {
        <div style="background:#fff8ec;border:1px solid #f0ddb0;border-radius:12px;padding:.8rem 1.1rem;margin-bottom:1rem;font-size:.85rem;color:#7a5c1e;display:flex;align-items:center;gap:.6rem">
            <span>💡</span>
            <span>
                Цели питания не заданы — прогресс показывается по умолчанию.
                <a asp-controller="MealPlan" asp-action="GenerateWeek"
                   style="color:#c97d4e;font-weight:600">Сгенерируйте план</a>
                — цели сохранятся автоматически.
            </span>
        </div>
    }
</section>

