@{
    ViewData["Title"] = "Часто задаваемые вопросы";
}

<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>

<div class="faq-page">

    <!-- Hero + Search -->
    <div class="faq-hero">
        <span class="faq-hero-tag">Помощь</span>
        <h1>Частые <em>вопросы</em></h1>
        <p>Быстрые ответы на самые популярные вопросы о NutriX</p>
        <div class="faq-search-wrap">
            <span class="faq-search-icon">🔍</span>
            <input class="faq-search" id="faqSearch" type="text" placeholder="Поиск по вопросам..." />
        </div>
    </div>

    <div class="faq-body">

        <!-- Category nav -->
        <nav class="faq-cats" id="faqCats">
            <div class="faq-cats-title">Разделы</div>
            <button class="faq-cat-btn active" data-cat="all">
                <span class="cat-icon">📋</span> Все
                <span class="faq-cat-count" id="cnt-all">14</span>
            </button>
            <button class="faq-cat-btn" data-cat="start">
                <span class="cat-icon">🚀</span> Начало работы
                <span class="faq-cat-count">4</span>
            </button>
            <button class="faq-cat-btn" data-cat="plan">
                <span class="cat-icon">🥗</span> Планирование
                <span class="faq-cat-count">4</span>
            </button>
            <button class="faq-cat-btn" data-cat="recipes">
                <span class="cat-icon">📖</span> Рецепты
                <span class="faq-cat-count">3</span>
            </button>
            <button class="faq-cat-btn" data-cat="account">
                <span class="cat-icon">👤</span> Аккаунт
                <span class="faq-cat-count">3</span>
            </button>
        </nav>

        <!-- FAQ list -->
        <div id="faqList">

            <!-- Начало работы -->
            <div class="faq-group" data-cat="start">
                <div class="faq-category-title">🚀 Начало работы</div>

                <div class="faq-item">
                    <div class="faq-q">
                        <span class="faq-q-text">Что такое NutriX и для кого он предназначен?</span>
                        <div class="faq-chevron">
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </div>
                    </div>
                    <div class="faq-a">
                        <div class="faq-a-inner">
                            NutriX — это умный планировщик питания, который помогает считать КБЖУ, составлять меню на неделю и контролировать бюджет на еду. Подходит всем, кто хочет питаться осознанно — будь то похудение, набор массы или просто здоровый образ жизни.
                        </div>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-q">
                        <span class="faq-q-text">Нужно ли регистрироваться для использования сервиса?</span>
                        <div class="faq-chevron">
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </div>
                    </div>
                    <div class="faq-a">
                        <div class="faq-a-inner">
                            Просматривать рецепты можно без регистрации. Для составления персонального меню, сохранения избранного и отслеживания прогресса потребуется создать аккаунт — это бесплатно и занимает меньше минуты.
                        </div>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-q">
                        <span class="faq-q-text">Как задать свои цели по питанию?</span>
                        <div class="faq-chevron">
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </div>
                    </div>
                    <div class="faq-a">
                        <div class="faq-a-inner">
                            Перейдите в <a href="#">Профиль → Цели питания</a> и укажите вес, рост, возраст и желаемый результат. NutriX автоматически рассчитает суточную норму КБЖУ. Или воспользуйтесь генератором меню — он предложит план и сохранит цели автоматически.
                        </div>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-q">
                        <span class="faq-q-text">Сервис бесплатный?</span>
                        <div class="faq-chevron">
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </div>
                    </div>
                    <div class="faq-a">
                        <div class="faq-a-inner">
                            Да, базовый функционал полностью бесплатен. В него входит доступ к рецептам, базовый подсчёт КБЖУ и план питания на неделю. Расширенные возможности доступны в Premium-версии.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Планирование -->
            <div class="faq-group" data-cat="plan">
                <div class="faq-category-title">🥗 Планирование питания</div>

                <div class="faq-item">
                    <div class="faq-q">
                        <span class="faq-q-text">Как работает генерация меню на неделю?</span>
                        <div class="faq-chevron">
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </div>
                    </div>
                    <div class="faq-a">
                        <div class="faq-a-inner">
                            Нажмите «Сгенерировать меню» — алгоритм подберёт рецепты завтраков, обедов и ужинов на 7 дней с учётом ваших целей по КБЖУ. Вы можете заменить любой приём пищи вручную или перегенерировать всё заново.
                        </div>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-q">
                        <span class="faq-q-text">Можно ли изменить уже созданное меню?</span>
                        <div class="faq-chevron">
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </div>
                    </div>
                    <div class="faq-a">
                        <div class="faq-a-inner">
                            Конечно. Любой приём пищи в меню можно заменить: нажмите на блюдо и выберите альтернативу из каталога рецептов. Суточные показатели КБЖУ пересчитаются автоматически.
                        </div>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-q">
                        <span class="faq-q-text">Учитывается ли бюджет при составлении меню?</span>
                        <div class="faq-chevron">
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </div>
                    </div>
                    <div class="faq-a">
                        <div class="faq-a-inner">
                            Да. В настройках генерации вы можете указать желаемый бюджет на день или неделю. NutriX будет подбирать рецепты с учётом стоимости ингредиентов из нашей базы продуктов.
                        </div>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-q">
                        <span class="faq-q-text">Откуда берутся цены на продукты?</span>
                        <div class="faq-chevron">
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </div>
                    </div>
                    <div class="faq-a">
                        <div class="faq-a-inner">
                            Мы используем актуальную базу средних розничных цен, которую регулярно обновляем. Цены могут отличаться от реальных в вашем регионе — их можно скорректировать вручную в разделе <a href="#">Продукты</a>.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Рецепты -->
            <div class="faq-group" data-cat="recipes">
                <div class="faq-category-title">📖 Рецепты</div>

                <div class="faq-item">
                    <div class="faq-q">
                        <span class="faq-q-text">Как добавить свой рецепт?</span>
                        <div class="faq-chevron">
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </div>
                    </div>
                    <div class="faq-a">
                        <div class="faq-a-inner">
                            Перейдите в <a href="#">Рецепты → Создать рецепт</a>, заполните название, ингредиенты и шаги приготовления. КБЖУ рассчитаются автоматически по базе продуктов. Также можно импортировать рецепт с сайта 1000.menu по ссылке.
                        </div>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-q">
                        <span class="faq-q-text">Как импортировать рецепт с внешнего сайта?</span>
                        <div class="faq-chevron">
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </div>
                    </div>
                    <div class="faq-a">
                        <div class="faq-a-inner">
                            В разделе <a href="#">Рецепты → Импорт</a> вставьте ссылку с сайта 1000.menu. NutriX автоматически распознает ингредиенты, шаги и КБЖУ. Сейчас поддерживается только 1000.menu — поддержка других сайтов в разработке.
                        </div>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-q">
                        <span class="faq-q-text">Могу ли я редактировать чужие рецепты?</span>
                        <div class="faq-chevron">
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </div>
                    </div>
                    <div class="faq-a">
                        <div class="faq-a-inner">
                            Нет — редактировать можно только собственные рецепты. Если хотите адаптировать чужой рецепт, создайте его копию через кнопку «Сохранить как свой» и редактируйте уже свою версию.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Аккаунт -->
            <div class="faq-group" data-cat="account">
                <div class="faq-category-title">👤 Аккаунт</div>

                <div class="faq-item">
                    <div class="faq-q">
                        <span class="faq-q-text">Как удалить аккаунт?</span>
                        <div class="faq-chevron">
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </div>
                    </div>
                    <div class="faq-a">
                        <div class="faq-a-inner">
                            Перейдите в <a href="#">Настройки → Аккаунт → Удалить аккаунт</a>. После подтверждения все ваши данные будут безвозвратно удалены в течение 30 дней в соответствии с нашей <a href="#">политикой конфиденциальности</a>.
                        </div>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-q">
                        <span class="faq-q-text">Забыл пароль — что делать?</span>
                        <div class="faq-chevron">
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </div>
                    </div>
                    <div class="faq-a">
                        <div class="faq-a-inner">
                            На странице входа нажмите «Забыли пароль?» и введите email, указанный при регистрации. Мы отправим ссылку для сброса пароля. Если письмо не пришло — проверьте папку «Спам».
                        </div>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-q">
                        <span class="faq-q-text">Можно ли войти через Google?</span>
                        <div class="faq-chevron">
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </div>
                    </div>
                    <div class="faq-a">
                        <div class="faq-a-inner">
                            Да, авторизация через Google поддерживается. На странице входа нажмите «Войти через Google» — вам не потребуется вводить пароль.
                        </div>
                    </div>
                </div>
            </div>

            <!-- No results placeholder -->
            <div class="faq-no-results" id="faqNoResults" style="display:none">
                <div class="faq-nr-icon">🔍</div>
                <p style="font-weight:600;color:#4a4a46;margin-bottom:.25rem">Ничего не найдено</p>
                <p style="font-size:.875rem">Попробуйте другой запрос или напишите нам напрямую</p>
            </div>

            <!-- CTA -->
            <div class="faq-cta" id="faqCta">
                <h3>Не нашли ответ?</h3>
                <p>Напишите нам — мы ответим в течение рабочего дня</p>
                <a asp-action="Contact" asp-controller="Home">✉️ Написать в поддержку</a>
            </div>

        </div><!-- /faq-list -->
    </div>
</div>

<script>
// Accordion
document.querySelectorAll('.faq-q').forEach(q => {
    q.addEventListener('click', () => {
        const item = q.closest('.faq-item');
        const wasOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item.open').forEach(i => i.classList.remove('open'));
        if (!wasOpen) item.classList.add('open');
    });
});

// Category filter
document.querySelectorAll('.faq-cat-btn').forEach(btn => {
    btn.addEventListener('click', () => {
        document.querySelectorAll('.faq-cat-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const cat = btn.dataset.cat;
        document.querySelectorAll('.faq-group').forEach(g => {
            g.style.display = (cat === 'all' || g.dataset.cat === cat) ? '' : 'none';
        });
        document.getElementById('faqSearch').value = '';
        updateNoResults();
    });
});

// Search
document.getElementById('faqSearch').addEventListener('input', function() {
    const q = this.value.toLowerCase().trim();
    let visibleCount = 0;
    document.querySelectorAll('.faq-item').forEach(item => {
        const text = item.textContent.toLowerCase();
        const match = !q || text.includes(q);
        item.style.display = match ? '' : 'none';
        if (match) visibleCount++;
    });
    document.querySelectorAll('.faq-group').forEach(g => {
        const visible = [...g.querySelectorAll('.faq-item')].some(i => i.style.display !== 'none');
        g.style.display = visible ? '' : 'none';
    });
    if (q) {
        document.querySelectorAll('.faq-cat-btn').forEach(b => b.classList.remove('active'));
        document.querySelector('[data-cat="all"]').classList.add('active');
    }
    updateNoResults();
});

function updateNoResults() {
    const anyVisible = [...document.querySelectorAll('.faq-item')].some(i => i.style.display !== 'none');
    document.getElementById('faqNoResults').style.display = anyVisible ? 'none' : 'block';
    document.getElementById('faqCta').style.display = anyVisible ? '' : 'none';
}
</script>
