@model List<Domain.Entities.Product>
@{ ViewData["Title"] = "Цены на продукты"; }

<style>
.prices-page { max-width: 1100px; margin: 0 auto; padding: 2rem 1rem; }
.prices-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
.prices-title { font-size: 1.5rem; font-weight: 700; color: var(--brown); }
.prices-updated { font-size: .8rem; color: var(--muted); }
.category-block { margin-bottom: 2rem; }
.category-title { font-size: 1rem; font-weight: 700; color: var(--sage); 
                  border-bottom: 2px solid var(--sage-light); padding-bottom: .4rem; margin-bottom: .8rem; }
.prices-table { width: 100%; border-collapse: collapse; font-size: .88rem; }
.prices-table th { text-align: left; padding: .5rem .8rem; color: var(--muted); 
                   font-weight: 600; font-size: .75rem; text-transform: uppercase; }
.prices-table td { padding: .5rem .8rem; border-bottom: 1px solid var(--border); color: var(--text); }
.prices-table tr:hover td { background: var(--sage-light); }
.price-val { font-weight: 600; color: var(--brown); }
.btn-update { background: var(--sage); color: #fff; border: none; border-radius: 10px;
              padding: .6rem 1.4rem; font-size: .9rem; cursor: pointer; }
.btn-update:hover { background: #6a8e6e; }
.next-run { font-size: .78rem; color: var(--muted); margin-top: .3rem; }
</style>

<div class="prices-page">
    <div class="prices-head">
        <div>
            <div class="prices-title">Цены на продукты</div>
            <div class="prices-updated">Обновляются автоматически каждые 5 дней</div>
            <div class="next-run" id="nextRun"></div>
        </div>
        <form asp-action="UpdatePrices" asp-controller="Admin" method="post" id="updateForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="minPct" value="5" />
            <input type="hidden" name="maxPct" value="15" />
            <button type="submit" class="btn-update" id="updateBtn">⟳ Обновить сейчас</button>
        </form>
    </div>

    @foreach (var group in Model.GroupBy(p => p.Category))
    {
        <div class="category-block">
            <div class="category-title">@group.Key</div>
            <table class="prices-table">
                <thead>
                    <tr>
                        <th>Продукт</th>
                        <th>Единица</th>
                        <th>Цена</th>
                        <th>Ккал/100г</th>
                        <th>Б / Ж / У</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in group)
                    {
                        <tr>
                            <td>@p.Name</td>
                            <td>@p.Unit</td>
                            <td class="price-val">@p.PricePerUnit.ToString("F2") ₽</td>
                            <td>@(p.CaloriesPer100?.ToString("F0") ?? "—")</td>
                            <td style="color:var(--muted)">
                                @(p.ProteinPer100?.ToString("F1") ?? "—") /
                                @(p.FatPer100?.ToString("F1") ?? "—") /
                                @(p.CarbsPer100?.ToString("F1") ?? "—")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div id="toast" style="display:none;position:fixed;bottom:2rem;right:2rem;
     background:var(--sage);color:#fff;padding:.8rem 1.4rem;border-radius:12px;
     font-size:.9rem;box-shadow:0 4px 20px rgba(0,0,0,.15)"></div>

@section Scripts {
<script>
document.getElementById('updateForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const btn = document.getElementById('updateBtn');
    btn.disabled = true;
    btn.textContent = '⏳ Обновляем...';

    const fd = new FormData(this);
    const res = await fetch(this.action, { method: 'POST', body: fd });
    const data = await res.json();

    btn.disabled = false;
    btn.textContent = '⟳ Обновить сейчас';

    const toast = document.getElementById('toast');
    toast.textContent = data.message ?? data.error ?? 'Готово';
    toast.style.background = data.error ? '#c85c5c' : 'var(--sage)';
    toast.style.display = 'block';
    setTimeout(() => { toast.style.display = 'none'; location.reload(); }, 2500);
});

// Показываем когда следующий автозапуск (примерно)
const lastUpdate = new Date();
lastUpdate.setDate(lastUpdate.getDate() + 5);
document.getElementById('nextRun').textContent =
    'Следующее автообновление: ' + lastUpdate.toLocaleDateString('ru-RU');
</script>
}