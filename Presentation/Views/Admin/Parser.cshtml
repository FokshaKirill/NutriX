@{
    Layout = "_Layout";
    ViewData["Title"] = "Парсер продуктов";
}

@* Проверка роли Admin через Claims *@
@if (!User.IsInRole("Admin"))
{
    <div class="container py-5 text-center">
        <div style="font-size: 4rem;">🔒</div>
        <h2 class="mt-3" style="color: var(--primary);">Доступ запрещён</h2>
        <p class="text-muted">Эта страница доступна только администраторам.</p>
        <a asp-action="Index" asp-controller="Home" class="btn btn-outline-primary mt-3">На главную</a>
    </div>
    return;
}

@Html.AntiForgeryToken()

<div class="container py-5" style="max-width: 860px;">

    <div class="mb-5">
        <h2 style="color: var(--primary); font-weight: 700;">
            <i class="fas fa-terminal me-2"></i>Панель парсера
        </h2>
        <p class="text-muted mb-0">Импорт продуктов и обновление цен. Только для администраторов.</p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card h-100 p-4 shadow-sm" style="border-radius: 1.2rem; border: 2px solid var(--primary-light);">
                <div class="mb-3">
                    <span style="font-size: 2.5rem;">🥗</span>
                </div>
                <h4 style="color: var(--primary);">Парсинг продуктов</h4>
                <p class="text-muted small mb-4">
                    Загружает все группы продуктов из USDA FoodData Central (~320 продуктов: мясо, рыба, овощи, молочка, крупы и т.д.)
                </p>
                <div class="mb-3">
                    <label class="form-label small text-muted">Продуктов на группу</label>
                    <input type="number" id="productsLimit" class="form-control" value="40" min="5" max="100">
                </div>
                <button class="btn btn-success w-100 mt-auto" id="btnParseProducts" onclick="parseProducts()">
                    <span class="spin me-2" id="spinProducts"></span>
                    <i class="fas fa-download me-2"></i>Запустить парсинг
                </button>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card h-100 p-4 shadow-sm" style="border-radius: 1.2rem; border: 2px solid #fff3cd;">
                <div class="mb-3">
                    <span style="font-size: 2.5rem;">💰</span>
                </div>
                <h4 style="color: #856404;">Обновление цен</h4>
                <p class="text-muted small mb-4">
                    Применяет рандомное изменение цен (±5–15%) ко всем продуктам в базе. Имитирует рыночные колебания.
                </p>
                <div class="mb-3">
                    <label class="form-label small text-muted">Диапазон изменения (%)</label>
                    <div class="d-flex gap-2">
                        <input type="number" id="priceMin" class="form-control" value="5" min="1" max="50" placeholder="Мин">
                        <input type="number" id="priceMax" class="form-control" value="15" min="1" max="50" placeholder="Макс">
                    </div>
                </div>
                <button class="btn w-100 mt-auto" id="btnUpdatePrices" onclick="updatePrices()"
                        style="background: #ffc107; color: #000; font-weight: 600;">
                    <span class="spin me-2" id="spinPrices"></span>
                    <i class="fas fa-sync-alt me-2"></i>Обновить цены
                </button>
            </div>
        </div>
    </div>

    <div id="resultBlock" style="display: none;">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <h5 class="mb-0" style="color: var(--primary);">
                <i class="fas fa-code me-2"></i>Ответ сервера
            </h5>
            <button class="btn btn-sm btn-outline-secondary" onclick="clearResult()">
                <i class="fas fa-times me-1"></i>Очистить
            </button>
        </div>
        <pre id="resultJson" style="
            background: #1e1e2e;
            color: #cdd6f4;
            border-radius: 1rem;
            padding: 1.5rem;
            font-size: .82rem;
            max-height: 420px;
            overflow-y: auto;
            white-space: pre-wrap;
            word-break: break-word;
            border: 1px solid #313244;
        "></pre>
    </div>

    <div id="statusBar" style="display: none;"
         class="alert mt-3 mb-0" role="alert"></div>
</div>

@section Scripts {
<style>
    .spin {
        display: none;
        width: 14px; height: 14px;
        border: 2px solid rgba(255,255,255,.35);
        border-top-color: #fff;
        border-radius: 50%;
        animation: sp .7s linear infinite;
        vertical-align: middle;
    }
    .spin.on { display: inline-block; }
    @@keyframes sp { to { transform: rotate(360deg); } }
</style>

<script>
    const tok = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

    function setStatus(msg, type = 'info') {
        const bar = document.getElementById('statusBar');
        bar.className = `alert alert-${type} mt-3 mb-0`;
        bar.textContent = msg;
        bar.style.display = 'block';
    }

    function showResult(data) {
        document.getElementById('resultBlock').style.display = 'block';
        document.getElementById('resultJson').textContent = JSON.stringify(data, null, 2);
        document.getElementById('resultBlock').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function clearResult() {
        document.getElementById('resultBlock').style.display = 'none';
        document.getElementById('statusBar').style.display = 'none';
    }

    async function post(url, data, spinId) {
        const spin = document.getElementById(spinId);
        spin.classList.add('on');
        try {
            const body = new URLSearchParams({ ...data, __RequestVerificationToken: tok });
            const r = await fetch(url, { method: 'POST', body });
            const j = await r.json();
            showResult(j);
            return j;
        } catch (e) {
            showResult({ error: e.message });
            setStatus('Ошибка запроса: ' + e.message, 'danger');
        } finally {
            spin.classList.remove('on');
        }
    }

    async function parseProducts() {
        const limit = document.getElementById('productsLimit').value;
        setStatus('⏳ Парсинг продуктов... Не закрывайте страницу.', 'warning');
        const result = await post('/Admin/ParseAll', { limitPerGroup: limit }, 'spinProducts');
        if (result && !result.error) {
            setStatus(`✅ Готово! Сохранено: ${result.totalSaved} продуктов.`, 'success');
        }
    }

    async function updatePrices() {
        const minPct = document.getElementById('priceMin').value;
        const maxPct = document.getElementById('priceMax').value;
        if (parseInt(minPct) > parseInt(maxPct)) {
            setStatus('❌ Минимум не может быть больше максимума', 'danger');
            return;
        }
        setStatus('⏳ Обновляем цены...', 'warning');
        const result = await post('/Admin/UpdatePrices', { minPct, maxPct }, 'spinPrices');
        if (result && !result.error) {
            setStatus(`✅ ${result.message}`, 'success');
        }
    }
</script>
}
